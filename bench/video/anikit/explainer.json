      {"shape": "rect", "width": 560, "height": 400, "radius": 24, "fill": "$surface", "x": 1440, "y": 560},
      {"shape": "circle", "width": 80, "height": 80, "fill": "$accent", "x": 1440, "y": "=560 + 12 * sin(t * 2)"},
      {"shape": "rect", "width": 1600, "height": 4, "radius": 2, "fill": "#ffffff14", "x": 960, "y": 1000}
