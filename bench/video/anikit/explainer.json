      {"type": "group", "enter": {"preset": "fadeUp", "delay": 1.3}, "layers": [{"shape": "circle", "width": 14, "height": 14, "x": 175, "y": 620}, {"text": "Static slides cost almost nothing", "size": 36, "x": 210, "y": 620, "anchor": "left"}]},
      {"shape": "rect", "width": 560, "height": 400, "radius": 24, "fill": "$surface", "x": 1440, "y": 560},
