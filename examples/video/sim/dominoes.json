{
  "size": [1920, 1080],
  "fps": 30,
  "compositions": {
    "film": {
      "size": [360, 640],
      "duration": 4,
      "background": "linear-gradient(160deg, #0b1d3a, #1f6fff 55%, #ff7a3c)",
      "layers": [
        { "shape": "circle", "width": 220, "height": 220, "fill": "#ffd23f", "x": "=180 + 90*sin(t*2.4)", "y": "=250 + 120*cos(t*1.7)" },
        { "text": "{value}", "value": "=floor(t*30) % 100", "style": "title", "color": "#ffffff", "y": 520 }
      ]
    }
  },
  "scenes": [
    {
      "duration": 8,
      "layers": [
        { "component": "scene3d", "props": {
          "env": "cyc",
          "quality": "standard",
          "camera": { "keys": [
            { "t": 0, "pos": [1.6, 0.9, 3.2], "target": [0.0, 0.8, -1.5], "focal": 32, "fstop": 2.8 },
            { "t": 2.5, "pos": [3.5, 3.0, 1.5], "target": [0.0, 0.4, -12], "focal": 30, "fstop": 4 },
            { "t": 8, "pos": [12, 16, 8], "target": [0.0, 0.0, -40], "focal": 30, "fstop": 8 } ] },
          "objects": [],
          "physics": {
            "timeScale": "=1 + 2.2*smoothstep(1.0, 1.8, t)",
            "bodies": [ {
              "type": "pane", "count": 10000, "layout": "dominoes", "path": "fan", "angle": 110,
              "size": [0.9, 1.6, 0.03], "material": "glass",
              "texture": { "composition": "film", "frame": "=(i*7 + t*30) % 120", "face": "both" }
            } ]
          }
        } }
      ]
    }
  ]
}
