{
  "look": "noir",
  "defs": {
    "ping": {
      "text": "$t",
      "style": "label",
      "size": "2.4vh",
      "color": "$muted",
      "x": "$x",
      "y": "$y",
      "depth": "$d",
      "enter": {
        "preset": "popIn",
        "delay": "$at"
      }
    }
  },
  "scenes": [
    {
      "id": "noise",
      "duration": 3.2,
      "camera": {
        "aperture": 6,
        "focus": 0,
        "animate": [
          {
            "to": {
              "x": -80,
              "focus": 2.5
            },
            "duration": 3.2,
            "ease": "inOutSine"
          }
        ]
      },
      "layers": [
        {
          "use": "ping",
          "with": {
            "t": "3 new messages",
            "x": "18%",
            "y": "22%",
            "d": 2.5,
            "at": 0.0
          }
        },
        {
          "use": "ping",
          "with": {
            "t": "@you in #launch",
            "x": "72%",
            "y": "18%",
            "d": 0.6,
            "at": 0.15
          }
        },
        {
          "use": "ping",
          "with": {
            "t": "Reminder: standup",
            "x": "30%",
            "y": "74%",
            "d": 1.6,
            "at": 0.3
          }
        },
        {
          "use": "ping",
          "with": {
            "t": "Your order shipped",
            "x": "80%",
            "y": "66%",
            "d": 3.0,
            "at": 0.42
          }
        },
        {
          "use": "ping",
          "with": {
            "t": "12 unread",
            "x": "56%",
            "y": "86%",
            "d": 0.3,
            "at": 0.55
          }
        },
        {
          "use": "ping",
          "with": {
            "t": "Call in 5 min",
            "x": "15%",
            "y": "50%",
            "d": 1.1,
            "at": 0.65
          }
        },
        {
          "text": "Everything wants you.",
          "style": "title",
          "depth": 2.5,
          "enter": {
            "preset": "blurIn",
            "delay": 0.4
          },
          "width": "62%"
        }
      ]
    },
    {
      "id": "cost",
      "duration": 4.4,
      "transition": "cut",
      "layers": [
        {
          "text": "{value}",
          "style": "title",
          "size": "46vh",
          "x": "34%",
          "y": "50%",
          "value": 23,
          "enter": "countUp",
          "color": "$accent"
        },
        {
          "text": "minutes to refocus after one interruption.",
          "style": "heading",
          "width": "34%",
          "align": "left",
          "anchor": "left",
          "x": "56%",
          "y": "50%",
          "enter": {
            "preset": "mask by line up",
            "delay": 0.5
          }
        }
      ]
    },
    {
      "id": "name",
      "duration": 4,
      "camera": {
        "animate": [
          {
            "from": {
              "zoom": 1.08
            },
            "to": {
              "zoom": 1
            },
            "duration": 1.2,
            "ease": "outExpo"
          }
        ]
      },
      "layers": [
        {
          "component": "god-rays",
          "props": {
            "at": [
              0.5,
              -0.15
            ],
            "color": "#E9DFC4",
            "count": 9,
            "intensity": 1.1,
            "spread": 0.45
          },
          "width": "100%",
          "height": "100%"
        },
        {
          "component": "text-3d",
          "props": {
            "text": "HALFTIME",
            "gradient": [
              "#F4EEDF",
              "#B9A27A"
            ],
            "metallic": 0.9,
            "roughness": 0.25,
            "intro": "rise",
            "sway": 0.4
          },
          "width": "80%",
          "height": "40%",
          "y": "46%"
        },
        {
          "text": "Silence, for twenty-five minutes.",
          "style": "subtitle",
          "y": "74%",
          "enter": {
            "preset": "fadeIn",
            "delay": 1.4
          }
        }
      ]
    },
    {
      "id": "how",
      "duration": 4.4,
      "transition": {
        "type": "iris",
        "duration": 0.7
      },
      "layers": [
        {
          "component": "progress-ring",
          "props": {
            "from": 1,
            "to": 0.62,
            "duration": 3,
            "color": "#D8B66A",
            "percent": false,
            "size": 560,
            "thickness": 10
          },
          "width": 700,
          "height": 700,
          "x": "30%"
        },
        {
          "text": "25:00",
          "style": "title",
          "font": "JetBrains Mono",
          "size": "7vh",
          "x": "30%"
        },
        {
          "text": "One tap.",
          "style": "heading",
          "align": "left",
          "anchor": "left",
          "x": "56%",
          "y": "40%",
          "enter": "mask by line up"
        },
        {
          "text": "Notifications wait. Calls wait. You don't.",
          "style": "subtitle",
          "width": "34%",
          "align": "left",
          "anchor": "left",
          "x": "56%",
          "y": "56%",
          "enter": {
            "preset": "fadeIn",
            "delay": 0.6
          }
        }
      ]
    },
    {
      "id": "after",
      "duration": 5.2,
      "layers": [
        {
          "text": "“I wrote more this week than all last month.”",
          "style": "heading",
          "width": "70%",
          "enter": "mask by line up"
        },
        {
          "text": "Ana, novelist",
          "style": "label",
          "y": "66%",
          "enter": {
            "preset": "fadeIn",
            "delay": 1.2
          }
        }
      ]
    },
    {
      "id": "end",
      "duration": 4.2,
      "transition": "fadeBlack",
      "layers": [
        {
          "text": "Halftime",
          "style": "title",
          "size": "16vh",
          "enter": "blurIn"
        },
        {
          "text": "halftime.app · iOS and Mac",
          "style": "label",
          "y": "66%",
          "enter": {
            "preset": "fadeIn",
            "delay": 0.8
          }
        }
      ]
    }
  ]
}
