        { "shape": "circle", "width": 70, "height": 70, "fill": "$mint", "smear": 1.4, "duration": 0.62,
          "path": "M380 -80 C 600 -40, 900 120, 960 560", "progress": "=min(1, t/0.6)^2" },
        { "shape": "circle", "x": 960, "y": 600, "width": 260, "height": 80, "fill": "none", "stroke": "$mint", "strokeWidth": 6, "start": 0.6,
          "repeat": { "count": 6, "offset": { "scale": 1.6, "opacity": -0.15 }, "stagger": 0.06 },
          "animate": { "from": { "scale": 0.2, "opacity": 0 }, "duration": 0.75, "ease": "glide" } },
        { "shape": "circle", "x": 960, "y": 560, "width": 34, "height": 34, "fill": "$mint", "anchor": [0.5, 7], "start": 0.6, "inertia": "bouncy",
          "repeat": { "count": 9, "offset": { "rotate": 40 } }, "animate": { "from": { "scale": 0 }, "to": { "scale": 1 }, "duration": 0.2, "ease": "glide" },
          "exit": { "preset": "fadeOut", "duration": 0.3 } },
        { "text": "rainwell", "size": 64, "weight": 700, "letterSpacing": -1, "color": "$milk", "x": 120, "y": 980, "anchor": "left", "start": 0.7,
          "animator": { "by": "char", "y": 40, "opacity": 0, "duration": 0.5, "smooth": 0.3, "ease": "glide" } }
      ] },
    { "id": "gauge", "duration": 1.8, "background": "#ff7a59", "transition": { "type": "reveal", "shape": "blob", "origin": [960, 600], "duration": 0.55 },
      "notes": "a ball of water fills to the reading: a wiggling surface (wigglePath rect) matted by a circle; the number springs in",
      "layers": [
        { "shape": "circle", "x": 700, "y": 540, "width": 560, "height": 560, "fill": "$milk", "inertia": "bouncy",
          "animate": { "from": { "scale": 0.5 }, "duration": 0.3, "ease": "glide" } },
        { "shape": "rect", "x": 700, "y": 1100, "width": 760, "height": 760, "fill": "$moss", "matte": "ball",
          "wigglePath": { "amount": 14, "detail": 40, "speed": 1.6, "seed": 3 },
          "animate": { "to": { "y": 860 }, "at": 0.15, "duration": 1.1, "ease": "land" } },
        { "id": "ball", "shape": "circle", "x": 700, "y": 540, "width": 560, "height": 560, "inertia": "bouncy",
          "animate": { "from": { "scale": 0.5 }, "duration": 0.3, "ease": "glide" } },
        { "text": "{value:0}%", "value": "=min(62, floor(t*70))", "size": 230, "weight": 900, "letterSpacing": -8, "color": "$deep", "x": 1120, "y": 470, "anchor": "left",
          "inertia": "bouncy", "animate": { "from": { "x": "+80", "scale": 0.7, "opacity": 0 }, "at": 0.1, "duration": 0.25, "ease": "glide" } },
        { "text": "soil moisture · fern, kitchen", "size": 38, "weight": 500, "color": "$deep", "x": 1130, "y": 620, "anchor": "left",
          "animator": { "by": "word", "y": 30, "opacity": 0, "delay": 0.3, "duration": 0.6, "smooth": 0.4, "ease": "glide" } }
      ] },
    { "id": "grow", "duration": 1.7, "background": "#0f3d2e", "transition": { "type": "reveal", "shape": "blob", "origin": [700, 540], "duration": 0.55 },
