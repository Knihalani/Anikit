          { "shape": "blob", "sides": 2, "wobble": 0.2, "seed": 3, "x": 966, "y": 540, "width": 300, "height": 120, "fill": "#7fdcab", "anchor": [0, 0.5],
            "rotation": "=-48 + 3*sin(t*2.4 + 2)", "inertia": "bouncy", "animate": { "from": { "scaleX": 0 }, "duration": 0.35, "ease": "glide" } },
          { "shape": "blob", "sides": 2, "wobble": 0.2, "seed": 4, "x": 960, "y": 420, "width": 260, "height": 110, "fill": "#7fdcab", "anchor": [0, 0.5],
            "rotation": "=-95 + 3*sin(t*2 + 3)", "inertia": "bouncy", "animate": { "from": { "scaleX": 0 }, "duration": 0.35, "ease": "glide" } } ] },
        { "shape": "rect", "x": 960, "y": 820, "width": 14, "height": 420, "radius": 7, "fill": "#7fdcab", "anchor": [0.5, 1],
          "animate": { "from": { "scaleY": 0 }, "duration": 0.4, "ease": "glide" } },
        { "shape": "squircle", "exponent": 4, "x": 960, "y": 900, "width": 420, "height": 220, "fill": "$coral", "inertia": "bouncy",
          "animate": { "from": { "scaleY": 0.2, "scaleX": 1.3 }, "duration": 0.18, "ease": "glide" } } ] },
        { "text": "next water: thursday", "size": 46, "weight": 600, "color": "$milk", "x": 120, "y": 120, "anchor": "left",
          "animator": { "by": "word", "x": -30, "opacity": 0, "delay": 0.35, "duration": 0.5, "smooth": 0.4, "ease": "glide" } }
      ] },
    { "id": "mark", "duration": 1.8, "camera": { "zoom": "=1 + 0.05*t" }, "background": "#9ff0c8", "transition": { "type": "reveal", "shape": "circle", "origin": [960, 560], "duration": 0.5 },
      "notes": "button: the wordmark rolls in on a travelling wave; the droplet lands on the i and squashes",
      "layers": [
        { "text": "rainwell", "size": 260, "weight": 800, "letterSpacing": -10, "color": "$deep", "x": 960, "y": 560,
          "animator": { "by": "char", "y": -60, "start": 0, "end": 0.18, "offset": "=min(1.35, t*1.6) - 0.2", "smooth": 0.25 } },
        { "shape": "circle", "width": 54, "height": 54, "fill": "$coral", "smear": 1.2, "inertia": { "preset": "bouncy", "props": ["scaleX", "scaleY"] },
          "path": "M1300 -80 C 1100 -60, 850 150, 764 472", "progress": "=min(1, max(0, t-0.4)/0.45)^2",
          "animate": { "keyframes": { "scaleY": [[0, 1], [0.48, 1], [0.52, 0.55], [0.6, 1]], "scaleX": [[0, 1], [0.48, 1], [0.52, 1.4], [0.6, 1]] }, "duration": 1.8, "ease": "linear" } },
        { "text": "know when they're thirsty", "size": 44, "weight": 500, "color": "$deep", "x": 960, "y": 760,
          "animator": { "by": "word", "y": 30, "opacity": 0, "delay": 0.7, "duration": 0.6, "smooth": 0.4, "ease": "glide" } }
      ] }
  ]
