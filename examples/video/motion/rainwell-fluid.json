{
  "size": "16:9", "fps": 30, "background": "#0f3d2e",
  "intent": "fast",
  "theme": { "colors": { "moss": "#0f3d2e", "mint": "#9ff0c8", "coral": "#ff7a59", "milk": "#fff6e5", "deep": "#0a2a20" } },
  "transition": "cut",
  "scenes": [
    { "id": "drop", "duration": 1.4, "notes": "FLUID register: a droplet arcs down (smeared at speed), lands, and the splash ripples out in staggered rings",
