{
 "size": "16:9",
 "fps": 30,
 "background": "#050505",
 "intent": "fast",
 "theme": {
  "colors": {
   "night": "#050505",
   "warm": "#ffd9a0",
   "paper": "#f3ede2",
   "ash": "#8a8276",
   "brick": "#1a1512"
  }
 },
 "post": {
  "preset": "cinematic",
  "bloom": 0.5,
  "halation": 0.4,
  "grain": 0.035,
  "vignette": 0.35,
  "lut": "anikit:lut/warm-negative",
  "lutMix": 0.6
 },
 "transition": "cut",
 "scenes": [
  {
   "id": "door",
   "duration": 0.9,
   "camera": {
    "zoom": "=1 + 0.12*t"
   },
   "notes": "a door of light cracks open in the dark",
   "layers": [
    {
     "shader": "light-shafts",
     "supersample": false,
     "uniforms": {
      "angle": 6,
      "spread": 0.6,
      "panes": 1,
      "intensity": 1.8,
      "haze": 1.5
     },
     "matte": "door"
    },
    {
     "id": "door",
     "shape": "rect",
     "x": 960,
     "y": 540,
     "width": 30,
     "height": 1300,
     "fill": "#fff",
     "inertia": "heavy",
     "animate": {
      "from": {
       "scaleX": 0.05
      },
      "to": {
       "scaleX": 8
      },
      "at": 0.1,
      "duration": 0.55,
      "ease": "snap"
     }
    }
   ]
  },
  {
   "id": "facade",
   "duration": 1.3,
   "transition": {
    "type": "crossfade",
    "duration": 0.3
   },
   "camera": {
    "zoom": "=1.08 - 0.06*t",
    "y": "=-20*t"
   },
   "notes": "the harbour warehouse at night: its windows light up one by one in random order (a repeater grid as the light's matte)",
   "layers": [
    {
     "shape": "rect",
     "x": 960,
     "y": 540,
     "width": 1920,
     "height": 1080,
     "fill": "$brick"
    },
    {
     "shader": "light-shafts",
     "supersample": false,
     "uniforms": {
      "angle": -25,
      "spread": 0.35,
      "panes": 2,
      "intensity": 1.7,
      "haze": 1.2
     },
     "matte": "windows"
    },
    {
     "id": "windows",
     "type": "group",
     "x": 960,
     "y": 540,
     "width": 1920,
     "height": 1080,
     "layers": [
      {
       "type": "group",
       "x": 960,
       "y": 540,
       "width": 1920,
       "height": 1080,
       "repeat": {
        "count": 5,
        "offset": {
         "y": 190
        },
        "stagger": 0.0
       },
       "layers": [
        {
         "shape": "rect",
         "x": 250,
         "y": 150,
         "width": 150,
         "height": 120,
         "radius": 4,
         "fill": "#fff",
         "repeat": {
          "count": 8,
          "offset": {
           "x": 205
          },
          "stagger": 0.045,
          "order": "random",
          "seed": 4
         },
         "animate": {
          "from": {
           "opacity": 0
          },
          "duration": 0.12,
          "ease": "linear"
         }
        }
       ]
      }
     ]
    },
    {
     "text": "Lumen",
     "size": 150,
     "weight": 700,
     "letterSpacing": -4,
     "color": "$paper",
     "x": 120,
     "y": 990,
     "anchor": "bottomLeft",
     "start": 0.5,
     "animator": {
      "by": "char",
      "y": 50,
      "opacity": 0,
      "duration": 0.4,
      "smooth": 0.3,
      "ease": "glide"
     }
    },
    {
     "text": "a festival of light, Bristol Harbourside",
     "size": 40,
     "weight": 400,
     "color": "$warm",
     "x": 1800,
     "y": 975,
     "anchor": "bottomRight",
     "start": 0.7,
     "animator": {
      "by": "word",
      "y": 20,
      "opacity": 0,
      "duration": 0.45,
      "smooth": 0.3,
      "ease": "glide"
     }
    }
   ]
  },
  {
   "id": "letter",
   "duration": 1.1,
   "transition": {
    "type": "whip",
    "direction": "left"
   },
   "notes": "one window becomes a letter: a giant cropped L full of light, beams sweeping behind it",
   "layers": [
    {
     "shape": "rect",
     "x": 1500,
     "y": 1200,
     "width": 70,
     "height": 1700,
     "fill": {
      "type": "linear",
      "angle": 0,
      "stops": [
       [
        0,
        "#ffd9a000"
       ],
       [
        1,
        "#ffd9a0"
       ]
      ]
     },
     "anchor": [
      0.5,
      1
     ],
     "blend": "add",
     "blur": 14,
     "opacity": 0.5,
     "rotation": "=-40 + 12*sin(t*1.7)",
     "repeat": {
      "count": 6,
      "offset": {
       "rotate": 14
      },
      "stagger": 0.05
     },
     "animate": {
      "from": {
       "scaleY": 0
      },
      "duration": 0.45,
      "ease": "glide"
     }
    },
    {
     "shader": "light-shafts",
     "supersample": false,
     "uniforms": {
      "angle": 30,
      "spread": 0.35,
      "panes": 4,
      "intensity": 1.6,
      "haze": 1.2
     },
     "matte": "L"
    },
    {
     "id": "L",
     "text": "L",
     "size": 1600,
     "weight": 900,
     "x": 620,
     "y": 620,
     "inertia": "tight",
     "animate": {
      "from": {
       "scale": 1.25,
       "x": "+160"
      },
      "duration": 1.1,
      "ease": "glide"
     }
    },
    {
     "text": "18\u201424\nMarch",
     "size": 130,
     "weight": 300,
     "lineHeight": 0.95,
     "letterSpacing": -4,
     "color": "$paper",
     "x": 1780,
     "y": 330,
     "anchor": "right",
     "animator": {
      "by": "line",
      "y": 60,
      "opacity": 0,
      "delay": 0.15,
      "duration": 0.5,
      "smooth": 0.4,
      "ease": "glide"
     }
    }
   ]
  },
  {
   "id": "programme",
   "duration": 1.4,
   "transition": {
    "type": "zoomThrough",
    "layer": "L",
    "duration": 0.5
   },
   "notes": "through the letter into harbour water-light; the programme set editorially: contrasting sizes, not a list",
   "layers": [
    {
     "shader": "caustics",
     "supersample": false,
     "uniforms": {
      "speed": 0.8,
      "depth": 1.2,
      "tint": [
       0.95,
       0.62,
       0.32
      ]
     },
     "opacity": 0.9
    },
    {
     "shape": "rect",
     "x": 960,
     "y": 540,
     "width": 1920,
     "height": 1080,
     "fill": "#05050588"
    },
    {
     "type": "group",
     "drag": 0.03,
     "x": 960,
     "y": 540,
     "width": 1920,
     "height": 1080,
     "animate": {
      "from": {
       "y": 620
      },
      "duration": 0.5,
      "ease": "glide"
     },
     "layers": [
      {
       "text": "Tidal Rooms",
       "size": 190,
       "weight": 800,
       "letterSpacing": -8,
       "color": "$paper",
       "x": 120,
       "y": 200,
       "anchor": "left"
      },
      {
       "text": "Anna Voss \u2014 projection, the old dry dock",
       "size": 34,
       "weight": 400,
       "color": "$warm",
       "x": 128,
       "y": 300,
       "anchor": "left"
      },
      {
       "text": "Sodium Hours",
       "size": 250,
       "weight": 900,
       "letterSpacing": -14,
       "color": "$warm",
       "x": 1810,
       "y": 790,
       "anchor": "right",
       "width": 1800
      },
      {
       "text": "Ruth Adeyemi \u2014 400 street lamps, retuned",
       "size": 34,
       "weight": 400,
       "color": "$paper",
       "x": 1800,
       "y": 920,
       "anchor": "right"
      },
      {
       "text": "Night Swimmers",
       "size": 90,
       "weight": 600,
       "letterSpacing": -3,
       "color": "$paper",
       "x": 120,
       "y": 470,
       "anchor": "left"
      }
     ]
    }
   ]
  },
  {
   "id": "name",
   "duration": 1.7,
   "transition": {
    "type": "reveal",
    "shape": "square",
    "origin": [
     960,
     540
    ],
    "amount": -12,
    "duration": 0.4
   },
   "camera": {
    "zoom": "=1 + 0.04*t"
   },
   "notes": "button: the name as a building-wide window, cropped by the frame; light sweeps through it",
   "layers": [
    {
     "shader": "light-shafts",
     "supersample": false,
     "uniforms": {
      "angle": "=-35 + 45*t",
      "spread": 0.35,
      "panes": 5,
      "intensity": 1.7,
      "haze": 1.2
     },
     "matte": "nm"
    },
    {
     "id": "nm",
     "text": "LUMEN",
     "size": 620,
     "weight": 900,
     "letterSpacing": -30,
     "x": 980,
     "y": 700,
     "animator": {
      "by": "char",
      "y": 220,
      "duration": 0.55,
      "smooth": 0.3,
      "ease": "glide",
      "opacity": 0
     }
    },
    {
     "text": "18\u201424 March\nBristol Harbourside",
     "size": 44,
     "weight": 500,
     "lineHeight": 1.15,
     "color": "$paper",
     "x": 120,
     "y": 150,
     "anchor": "left",
     "start": 0.4,
     "animator": {
      "by": "line",
      "x": -30,
      "opacity": 0,
      "duration": 0.45,
      "smooth": 0.4,
      "ease": "glide"
     }
    },
    {
     "text": "lumen.fest",
     "size": 44,
     "weight": 500,
     "color": "$warm",
     "x": 1800,
     "y": 150,
     "anchor": "right",
     "start": 0.55,
     "animator": {
      "by": "char",
      "opacity": 0,
      "duration": 0.4,
      "smooth": 0.3
     }
    }
   ]
  }
 ]
}