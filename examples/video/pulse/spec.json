{
  "size": "9:16",
  "fps": 30,
  "transition": "cut",
  "theme": {
    "colors": {
      "primary": "#7b5cff",
      "secondary": "#22e4ff",
      "accent": "#ff2e88",
      "bg": "#07060f",
      "surface": "#15122a",
      "text": "#f6f4ff",
      "muted": "#b3acd6",
      "lime": "#c8ff1a",
      "ink": "#07060f",
      "hot": "#ff5a1f"
    },
    "fonts": {"heading": "Inter Display", "body": "Inter"},
    "styles": {
      "mega": {"font": "$heading", "size": "15vh", "weight": 900, "color": "$text", "lineHeight": 0.92, "letterSpacing": "-0.03em"},
      "big": {"font": "$heading", "size": "10vh", "weight": 900, "color": "$text", "lineHeight": 0.95, "letterSpacing": "-0.02em"},
      "tag": {"font": "$body", "size": "2.3vh", "weight": 700, "color": "$muted", "uppercase": true, "letterSpacing": "0.14em"}
    }
  },
  "audio": [{"src": "pulse.flac"}],
  "scenes": [
    {
      "id": "intro",
      "duration": "@bar3",
      "background": "radial-gradient(#1b1240, $ink)",
      "camera": {"zoom": "=1 + 0.025 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)"},
      "layers": [
        {
          "component": "kinetic-grid",
          "opacity": 0.4,
          "props": {"shape": "dot", "wave": "radial", "colors": ["#7b5cff", "#22e4ff"], "speed": 2, "cols": 14, "step": 0.5}
        },
        {
          "shape": "circle",
          "width": 760,
          "height": 760,
          "fill": "none",
          "stroke": {"color": "#22e4ff", "width": 6},
          "glow": {"radius": 30, "color": "#22e4ff"},
          "scale": "=0.8 + 0.25 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)",
          "opacity": "=0.25 + 0.6 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)"
        },
        {
          "type": "group",
          "scale": "=1 + 0.1 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)",
          "layers": [
            {
              "text": "PULSE",
              "style": "mega",
              "size": "12.5vh",
              "kinetic": {"style": {"type": "glitch", "amount": 0.2}, "unit": "char", "stagger": 0.06, "duration": 0.45},
              "glow": {"radius": 40, "intensity": 0.8, "color": "#7b5cff"},
              "y": "44%",
              "end": "@beat2",
              "fit": true,
              "width": 737
            },
            {
              "text": "PULSE",
              "style": "mega",
              "size": "12.5vh",
              "glow": {"radius": 40, "intensity": 0.8, "color": "#7b5cff"},
              "y": "44%",
              "color": "#22e4ff",
              "start": "@beat2",
              "end": "@beat3",
              "fit": true,
              "width": 737
            },
            {
              "text": "PULSE",
              "style": "mega",
              "size": "12.5vh",
              "glow": {"radius": 40, "intensity": 0.8, "color": "#7b5cff"},
              "y": "44%",
              "color": "#ff2e88",
              "start": "@beat3",
              "end": "@beat4",
              "fit": true,
              "width": 737
            },
            {
              "text": "PULSE",
              "style": "mega",
              "size": "12.5vh",
              "glow": {"radius": 40, "intensity": 0.8, "color": "#7b5cff"},
              "y": "44%",
              "color": "#c8ff1a",
              "start": "@beat4",
              "end": "@beat5",
              "fit": true,
              "width": 737
            },
            {
              "text": "PULSE",
              "style": "mega",
              "size": "12.5vh",
              "glow": {"radius": 40, "intensity": 0.8, "color": "#7b5cff"},
              "y": "44%",
              "color": "#f6f4ff",
              "start": "@beat5",
              "fit": true,
              "width": 737
            }
          ]
        },
        {"text": "an original track · 120 bpm", "style": "tag", "y": "14%", "start": "@beat5", "kinetic": "tracking"},
        {
          "text": "TURN IT\nUP",
          "style": "big",
          "color": "#f6f4ff",
          "size": "8vh",
          "y": "66%",
          "start": "@bar2",
          "kinetic": {"style": {"type": "karaoke", "active": "#ff2e88", "dim": 0.18}, "unit": "word", "stagger": 0.5},
          "fit": true,
          "width": 809
        }
      ]
    },
    {
      "id": "lights",
      "duration": 2,
      "background": "#07060f",
      "camera": {"zoom": "=1 + 0.03 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)"},
      "layers": [
        {
          "component": "visualizer",
          "y": "72%",
          "height": 640,
          "width": 1000,
          "props": {
            "src": "pulse.flac",
            "offset": 4,
            "style": "bars",
            "bands": 28,
            "mirror": true,
            "colors": ["#7b5cff", "#ff2e88", "#22e4ff"],
            "gain": 1.8,
            "beats": true
          }
        },
        {
          "text": "LIGHTS\nLOW",
          "style": "mega",
          "y": "40%",
          "kinetic": {"style": {"type": "mask", "direction": "up"}, "unit": "word", "stagger": 0.5, "duration": 0.4},
          "size": "13vh",
          "fit": true,
          "width": 805
        },
        {"text": "01 / 04", "style": "tag", "y": "14%", "color": "#22e4ff"}
      ]
    },
    {
      "id": "signal",
      "duration": 2,
      "background": "linear-gradient(160deg, #3a1cff, #12083a)",
      "camera": {"zoom": "=1 + 0.03 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)"},
      "layers": [
        {
          "component": "visualizer",
          "y": "40%",
          "width": 880,
          "height": 880,
          "props": {
            "src": "pulse.flac",
            "offset": 6,
            "style": "circle",
            "bands": 72,
            "colors": ["#22e4ff", "#ffffff"],
            "gain": 1.2,
            "beats": true,
            "radius": 0.5
          }
        },
        {
          "text": "SIGNAL\nHIGH",
          "style": "mega",
          "size": "11vh",
          "y": "70%",
          "kinetic": {"style": "pop", "unit": "char", "stagger": 0.07, "duration": 0.35, "ease": "outBack"},
          "fit": true,
          "width": 805
        },
        {"text": "02 / 04", "style": "tag", "y": "14%", "color": "#22e4ff"}
      ]
    },
    {
      "id": "city",
      "duration": 2,
      "background": "#07060f",
      "camera": {"zoom": "=1 + 0.03 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)"},
      "layers": [
        {"component": "metaballs", "opacity": 0.85, "props": {"count": 7, "colors": ["#7b5cff", "#ff2e88"], "size": 0.1, "speed": 2.2}},
        {
          "text": "CITY ON\nMUTE",
          "style": "mega",
          "size": "12vh",
          "kinetic": {"style": "slide", "unit": "word", "stagger": 0.5, "duration": 0.4, "ease": "outExpo"},
          "fit": true,
          "width": 805
        },
        {"text": "03 / 04", "style": "tag", "y": "14%", "color": "#22e4ff"}
      ]
    },
    {
      "id": "noise",
      "duration": 2,
      "background": "#ff2e88",
      "camera": {"zoom": "=1 + 0.03 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)"},
      "layers": [
        {
          "component": "kinetic-grid",
          "opacity": 0.35,
          "props": {"shape": "square", "wave": "diagonal", "colors": ["#07060f", "#7b5cff"], "speed": 3, "step": 0.5}
        },
        {
          "text": "WE’RE\nTHE\nNOISE",
          "style": "mega",
          "size": "12vh",
          "color": "#07060f",
          "kinetic": {"style": "drop", "unit": "word", "stagger": 0.5, "duration": 0.45},
          "fit": true,
          "width": 805
        },
        {"text": "04 / 04", "style": "tag", "y": "14%", "color": "#07060f"}
      ]
    },
    {
      "id": "build",
      "duration": 6,
      "background": "radial-gradient(#160c38, $ink)",
      "camera": {
        "animate": [
          {"from": {"zoom": 1}, "to": {"zoom": 1.18}, "duration": 3.95, "ease": "inQuad"},
          {"to": {"zoom": 1}, "at": "@bar9", "duration": 0.6, "ease": "outExpo"}
        ],
        "shake": {"amount": 14, "frequency": 9, "at": "@bar9", "duration": 0.6}
      },
      "layers": [
        {
          "component": "particle-text",
          "y": "44%",
          "height": 900,
          "props": {
            "text": "PULSE",
            "count": 5000,
            "colors": ["#22e4ff", "#7b5cff", "#ff2e88"],
            "form": 1.8,
            "hold": 3,
            "exit": "none",
            "exitTime": 1.4,
            "size": 3.6
          },
          "end": "@bar9"
        },
        {
          "text": "4",
          "style": "mega",
          "size": "20vh",
          "y": "74%",
          "color": "#22e4ff",
          "start": "@beat29",
          "end": "@beat30",
          "enter": {"preset": "zoomIn", "duration": 0.25}
        },
        {
          "text": "3",
          "style": "mega",
          "size": "20vh",
          "y": "74%",
          "color": "#22e4ff",
          "start": "@beat30",
          "end": "@beat31",
          "enter": {"preset": "zoomIn", "duration": 0.25}
        },
        {
          "text": "2",
          "style": "mega",
          "size": "20vh",
          "y": "74%",
          "color": "#ff2e88",
          "start": "@beat31",
          "end": "@beat32",
          "enter": {"preset": "zoomIn", "duration": 0.25}
        },
        {
          "text": "1",
          "style": "mega",
          "size": "20vh",
          "y": "74%",
          "color": "#ff2e88",
          "start": "@beat32",
          "end": "@bar9",
          "enter": {"preset": "zoomIn", "duration": 0.25}
        },
        {
          "text": "HOLD IT…",
          "style": "big",
          "y": "74%",
          "size": "6vh",
          "color": "#b3acd6",
          "start": "@bar7",
          "end": "@beat29",
          "kinetic": {"style": "typewriter", "duration": 0.8},
          "fit": true,
          "width": 830
        },
        {"shape": "rect", "width": "100%", "height": "100%", "fill": "#c8ff1a", "start": "@bar9", "enter": {"preset": "fadeIn", "duration": 0.08}},
        {
          "shape": "circle",
          "width": 300,
          "height": 300,
          "fill": "none",
          "stroke": {"color": "#07060f", "width": 18},
          "y": "44%",
          "start": "@bar9",
          "animate": [{"from": {"scale": 0.2, "opacity": 1}, "to": {"scale": 7, "opacity": 0}, "duration": 0.9, "ease": "outExpo"}]
        },
        {
          "component": "particle-text",
          "y": "44%",
          "height": 900,
          "props": {
            "text": "PULSE",
            "count": 7000,
            "colors": ["#07060f", "#ff2e88", "#7b5cff"],
            "form": 0.05,
            "hold": 0,
            "exit": "explode",
            "exitTime": 1.3,
            "size": 5,
            "glow": false,
            "blend": "normal",
            "stagger": 0.15
          },
          "start": "@bar9"
        },
        {
          "type": "group",
          "scale": "=1 + 0.09 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)",
          "layers": [
            {
              "text": "DROP",
              "style": "mega",
              "size": "16.2vh",
              "color": "#07060f",
              "y": "46%",
              "start": "@bar9+0.5",
              "kinetic": {"style": "pop", "unit": "char", "stagger": 0.05, "duration": 0.3},
              "fit": true,
              "width": 761
            }
          ]
        },
        {
          "component": "confetti",
          "start": "@bar9",
          "props": {
            "mode": "burst",
            "at": 0,
            "origin": [0.5, 0.45],
            "count": 220,
            "colors": ["#07060f", "#ff2e88", "#7b5cff", "#ffffff"],
            "power": 1.5
          }
        }
      ]
    },
    {
      "id": "frequency",
      "duration": 4,
      "background": "#c8ff1a",
      "camera": {"zoom": "=1 + 0.05 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)"},
      "layers": [
        {
          "component": "visualizer",
          "y": "40%",
          "width": 1080,
          "height": 1080,
          "props": {
            "src": "pulse.flac",
            "offset": 18,
            "style": "circle",
            "bands": 96,
            "colors": ["#07060f", "#ff2e88"],
            "gain": 1.4,
            "beats": false,
            "radius": 0.42
          }
        },
        {
          "shape": "circle",
          "y": "40%",
          "width": 520,
          "height": 520,
          "fill": "#07060f",
          "scale": "=0.93 + 0.1 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)"
        },
        {
          "text": "WE ARE THE\nFREQUENCY",
          "style": "big",
          "size": "7.8vh",
          "color": "#07060f",
          "y": "73%",
          "kinetic": {"style": {"type": "karaoke", "active": "#ff2e88", "dim": 0.22}, "unit": "word", "stagger": 0.5},
          "fit": true,
          "width": 790
        }
      ]
    },
    {
      "id": "shape",
      "duration": 2,
      "background": "#07060f",
      "camera": {"zoom": "=1 + 0.05 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)"},
      "layers": [
        {
          "component": "morph",
          "y": "42%",
          "width": 1000,
          "height": 1000,
          "props": {
            "shapes": ["circle", "star", "triangle", "heart", "hexagon"],
