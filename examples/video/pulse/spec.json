          "size": "17vh",
          "color": "#f6f4ff",
          "start": 0.5,
          "end": 1,
          "enter": {"preset": "zoomIn", "duration": 0.2},
          "fit": true,
          "width": 783
        },
        {
          "text": "THE",
          "style": "mega",
          "size": "22vh",
          "color": "#07060f",
          "start": 1,
          "end": 1.5,
          "enter": {"preset": "zoomIn", "duration": 0.2},
          "fit": true,
          "width": 783
        },
        {
          "text": "CITY",
          "style": "mega",
          "size": "20.2vh",
          "color": "#f6f4ff",
          "start": 1.5,
          "enter": {"preset": "zoomIn", "duration": 0.2},
          "fit": true,
          "width": 783
        }
      ]
    },
    {
      "id": "allnight",
      "duration": 2,
      "background": "#c8ff1a",
      "camera": {"zoom": "=1 + 0.05 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)"},
      "layers": [
        {"component": "metaballs", "props": {"count": 10, "colors": ["#ff2e88", "#ff5a1f"], "size": 0.09, "speed": 3}},
        {
          "text": "ALL\nNIGHT",
          "style": "mega",
          "size": "15.7vh",
          "color": "#07060f",
          "kinetic": {"style": "rise", "unit": "word", "stagger": 0.5, "duration": 0.35, "ease": "outExpo"},
          "fit": true,
          "width": 790
        },
        {
          "component": "visualizer",
          "y": "77%",
          "height": 260,
          "width": 1000,
          "props": {"src": "pulse.flac", "offset": 26, "style": "wave", "colors": ["#07060f", "#07060f"], "gain": 1.3, "line": 6}
        }
      ]
    },
    {
      "id": "chest",
      "duration": 4,
      "background": "radial-gradient(#1a0f2e, $ink)",
      "layers": [
        {"component": "god-rays", "props": {"at": [0.5, -0.05], "angle": 90, "spread": 60, "color": "#c8ff1a", "intensity": 0.6, "spin": 4}},
        {
          "component": "metaballs",
          "y": "40%",
          "height": 900,
          "opacity": 0.9,
          "props": {"count": 6, "colors": ["#c8ff1a", "#22e4ff"], "size": 0.12, "speed": 0.8}
        },
        {
          "type": "group",
          "y": "70%",
          "height": 700,
          "scale": "=1 + 0.04 * pow(max(0, 1 - 2.5 * (gt * 2 - floor(gt * 2))), 3)",
          "layers": [
            {
              "text": "FEEL IT\nIN YOUR\nCHEST",
              "style": "big",
              "size": "9vh",
              "y": "50%",
              "kinetic": {"style": {"type": "karaoke", "active": "#c8ff1a", "dim": 0.25}, "unit": "word", "stagger": 0.5},
              "fit": true,
              "width": 798
            }
          ]
        }
      ]
    },
    {
      "id": "outro",
      "duration": 4,
      "background": "#07060f",
      "camera": {
        "animate": [{"keyframes": {"zoom": [1.15, 1]}, "duration": 0.8, "ease": "outExpo"}],
        "shake": {"amount": 16, "frequency": 10, "duration": 0.5}
      },
      "layers": [
        {"component": "sparks", "props": {"bursts": [0], "origin": [0.5, 0.42], "count": 160, "colors": ["#c8ff1a", "#ff2e88"], "power": 1.4}},
        {
          "component": "visualizer",
          "y": "42%",
          "width": 1080,
          "height": 1080,
          "opacity": 0.45,
          "props": {"src": "pulse.flac", "offset": 32, "style": "circle", "bands": 96, "colors": ["#7b5cff", "#ff2e88"], "gain": 1.3, "radius": 0.55}
        },
        {"component": "lens-flare", "props": {"path": [[0.05, 0.42], [0.95, 0.42]], "times": [0, 3.5], "color": "#c8ff1a", "intensity": 0.8}},
        {
          "text": "PULSE",
          "style": "mega",
          "size": "12.5vh",
          "y": "42%",
          "color": "linear-gradient(90deg, $lime, $accent)",
          "kinetic": {"style": "tracking", "unit": "char", "duration": 0.8, "ease": "outExpo"},
          "fit": true,
          "width": 830
        },
        {"text": "1 JSON file → 1 MP4", "style": "tag", "y": "54%", "width": 900, "start": "@beat69", "kinetic": "rise"},
        {"text": "made with anikit-video", "style": "tag", "color": "#c8ff1a", "y": "58.5%", "start": "@beat70", "kinetic": "rise"},
        {"shape": "rect", "width": "100%", "height": "100%", "fill": "#07060f", "start": 3.4, "enter": {"preset": "fadeIn", "duration": 0.55}}
      ]
    }
  ]
}
