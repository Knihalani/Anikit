{
  "size": [1920, 1080], "fps": 30, "intent": "fast",
  "background": "#f3eee2",
  "fonts": { "Bricolage Grotesque": "fonts/BricolageGrotesque.ttf", "IBM Plex Mono": "fonts/IBMPlexMono-Medium.ttf" },
  "theme": { "colors": { "paper": "#f3eee2", "pink": "#ff48b0", "blue": "#3255a4", "yellow": "#ffe800", "teal": "#00838a" },
             "fonts": { "heading": "Bricolage Grotesque", "body": "Bricolage Grotesque", "mono": "IBM Plex Mono" } },
  "music": { "style": "pop", "instrumentation": "band", "bpm": 124, "key": "G", "mood": "playful bright" },
  "post": { "grain": 0.035, "grainSize": 1.4 },
  "transition": "cut",
  "grid": { "columns": 6, "rows": 4, "margin": [48, 56], "gutter": 16 },
  "scenes": [
    { "id": "cover", "duration": "3 beats", "layers": [
      { "shape": "blob", "sides": 7, "wobble": 0.55, "seed": 12, "x": 1240, "y": 520, "width": 1150, "height": 980,
        "fill": { "type": "radial", "center": [0.35, 0.35], "radius": 0.9, "stops": ["#ffd7ee", "#ff48b0"] },
        "halftone": { "cell": 12, "angle": 75, "ink": "$pink", "gain": 1.15 }, "blend": "multiply",
        "wigglePath": { "amount": 14, "detail": 9, "speed": 0.6 },
        "animate": [ { "from": { "scale": 0.3, "rotation": -30 }, "duration": 0.7, "ease": "outBack" } ] },
      { "cell": "1-6/1-4", "x": 64, "y": 54, "text": "PAPER\nWEEKEND", "size": 300, "weight": 800, "lineHeight": 0.8, "letterSpacing": "-0.04em", "color": "$pink", "blend": "multiply",
        "kinetic": "pop by char 0.4s 25ms outBack" },
      { "cell": "1-6/1-4", "text": "PAPER\nWEEKEND", "size": 300, "weight": 800, "lineHeight": 0.8, "letterSpacing": "-0.04em", "color": "$blue", "blend": "multiply",
        "kinetic": "pop by char 0.4s 25ms outBack" },
      { "cell": "1-3/4", "anchor": "bottomLeft", "text": "a small press fair · zines · prints · comics", "font": "$mono", "size": 26, "color": "$blue", "kinetic": "typewriter" }
    ] },
    { "id": "overprint", "duration": "2 beats", "background": "#f3eee2", "layers": [
      { "shape": "circle", "x": 760, "y": 540, "width": 760, "height": 760, "fill": "$yellow", "blend": "multiply",
        "animate": [ { "from": { "x": 260 }, "duration": 0.6, "ease": "outExpo" } ] },
      { "shape": "circle", "x": 1160, "y": 540, "width": 760, "height": 760, "fill": "$blue", "blend": "multiply",
        "animate": [ { "from": { "x": 1660 }, "duration": 0.6, "ease": "outExpo" } ] },
      { "shape": "circle", "x": 960, "y": 540, "width": 360, "height": 360, "fill": "$pink", "blend": "multiply",
        "animate": [ { "from": { "scale": 0 }, "duration": 0.45, "ease": "outBack", "at": 0.25 } ] },
      { "x": 960, "y": 540, "text": "ink on ink", "size": 64, "weight": 700, "color": "$paper", "enter": { "preset": "fadeIn", "duration": 0.15, "delay": 0.4 } }
    ] },
    { "id": "pages", "duration": "3 beats", "background": "$yellow", "layers": [
      { "x": 520, "y": 560, "width": 620, "height": 820, "rotation": -7, "shape": "rect", "fill": "$paper",
        "animate": [ { "from": { "y": 1500, "rotation": -25 }, "duration": 0.55, "ease": "outExpo" } ] },
      { "x": 520, "y": 560, "width": 560, "height": 760, "rotation": -7, "pattern": { "kind": "waves", "spacing": 34, "mark": 0.18 }, "fill": "$blue", "blend": "multiply",
        "animate": [ { "from": { "y": 1500, "rotation": -25 }, "duration": 0.55, "ease": "outExpo" } ] },
      { "x": 1000, "y": 520, "width": 620, "height": 820, "rotation": 4, "shape": "rect", "fill": "$paper",
        "animate": [ { "from": { "y": 1500, "rotation": 20 }, "duration": 0.55, "ease": "outExpo", "at": 0.12 } ] },
      { "x": 1000, "y": 520, "width": 560, "height": 760, "rotation": 4, "pattern": { "kind": "checker", "spacing": 70 }, "fill": "$pink", "blend": "multiply",
        "animate": [ { "from": { "y": 1500, "rotation": 20 }, "duration": 0.55, "ease": "outExpo", "at": 0.12 } ] },
      { "x": 1460, "y": 580, "width": 620, "height": 820, "rotation": -3, "shape": "rect", "fill": "$paper",
        "animate": [ { "from": { "y": 1500, "rotation": -15 }, "duration": 0.55, "ease": "outExpo", "at": 0.24 } ] },
      { "x": 1460, "y": 580, "width": 560, "height": 760, "rotation": -3, "pattern": { "kind": "truchet", "spacing": 56, "mark": 0.22, "seed": 3 }, "fill": "$teal", "blend": "multiply",
        "animate": [ { "from": { "y": 1500, "rotation": -15 }, "duration": 0.55, "ease": "outExpo", "at": 0.24 } ] },
      { "x": 1460, "y": 580, "width": 460, "height": 330, "rotation": -3, "shape": "rect", "fill": "$paper",
        "animate": [ { "from": { "y": 1500, "rotation": -15 }, "duration": 0.55, "ease": "outExpo", "at": 0.24 } ] },
      { "x": 1460, "y": 580, "rotation": -3, "text": "120\ntables", "size": 124, "weight": 800, "lineHeight": 0.85, "color": "$pink", "blend": "multiply",
        "animate": [ { "from": { "y": 1500, "rotation": -15 }, "duration": 0.55, "ease": "outExpo", "at": 0.24 } ] }
    ] },
    { "id": "growth", "duration": "2 beats", "layers": [
      { "shader": "turing", "x": 0, "y": 0, "anchor": "topLeft", "width": 1920, "height": 1080,
        "gradientMap": ["#3255a4", "#ff48b0", "#f3eee2"], "posterize": 3, "toneRange": [0.15, 0.85] },
      { "cell": "1-4/3-4", "shape": "rect", "fill": "$paper", "x": 0, "y": 1080, "anchor": "bottomLeft", "width": 1120, "height": 430,
        "animate": [ { "from": { "scaleX": 0 }, "duration": 0.35, "ease": "outExpo" } ] },
      { "cell": "1-4/3-4", "anchor": "bottomLeft", "text": "made by hand,\nprinted by drum", "size": 110, "weight": 800, "lineHeight": 0.88, "letterSpacing": "-0.03em", "color": "$blue",
        "kinetic": "mask by line up 0.45s 80ms outExpo" }
    ] },
    { "id": "date", "duration": "3 beats", "background": "$blue", "layers": [
      { "text": "2—3\nMAY", "size": 470, "weight": 800, "lineHeight": 0.78, "letterSpacing": "-0.05em", "color": "$yellow",
        "x": 972, "y": 566, "kinetic": "pop by char 0.4s 40ms outBack" },
      { "x": 960, "y": 560, "text": "2—3\nMAY", "size": 470, "weight": 800, "lineHeight": 0.78, "letterSpacing": "-0.05em",
        "color": "$pink", "halftone": { "cell": 11, "angle": 15, "ink": "$pink", "gain": 0.9 },
        "kinetic": "pop by char 0.4s 40ms outBack" }
    ] },
    { "id": "lockup", "duration": "6 beats", "layers": [
      { "cell": "4-6/1-4", "shape": "arc", "width": 840, "height": 840, "anchor": "right", "startAngle": 180, "endAngle": 360, "fill": "$pink", "blend": "multiply",
        "halftone": { "cell": 9, "angle": 75, "ink": "$pink" }, "animate": [ { "from": { "rotation": -180 }, "duration": 0.8, "ease": "outExpo" } ] },
      { "cell": "4-6/1-4", "shape": "squircle", "exponent": 3, "width": 460, "height": 460, "anchor": "center", "fill": "$yellow", "blend": "multiply",
        "animate": [ { "from": { "scale": 0, "rotation": 45 }, "duration": 0.6, "ease": "outBack", "at": 0.2 } ] },
      { "cell": "1-4/1-3", "x": 61, "y": 53, "text": "PAPER\nWEEKEND", "size": 210, "weight": 800, "lineHeight": 0.8, "letterSpacing": "-0.04em", "color": "$pink", "blend": "multiply",
        "kinetic": "mask by line up 0.5s 80ms outExpo" },
      { "cell": "1-4/1-3", "text": "PAPER\nWEEKEND", "size": 210, "weight": 800, "lineHeight": 0.8, "letterSpacing": "-0.04em", "color": "$blue", "blend": "multiply",
        "kinetic": "mask by line up 0.5s 80ms outExpo" },
      { "cell": "1-2/4", "anchor": "bottomLeft", "text": "2—3 May\nOld Tram Depot\nfree entry", "font": "$mono", "size": 28, "lineHeight": 1.3, "color": "$blue", "enter": { "preset": "fadeIn", "duration": 0.2, "delay": 0.5 } },
      { "cell": "3/4", "anchor": "bottomLeft", "text": "risograph\n3 inks\n120 tables", "font": "$mono", "size": 28, "lineHeight": 1.3, "color": "$pink", "blend": "multiply", "enter": { "preset": "fadeIn", "duration": 0.2, "delay": 0.6 } }
    ] }
  ]
}
