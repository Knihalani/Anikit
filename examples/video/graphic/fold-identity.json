{
  "size": [1920, 1080], "fps": 30, "intent": "fast",
  "background": "#efe6d6",
  "fonts": { "Space Grotesk": "fonts/SpaceGrotesk.ttf", "IBM Plex Mono": "fonts/IBMPlexMono-Medium.ttf" },
  "theme": { "colors": { "sand": "#efe6d6", "pine": "#0f3d2e", "signal": "#ff5a1f", "ink": "#121212", "mist": "#c9d3cc" },
             "fonts": { "heading": "Space Grotesk", "body": "Space Grotesk", "mono": "IBM Plex Mono" } },
  "music": { "style": "acoustic", "bpm": 120, "key": "E", "mood": "confident warm" },
  "transition": "cut",
  "grid": { "columns": 12, "rows": 6, "margin": [56, 64], "gutter": 16,
            "areas": { "label": "1-3/1", "idx": "10-12/1", "stage": "4-9/1-6", "left": "1-6/1-6", "right": "7-12/1-6" } },
  "defs": {
    "mark": { "type": "group", "width": 400, "height": 400, "layers": [
      { "shape": "squircle", "exponent": 4.5, "width": 400, "height": 400, "fill": "$pine" },
      { "shape": "arc", "x": 200, "y": 200, "width": 250, "height": 250, "startAngle": 90, "endAngle": 360, "innerRadius": 0.5, "fill": "$signal" },
      { "shape": "circle", "x": 262, "y": 138, "width": 62, "height": 62, "fill": "$signal" } ] }
  },
  "scenes": [
    { "id": "construct", "duration": "4 beats", "grid": { "columns": 12, "rows": 6, "margin": [56, 64], "gutter": 16, "show": "under", "color": "#0f3d2e55",
        "areas": { "label": "1-3/1", "idx": "7-12/1", "stage": "4-9/1-6" } }, "layers": [
      { "shape": "circle", "x": 960, "y": 540, "width": 760, "height": 760, "fill": "none", "stroke": { "color": "$ink", "width": 1.5, "dash": [6, 6] }, "enter": "drawOn" },
      { "shape": "line", "points": [[0, 540], [1920, 540]], "stroke": { "color": "$ink", "width": 1.5 }, "enter": { "preset": "drawOn", "duration": 0.5 } },
      { "shape": "line", "points": [[960, 0], [960, 1080]], "stroke": { "color": "$ink", "width": 1.5 }, "enter": { "preset": "drawOn", "duration": 0.5 } },
      { "use": "mark", "x": 960, "y": 540, "scale": 1.6, "animate": [ { "from": { "scale": 0.2, "rotation": -90 }, "duration": 0.8, "ease": "outExpo", "at": 0.25 } ] },
      { "cell": "label", "text": "01  Mark", "font": "$mono", "size": 24, "color": "$ink" },
      { "cell": "idx", "anchor": "topRight", "text": "squircle n = 4.5 · arc 270° · r 0.5", "font": "$mono", "size": 24, "color": "$ink" }
    ] },
    { "id": "scale", "duration": "3 beats", "background": "$pine", "layers": [
      { "use": "mark", "x": 300, "y": 600, "scale": 0.25, "with": {}, "animate": [ { "from": { "y": 900 }, "duration": 0.5, "ease": "outExpo" } ] },
      { "use": "mark", "x": 700, "y": 600, "scale": 0.6, "animate": [ { "from": { "y": 1100 }, "duration": 0.5, "ease": "outExpo", "at": 0.08 } ] },
      { "use": "mark", "x": 1360, "y": 600, "scale": 1.55, "animate": [ { "from": { "y": 1500 }, "duration": 0.6, "ease": "outExpo", "at": 0.16 } ] },
      { "x": 300, "y": 900, "text": "24 px", "font": "$mono", "size": 24, "color": "$sand" },
      { "x": 700, "y": 900, "text": "96 px", "font": "$mono", "size": 24, "color": "$sand" },
      { "cell": "label", "text": "02  Scale", "font": "$mono", "size": 24, "color": "$sand" }
    ] },
    { "id": "colour", "duration": "3 beats", "layers": [
      { "cell": "1-3/1-6", "shape": "rect", "fill": "$pine", "anchor": "bottom", "animate": [ { "from": { "scaleY": 0 }, "duration": 0.45, "ease": "outExpo" } ] },
      { "cell": "4-6/1-6", "shape": "rect", "fill": "$signal", "anchor": "bottom", "animate": [ { "from": { "scaleY": 0 }, "duration": 0.45, "ease": "outExpo", "at": 0.07 } ] },
      { "cell": "7-9/1-6", "shape": "rect", "fill": "$mist", "anchor": "bottom", "animate": [ { "from": { "scaleY": 0 }, "duration": 0.45, "ease": "outExpo", "at": 0.14 } ] },
      { "cell": "10-12/1-6", "shape": "rect", "fill": "$ink", "anchor": "bottom", "animate": [ { "from": { "scaleY": 0 }, "duration": 0.45, "ease": "outExpo", "at": 0.21 } ] },
      { "cell": "1-3/6", "anchor": "bottomLeft", "x": 88, "y": 1000, "text": "Pine\n#0F3D2E", "font": "$mono", "size": 26, "lineHeight": 1.3, "color": "$sand", "enter": { "preset": "fadeIn", "delay": 0.4, "duration": 0.2 } },
      { "cell": "4-6/6", "anchor": "bottomLeft", "x": 568, "y": 1000, "text": "Signal\n#FF5A1F", "font": "$mono", "size": 26, "lineHeight": 1.3, "color": "$ink", "enter": { "preset": "fadeIn", "delay": 0.45, "duration": 0.2 } },
      { "cell": "7-9/6", "anchor": "bottomLeft", "x": 1048, "y": 1000, "text": "Mist\n#C9D3CC", "font": "$mono", "size": 26, "lineHeight": 1.3, "color": "$ink", "enter": { "preset": "fadeIn", "delay": 0.5, "duration": 0.2 } },
      { "cell": "10-12/6", "anchor": "bottomLeft", "x": 1528, "y": 1000, "text": "Ink\n#121212", "font": "$mono", "size": 26, "lineHeight": 1.3, "color": "$sand", "enter": { "preset": "fadeIn", "delay": 0.55, "duration": 0.2 } },
      { "cell": "1-3/1", "x": 88, "y": 80, "text": "03  Colour", "font": "$mono", "size": 24, "color": "$sand" }
    ] },
    { "id": "pattern", "duration": "3 beats", "background": "$pine", "layers": [
      { "x": 960, "y": 540, "width": 1920, "height": 1080, "pattern": { "kind": "arcs", "spacing": 120, "seed": 21 }, "fill": "$signal",
        "animate": [ { "from": { "scale": 2.2 }, "duration": 0.9, "ease": "outExpo" } ] },
      { "cell": "4-9/2-5", "shape": "squircle", "exponent": 4.5, "fill": "$sand", "anchor": "center", "width": 720, "height": 420,
        "animate": [ { "from": { "scale": 0 }, "duration": 0.5, "ease": "outBack", "at": 0.2 } ] },
      { "x": 960, "y": 540, "text": "The quarter turn\nis the pattern.", "size": 64, "weight": 600, "lineHeight": 1.05, "letterSpacing": "-0.02em", "color": "$pine",
        "kinetic": "rise by word 0.4s 50ms outExpo", "start": 0.35 },
      { "cell": "label", "text": "04  Pattern", "font": "$mono", "size": 24, "color": "$sand" }
    ] },
    { "id": "type", "duration": "3 beats", "background": "$sand", "layers": [
      { "cell": "1-6/1-6", "anchor": "bottomLeft", "y": 1060, "text": "Aa", "size": 760, "weight": 600, "lineHeight": 0.8, "letterSpacing": "-0.06em", "color": "$pine",
        "animate": [ { "from": { "y": 1500 }, "duration": 0.6, "ease": "outExpo" } ] },
      { "cell": "8-12/2-4", "text": "Space Grotesk\nABCDEFGHIJKLM\nNOPQRSTUVWXYZ\n0123456789 → ↗", "size": 54, "weight": 500, "lineHeight": 1.15, "color": "$ink",
        "kinetic": "mask by line up 0.4s 60ms outExpo" },
      { "cell": "8-12/6", "anchor": "bottomLeft", "text": "Display 600 · −2% · Text 400 · Mono for data", "font": "$mono", "size": 24, "color": "$signal" },
      { "cell": "8-12/1", "text": "05  Type", "font": "$mono", "size": 24, "color": "$ink" }
    ] },
    { "id": "sign", "duration": "3 beats", "background": "#20262a", "layers": [
      { "x": 960, "y": 540, "width": 1500, "height": 620, "shape": "rect", "radius": 36, "fill": "$pine",
        "animate": [ { "from": { "x": 2800 }, "duration": 0.6, "ease": "outExpo" } ] },
      { "x": 1650, "y": 540, "width": 380, "height": 620, "pattern": { "kind": "stripes", "spacing": 44, "angle": 45 }, "fill": "$signal", "clip": true,
        "animate": [ { "from": { "x": 3490 }, "duration": 0.6, "ease": "outExpo" } ] },
      { "use": "mark", "x": 430, "y": 540, "scale": 0.8, "animate": [ { "from": { "x": 2270 }, "duration": 0.6, "ease": "outExpo" } ] },
      { "x": 640, "y": 540, "anchor": "left", "text": "Depot 4\nNorth gate →", "align": "left", "size": 120, "weight": 600, "lineHeight": 1.0, "letterSpacing": "-0.02em", "color": "$sand",
        "animate": [ { "from": { "x": 2480 }, "duration": 0.6, "ease": "outExpo" } ] },
      { "x": 64, "y": 56, "anchor": "topLeft", "text": "06  Wayfinding", "font": "$mono", "size": 24, "color": "$sand" }
    ] },
    { "id": "lockup", "duration": "6 beats", "layers": [
      { "use": "mark", "x": 700, "y": 540, "scale": 0.9, "animate": [ { "from": { "rotation": 90, "scale": 0.5 }, "duration": 0.7, "ease": "outExpo" } ] },
      { "x": 920, "y": 540, "anchor": "left", "text": "fold", "size": 330, "weight": 600, "letterSpacing": "-0.05em", "color": "$pine",
        "kinetic": "mask by char up 0.5s 50ms outExpo" },
      { "cell": "1-4/6", "anchor": "bottomLeft", "text": "Fold Freight — identity system, 2027", "font": "$mono", "size": 24, "color": "$ink", "enter": { "preset": "fadeIn", "delay": 0.5, "duration": 0.3 } },
      { "cell": "9-12/6", "anchor": "bottomRight", "text": "mark · colour · pattern · type · signage", "font": "$mono", "size": 24, "color": "$signal", "enter": { "preset": "fadeIn", "delay": 0.6, "duration": 0.3 } }
    ] }
  ]
}
