{
  "$id": "https://anikit.dev/video/spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anikit Video spec",
  "description": "The whole video.",
  "type": "object",
  "properties": {
    "audio": {
      "description": "Music and sound effects.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/AudioCue"
      }
    },
    "background": {
      "description": "Default background of every scene (colour or gradient). Default `\"$bg\"`.",
      "anyOf": [
        {
          "$ref": "#/$defs/Paint"
        },
        {
          "type": "null"
        }
      ]
    },
    "captions": {
      "description": "Burned-in captions.",
      "anyOf": [
        {
          "$ref": "#/$defs/Captions"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration": {
      "description": "Override the total duration (truncate, or hold the last frame).",
      "anyOf": [
        {
          "$ref": "#/$defs/Num"
        },
        {
          "type": "null"
        }
      ]
    },
    "fonts": {
      "description": "Extra fonts: family name → file path.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "fps": {
      "description": "Frames per second. Default 30.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "markers": {
      "description": "Named times on the global timeline, referenced as `\"@name\"`.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/Num"
      }
    },
    "scenes": {
      "description": "The scenes, in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SceneItem"
      }
    },
    "size": {
      "description": "Frame size preset or `[w, h]`. Default `\"16:9\"` (1920×1080).",
      "anyOf": [
        {
          "$ref": "#/$defs/Size"
        },
        {
          "type": "null"
        }
      ]
    },
    "theme": {
      "description": "Colour tokens, fonts and text styles.",
      "anyOf": [
        {
          "$ref": "#/$defs/Theme"
        },
        {
          "type": "null"
        }
      ]
    },
    "transition": {
      "description": "Default transition between scenes. Default crossfade 0.5 s.",
      "anyOf": [
        {
          "$ref": "#/$defs/Transition"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "scenes"
  ],
  "$defs": {
    "Anchor": {
      "description": "Anchor: `[ax, ay]` in 0..1 or a name (`center`, `topLeft`, …).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        }
      ]
    },
    "AnimateItem": {
      "description": "Schema helper: `animate` as a preset name, one tween or a list.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Tween"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tween"
          }
        }
      ]
    },
    "AudioCue": {
      "description": "An audio cue.",
      "type": "object",
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "duck": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "fadeIn": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "fadeOut": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "loop": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "src": {
          "type": "string"
        },
        "trimStart": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "voice": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "volume": {
          "description": "0..1 or `\"-6dB\"`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "src"
      ]
    },
    "BoxStyle": {
      "description": "Flexbox style of a `box` (and of a box's children: `grow`).",
      "type": "object",
      "properties": {
        "align": {
          "description": "Cross axis: `start`, `center` (default), `end`, `stretch`.",
          "type": [
            "string",
            "null"
          ]
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/Paint"
            },
            {
              "type": "null"
            }
          ]
        },
        "border": {
          "description": "`\"2px #fff\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "description": "Grid with this many equal columns.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "direction": {
          "description": "`row` (default) or `column`.",
          "type": [
            "string",
            "null"
          ]
        },
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "grow": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "justify": {
          "description": "Main axis: `start`, `center`, `end`, `spaceBetween`, `spaceAround`, `spaceEvenly`.",
          "type": [
            "string",
            "null"
          ]
        },
        "padding": {
          "description": "Number, `[v, h]` or `[t, r, b, l]`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Padding"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "wrap": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "Camera": {
      "description": "Scene camera.",
      "type": "object",
      "properties": {
        "animate": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnimateItem"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "shake": {
          "anyOf": [
            {
              "$ref": "#/$defs/Shake"
            },
            {
              "type": "null"
            }
          ]
        },
        "x": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "y": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "zoom": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CaptionCue": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Num"
        },
        "end": {
          "$ref": "#/$defs/Num"
        },
        "text": {
          "type": "string"
        },
        "words": {
          "description": "Word timings `[text, at, end]`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "number",
                "format": "double"
              },
              {
                "type": "number",
                "format": "double"
              }
            ]
          }
        }
      },
      "required": [
        "text",
        "at",
        "end"
      ]
    },
    "CaptionFile": {
      "type": "object",
      "properties": {
        "background": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "cues": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/CaptionCue"
          }
        },
        "highlight": {
          "type": [
            "string",
            "null"
          ]
        },
        "src": {
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "type": [
            "string",
            "null"
          ]
        },
        "y": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Captions": {
      "description": "Captions: a list of cues, or a subtitle file with styling.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaptionCue"
          }
        },
        {
          "$ref": "#/$defs/CaptionFile"
        }
      ]
    },
    "Clip": {
      "description": "`clip`: `true` (the layer box) or a shape layer.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/Layer"
        }
      ]
    },
    "Glow": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/GlowObj"
        }
      ]
    },
    "GlowObj": {
      "type": "object",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "intensity": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "radius": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "Gradient": {
      "description": "Gradient object.",
      "type": "object",
      "properties": {
        "angle": {
          "description": "Linear angle in degrees (CSS convention: 180 = top to bottom). Default 180.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "center": {
          "description": "Radial centre `[x, y]` as fractions of the box. Default `[0.5, 0.5]`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "radius": {
          "description": "Radial radius as a fraction of the box diagonal / 2. Default 1.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "stops": {
          "description": "Colours, evenly spaced, or `[offset, colour]` pairs.",
          "type": "array",
          "items": true
        },
        "type": {
          "description": "`linear` (default) or `radial`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "stops"
      ]
    },
    "Layer": {
      "description": "A layer. One flat type for every kind; `type` picks the kind (and is\ninferred when obvious). Keys that don't apply to the kind are warned about.",
      "type": "object",
      "properties": {
        "align": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Anchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "animate": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnimateItem"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blend": {
          "type": [
            "string",
            "null"
          ]
        },
        "blur": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "description": "Children of a `box`.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "$ref": "#/$defs/LayerItem"
          }
        },
        "clip": {
          "description": "`true` clips children to the layer box, or a clip shape.",
          "anyOf": [
            {
              "$ref": "#/$defs/Clip"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Paint"
            },
            {
              "type": "null"
            }
          ]
        },
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "d": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "enter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Preset"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Preset"
            },
            {
              "type": "null"
            }
          ]
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Paint"
            },
            {
              "type": "null"
            }
          ]
        },
        "fit": {
          "description": "`contain`, `cover`, `fill`, `none`.",
          "type": [
            "string",
            "null"
          ]
        },
        "font": {
          "type": [
            "string",
            "null"
          ]
        },
        "glow": {
          "anyOf": [
            {
              "$ref": "#/$defs/Glow"
            },
            {
              "type": "null"
            }
          ]
        },
        "headSize": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "height": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "innerRadius": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "italic": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "kinetic": {
          "description": "Kinetic text animation (TEXT module): shorthand like `\"pop by char from center 0.4s 30ms outBack\"`, or an object."
        },
        "layers": {
          "description": "Children of a `group`.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "$ref": "#/$defs/LayerItem"
          }
        },
        "letterSpacing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "lineHeight": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "loop": {
          "description": "Repeating motion: `float`, `pulse`, `spin`, `wiggle`, `breathe`, `blink`\n(for `video` layers, a bool: loop the clip).",
          "anyOf": [
            {
              "$ref": "#/$defs/LoopValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "mask": {
          "description": "A layer whose alpha masks this one.",
          "anyOf": [
            {
              "$ref": "#/$defs/Layer"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxLines": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "opacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "points": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Num"
            },
            "maxItems": 2,
            "minItems": 2
          }
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "props": true,
        "radius": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "reveal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "rotation": {
          "description": "Degrees, clockwise.",
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scale"
            },
            {
              "type": "null"
            }
          ]
        },
        "scaleX": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "scaleY": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/Shadow"
            },
            {
              "type": "null"
            }
          ]
        },
        "shape": {
          "description": "`rect`, `circle`, `ellipse`, `line`, `arrow`, `polygon`, `star`, `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "sides": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "skewX": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "skewY": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "speed": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "split": {
          "description": "`chars`, `words`, `lines`.",
          "type": [
            "string",
            "null"
          ]
        },
        "src": {
          "type": [
            "string",
            "null"
          ]
        },
        "stagger": {
          "description": "Delay children's animations by index × seconds (group, box, split text).",
          "anyOf": [
            {
              "$ref": "#/$defs/Stagger"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrokeSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "strokeWidth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/StyleRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "trimEnd": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "trimStart": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "description": "`text`, `shape`, `image`, `video`, `group`, `box`, `component`. Inferred when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "uppercase": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "volume": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "weight": {
          "anyOf": [
            {
              "$ref": "#/$defs/Weight"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "anyOf": [
            {
              "$ref": "#/$defs/Num"
            },
            {
              "type": "null"
            }
          ]
        },
        "x": {
          "anyOf": [
            {
