{ "size": [1920, 1080], "fps": 30, "scenes": [
  { "duration": 3, "layers": [ { "shader": "hero", "uniforms": { "shape": 0, "color": [0.92, 0.38, 0.2], "rough": 0.2 } } ] },
  { "duration": 3, "transition": { "type": "zoom-blur", "duration": 0.5 }, "layers": [ { "shader": "hero", "uniforms": { "shape": 1, "metal": 1, "rough": 0.06, "color": [0.95, 0.75, 0.4] } } ] },
  { "duration": 3, "transition": "luma-melt", "layers": [ { "shader": "light-shafts", "uniforms": { "angle": 30 } },
      { "text": "Morning", "style": "title", "color": "#f4e6d0" } ] },
  { "duration": 3, "transition": "ink-bleed", "layers": [ { "shader": "particles", "uniforms": { "focus": 0.05 }, "animate": [ { "to": { "focus": 0.95 }, "duration": 3 } ] } ] },
  { "duration": 3, "transition": "swirl", "layers": [
    { "shader": "void mainImage(out vec4 c, in vec2 p) { vec3 v = texture(iChannel0, p / iResolution.xy).rgb; c = vec4(pow(1.0 - exp(-v * 1.5), vec3(0.4545)), 1.0); }",
      "channels": ["A"], "buffers": { "A": { "src": "recipes/trail.glsl", "channels": ["A"] } } } ] }
] }
