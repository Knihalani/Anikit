    "EVENT_CALLBACK",
    "EVENT_COMPLETE",
    "EVENT_FINISH",
    "EVENT_REPEAT",
    "EVENT_REVERSE_COMPLETE",
    "EVENT_START",
    "Engine",
    "FLAG_AUTO_RELEASE",
    "FLAG_DEFAULT",
    "FLAG_FILL_BACKWARDS",
    "FLAG_FILL_FORWARDS",
    "FLAG_IMMEDIATE",
    "LINEAR",
    "NONE",
    "NativeEasing",
    "NativeMorph",
    "NativeMorphSeq",
    "NativeNoise",
    "NativePath",
    "STATE_FINISHED",
    "STATE_IDLE",
    "STATE_PAUSED",
    "STATE_PLAYING",
    "TRACK_COLOR",
    "TRACK_DISCRETE",
    "TRACK_NUMBER",
    "TRACK_PATH",
    "__version__",
    "color_mix",
    "color_parse",
    "color_space_id",
    "color_to_css",
    "color_to_hex",
    "color_try_parse",
    "ease",
    "easing_css",
    "morph_write",
    "spring_from_duration_bounce",
