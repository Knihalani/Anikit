    def at(self, t: float, decimals: int = 3) -> str: ...
    def write(self, values: Sequence[float], decimals: int = 3) -> str: ...

_Coord = Union[float, Sequence[float]]

@final
class NativeNoise:
    def __new__(cls, seed: int = 0) -> NativeNoise: ...
    @property
    def seed(self) -> int: ...
    def noise2(self, x: float, y: float) -> float: ...
    def noise3(self, x: float, y: float, z: float) -> float: ...
    def fbm2(self, x: float, y: float, octaves: int = 4, lacunarity: float = 2.0, gain: float = 0.5) -> float: ...
    def fbm3(
        self, x: float, y: float, z: float, octaves: int = 4, lacunarity: float = 2.0, gain: float = 0.5
    ) -> float: ...
    def noise2_many(self, x: _Coord, y: _Coord) -> List[float]: ...
    def noise3_many(self, x: _Coord, y: _Coord, z: _Coord) -> List[float]: ...
    def fbm2_many(
        self, x: _Coord, y: _Coord, octaves: int = 4, lacunarity: float = 2.0, gain: float = 0.5
    ) -> List[float]: ...
    def fbm3_many(
        self, x: _Coord, y: _Coord, z: _Coord, octaves: int = 4, lacunarity: float = 2.0, gain: float = 0.5
    ) -> List[float]: ...
    def grid(
        self,
        width: int,
        height: int,
        x0: float = 0.0,
        y0: float = 0.0,
        step: float = 0.1,
        z: Optional[float] = None,
        octaves: int = 1,
        lacunarity: float = 2.0,
        gain: float = 0.5,
    ) -> List[float]: ...

@final
class Engine:
    """Low-level engine (not thread-safe; use from the creating thread)."""

    def __new__(cls) -> Engine: ...
    # easings
    def easing(self, spec: str) -> int: ...
    def add_easing(self, e: NativeEasing) -> int: ...
    def ease(self, id: int, t: float) -> float: ...
    @property
    def easing_count(self) -> int: ...
    # creation
    def create_anim(
        self,
        tracks: Sequence[_TrackTuple],
        duration: float = 1000.0,
        delay: float = 0.0,
        iterations: float = 1.0,
        direction: int = 0,
        end_delay: float = 0.0,
        easing: int = ...,
        flags: int = ...,
    ) -> int: ...
    def create_group(
        self,
        duration: float = 0.0,
        delay: float = 0.0,
        iterations: float = 1.0,
        direction: int = 0,
        end_delay: float = 0.0,
        easing: int = ...,
        auto_duration: bool = True,
        flags: int = ...,
    ) -> int: ...
    def create_callback(self) -> int: ...
    def group_add(self, group: int, child: int, start: float) -> None: ...
    def group_remove(self, child: int) -> None: ...
    def create_spring(
        self,
        pos: Sequence[float],
        target: Sequence[float],
        vel: Optional[Sequence[float]] = None,
        stiffness: float = 100.0,
        damping: float = 10.0,
        mass: float = 1.0,
    ) -> int: ...
    def create_decay(
        self,
        pos: Sequence[float],
        vel: Sequence[float],
        power: float = 0.8,
        time_constant: float = 350.0,
        target: Optional[Sequence[float]] = None,
        min: Optional[Sequence[float]] = None,
        max: Optional[Sequence[float]] = None,
        bounce_stiffness: float = 500.0,
        bounce_damping: float = 40.0,
        bounce_mass: float = 1.0,
    ) -> int: ...
    def create_physics(
        self,
        pos: Sequence[float],
        vel: Sequence[float],
        acc: Optional[Sequence[float]] = None,
        friction: float = 0.0,
        min: Optional[Sequence[float]] = None,
        max: Optional[Sequence[float]] = None,
        restitution: float = 0.0,
        life: Optional[float] = None,
    ) -> int: ...
    def sim_set_acceleration(self, h: int, acc: Sequence[float]) -> None: ...
    # simulations
    def sim_set_target(self, h: int, target: Sequence[float]) -> None: ...
    def sim_set_position(self, h: int, pos: Sequence[float], vel: Optional[Sequence[float]] = None) -> None: ...
    def sim_set_params(self, h: int, stiffness: float = 100.0, damping: float = 10.0, mass: float = 1.0) -> None: ...
    def sim_set_rest(self, h: int, rest_delta: float, rest_speed: float) -> None: ...
    def sim_velocity(self, h: int) -> List[float]: ...
    def sim_target(self, h: int) -> List[float]: ...
    # playback
    def play(self, h: int) -> None: ...
    def pause(self, h: int) -> None: ...
    def seek(self, h: int, t: float) -> None: ...
    def set_progress(self, h: int, p: float) -> None: ...
    def set_rate(self, h: int, rate: float) -> None: ...
    def reverse(self, h: int) -> None: ...
    def restart(self, h: int) -> None: ...
    def set_timing(
        self,
        h: int,
        duration: Optional[float] = None,
        delay: Optional[float] = None,
        iterations: Optional[float] = None,
        direction: Optional[int] = None,
        end_delay: Optional[float] = None,
        easing: Optional[int] = None,
    ) -> None: ...
    def set_start(self, h: int, start: float) -> None: ...
    def set_track_enabled(self, h: int, track: int, enabled: bool) -> None: ...
    def release(self, h: int) -> None: ...
    def clear(self) -> None: ...
    # queries
    def values(self, h: int) -> List[float]: ...
    def track_offsets(self, h: int) -> List[int]: ...
    def time(self, h: int) -> float: ...
    def duration(self, h: int) -> float: ...
    def timing(self, h: int) -> Tuple[float, float, float, int, float, int]: ...
    def progress(self, h: int) -> float: ...
    def state(self, h: int) -> int: ...
    def iteration(self, h: int) -> float: ...
    def rate(self, h: int) -> float: ...
    def start(self, h: int) -> float: ...
    def parent(self, h: int) -> Optional[int]: ...
    def is_alive(self, h: int) -> bool: ...
    def sample(self, h: int, p: float) -> List[float]: ...
    def sample_many(self, h: int, ps: Sequence[float]) -> List[List[float]]: ...
    # frame
    def tick(self, dt: float) -> None: ...
    def updated(self) -> List[int]: ...
    def events(self) -> List[int]: ...
    def clear_frame(self) -> None: ...
    def drain(self) -> Tuple[List[int], List[List[float]], List[int]]: ...
    def step(self, dt: float) -> Tuple[List[int], List[List[float]], List[int]]: ...
    @property
    def active_count(self) -> int: ...
    @property
    def node_count(self) -> int: ...
    @property
    def now(self) -> float: ...
    global_rate: float
    def set_lag_smoothing(self, threshold: float, adjusted: float) -> None: ...

