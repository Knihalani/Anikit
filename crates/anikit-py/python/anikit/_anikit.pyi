STATE_IDLE: int
STATE_PLAYING: int
STATE_PAUSED: int
STATE_FINISHED: int

_RGBA = Tuple[float, float, float, float]

#: ``(kind, channels, values, offsets, easing_ids, color_space_id, path)``
_TrackTuple = Tuple[int, int, Sequence[float], Sequence[float], Sequence[int], int, Optional["NativePath"]]

@final
class NativeEasing:
    def __new__(cls, spec: str) -> NativeEasing: ...
    @staticmethod
    def table(values: Sequence[float]) -> NativeEasing: ...
    @staticmethod
    def points(stops: Sequence[Tuple[float, float]]) -> NativeEasing: ...
    @staticmethod
    def bezier(x1: float, y1: float, x2: float, y2: float) -> NativeEasing: ...
    @staticmethod
    def spring(
        stiffness: float = 100.0, damping: float = 10.0, mass: float = 1.0, velocity: float = 0.0
    ) -> NativeEasing: ...
    @staticmethod
    def from_path(d: str) -> NativeEasing: ...
    @staticmethod
    def rough(
        points: int = 20, strength: float = 1.0, seed: int = 1, template: Optional[NativeEasing] = None
    ) -> NativeEasing: ...
    @staticmethod
    def blend(a: NativeEasing, b: NativeEasing, weight: float = 0.5) -> NativeEasing: ...
    def reversed(self) -> NativeEasing: ...
    def mirrored(self) -> NativeEasing: ...
    def __call__(self, t: float) -> float: ...
    def ease(self, t: float) -> float: ...
    def ease_many(self, ts: Sequence[float]) -> List[float]: ...
    def sample(self, n: int) -> List[float]: ...
    def css(self, tolerance: float = 0.002) -> str: ...
    def linear_points(self, tolerance: float = 0.002) -> List[Tuple[float, float]]: ...
    @property
    def duration(self) -> Optional[float]: ...
    @property
    def kind(self) -> str: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class NativePath:
    def __new__(cls, d: str) -> NativePath: ...
    @staticmethod
    def rect(
        x: float, y: float, width: float, height: float, rx: float = 0.0, ry: Optional[float] = None
    ) -> NativePath: ...
    @staticmethod
    def ellipse(cx: float, cy: float, rx: float, ry: float) -> NativePath: ...
    @staticmethod
    def polygon(points: Sequence[float], closed: bool = True) -> NativePath: ...
    @staticmethod
    def star(cx: float, cy: float, points: int, outer: float, inner: float, rotation: float = 0.0) -> NativePath: ...
    @property
    def length(self) -> float: ...
    @property
    def bounds(self) -> Tuple[float, float, float, float]: ...
    @property
    def segment_count(self) -> int: ...
    @property
    def subpath_count(self) -> int: ...
    def point_at(self, t: float) -> Tuple[float, float, float]: ...
    def points_at(self, ts: Sequence[float]) -> List[Tuple[float, float, float]]: ...
    def to_svg(self, decimals: int = 3) -> str: ...
    def transformed(self, m: Sequence[float]) -> NativePath: ...
    def reversed(self) -> NativePath: ...
    def flatten(self, tolerance: float = 0.25) -> List[List[Tuple[float, float]]]: ...
    @property
    def area(self) -> float: ...
    def trim(self, start: float, end: float) -> NativePath: ...
    def simplify(self, tolerance: float = 1.0, smooth: bool = False) -> NativePath: ...
    @staticmethod
    def through(points: Sequence[float], curviness: float = 1.0, closed: bool = False) -> NativePath: ...
    def point_at_length(self, l: float) -> Tuple[float, float, float]: ...
    def closest(self, x: float, y: float) -> Tuple[float, float, float, float]: ...
    def sample_points(self, n: int) -> List[Tuple[float, float]]: ...
    def __eq__(self, value: object, /) -> bool: ...

@final
class NativeMorph:
    def __new__(cls, a: NativePath, b: NativePath) -> NativeMorph: ...
    @property
