"""Type stubs for the native ``anikit._anikit`` extension (low-level API).

Times are milliseconds, nodes are integer handles. Prefer the high-level
``anikit`` package (seconds, Python targets) unless you need raw access.
"""

from typing import List, Optional, Sequence, Tuple, Union, final

