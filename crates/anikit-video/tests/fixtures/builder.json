{
  "size": "9:16",
  "fps": 30,
  "theme": { "colors": { "primary": "#7c5cff" } },
  "transition": { "type": "crossfade", "duration": 0.4 },
  "markers": { "drop": 2 },
  "scenes": [
    {
      "duration": 2.5,
      "layers": [
        { "text": "Ship faster", "style": "title", "split": "words", "enter": { "preset": "fadeUp", "stagger": 0.08 } },
        { "type": "shape", "shape": "circle", "width": 200, "height": 200, "fill": "$primary", "loop": "float", "enter": "popIn" }
      ]
    },
    {
      "duration": 3,
      "transition": { "type": "push", "direction": "left" },
      "camera": { "animate": [ { "to": { "zoom": 1.05 }, "duration": 3, "ease": "inOutSine" } ] },
      "layers": [
        {
          "type": "box", "style": { "direction": "row", "gap": 24 }, "stagger": 0.1,
          "children": [
            { "text": "Fast", "style": "heading", "enter": "fadeUp" },
            { "text": "Native", "style": "heading", "enter": "fadeUp" }
          ]
        },
        { "type": "image", "src": "shot.png", "fit": "cover", "width": "80%", "y": "70%" },
        { "type": "component", "component": "barChart", "props": { "values": [3, 5, 8] }, "enter": "fadeIn" }
      ]
    }
  ],
  "audio": [ { "src": "music.mp3", "volume": 0.8, "fadeOut": 1 } ]
}
