{
  "name": "countdown",
  "title": "Event countdown",
  "description": "An event countdown: kicker badge, event, date and place beside a spinning globe with live arcs; a big N…1 countdown with glowing rings that draw each second and a spark burst at zero; then a particle-text 'Live now' with confetti, or a save-the-date card.",
  "duration": "8–18 s",
  "tags": [
    "event",
    "countdown",
    "launch day",
    "livestream",
    "webinar"
  ],
  "params": {
    "event": {
      "type": "string",
      "required": true,
      "maxWords": 6,
      "description": "Event name.",
      "example": "Launch Week Day 1"
    },
    "kicker": {
      "type": "string",
      "default": "Coming up",
      "maxWords": 3,
      "description": "Small label above the event name.",
      "example": "Live stream"
    },
    "date": {
      "type": "string",
      "maxChars": 32,
      "description": "Date and time as it should read, e.g. 'Thu 12 Dec · 17:00 UTC'.",
      "example": "Thu 12 Dec · 17:00 UTC"
    },
    "location": {
      "type": "string",
      "maxChars": 40,
      "description": "Venue or where to watch.",
      "example": "youtube.com/@anikit"
    },
    "from": {
      "type": "integer",
      "default": 5,
      "minimum": 3,
      "maximum": 10,
      "description": "Number to count down from (one second each).",
      "example": 5
    },
    "live": {
      "type": "boolean",
      "default": true,
      "description": "true: end on 'Live now' (for the start of a stream). false: end on a save-the-date card.",
      "example": true
    },
    "liveText": {
      "type": "string",
      "default": "Live now",
      "maxWords": 3,
      "description": "End card headline when live is true.",
      "example": "We're live"
    },
    "cta": {
      "type": "string",
      "maxWords": 4,
      "description": "Optional button on the end card.",
      "example": "Join the stream"
    },
    "music": {
      "type": "string",
      "description": "Optional music; a track with a clear downbeat makes each number land."
    }
  },
  "spec": {
    "size": [
      "{{fmt.w}}",
      "{{fmt.h}}"
    ],
    "fps": "{{fmt.fps}}",
    "theme": {
      "$use": "theme"
    },
    "background": "$bgDeep",
    "transition": {
      "type": "crossfade",
      "duration": 0.5
    },
    "scenes": [
      {
        "id": "intro",
        "duration": "{{max(2.6, readtime(kicker + ' ' + event + ' ' + (date ?? '') + ' ' + (location ?? '')) + 1.0)}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 4,
              "floor": true,
              "intensity": 0.32
            }
          },
          {
            "type": "component",
            "component": "globe",
            "props": {
              "arcs": [
                [
                  37.8,
                  -122.4,
                  51.5,
                  -0.1
                ],
                [
                  51.5,
                  -0.1,
                  35.7,
                  139.7
                ],
                [
                  40.7,
                  -74.0,
                  -33.9,
                  151.2
                ],
                [
                  1.35,
                  103.8,
                  48.9,
                  2.35
                ]
              ],
              "color": "{{brand.colors.primary}}"
            },
            "x": "{{fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.2 : fmt.cx}}",
            "y": "{{fmt.landscape ? '50%' : (fmt.portrait ? '64%' : '70%')}}",
            "width": "{{fmt.landscape ? fmt.w * 0.42 : fmt.safe.w}}",
            "height": "{{fmt.landscape ? fmt.h * 0.8 : (fmt.portrait ? fmt.h * 0.42 : fmt.h * 0.5)}}",
            "enter": {
              "preset": "fadeIn",
              "duration": 0.8
            }
          },
          {
            "$let": {
              "tw": "(fmt.landscape ? fmt.w * 0.46 : fmt.safe.w)",
              "ts": "(fmt.portrait ? fmt.u * 8.6 : fmt.u * 9.5)",
              "lines": "ceil(len(event) * 0.52 * (fmt.portrait ? fmt.u * 8.6 : fmt.u * 9.5) / (fmt.landscape ? fmt.w * 0.46 : fmt.safe.w))",
              "top": "(fmt.landscape ? fmt.h * 0.46 - (ceil(len(event) * 0.52 * (fmt.portrait ? fmt.u * 8.6 : fmt.u * 9.5) / (fmt.landscape ? fmt.w * 0.46 : fmt.safe.w)) * (fmt.portrait ? fmt.u * 8.6 : fmt.u * 9.5) * 1.1 + fmt.u * 12) / 2 : (fmt.portrait ? fmt.h * 0.14 : fmt.h * 0.1))",
              "ax": "fmt.landscape ? fmt.safe.left : fmt.cx",
              "an": "fmt.landscape ? 'topLeft' : 'top'",
              "al": "fmt.landscape ? 'left' : 'center'"
            },
            "in": [
              {
                "type": "component",
                "component": "badge",
                "props": {
                  "label": "{{upper(kicker)}}",
                  "dot": true,
                  "size": "{{fmt.u * 2.2}}",
                  "align": "{{fmt.landscape ? 0 : 0.5}}"
                },
                "x": "{{ax}}",
                "y": "{{top}}",
                "anchor": "{{fmt.landscape ? 'topLeft' : 'top'}}",
                "width": "{{fmt.u * 40}}",
                "height": "{{fmt.u * 5}}",
                "enter": "fadeIn"
              },
              {
                "text": "{{event}}",
                "style": "title",
                "weight": 750,
                "width": "{{tw}}",
                "align": "{{al}}",
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top + fmt.u * 4.5}}",
                "enter": "mask by word up",
                "size": "{{fmt.portrait ? '8.6vmin' : '9.5vmin'}}"
              }
            ]
          },
          {
            "$let": {
              "ts2": "(fmt.portrait ? fmt.u * 8.6 : fmt.u * 9.5)",
              "tw2": "(fmt.landscape ? fmt.w * 0.46 : fmt.safe.w)"
            },
            "in": {
              "$let": {
                "ln": "ceil(len(event) * 0.52 * ts2 / tw2)",
                "base": "(fmt.landscape ? fmt.h * 0.46 - (ceil(len(event) * 0.52 * ts2 / tw2) * ts2 * 1.1 + fmt.u * 12) / 2 : (fmt.portrait ? fmt.h * 0.14 : fmt.h * 0.1)) + fmt.u * 4.5"
              },
              "in": [
                {
                  "$if": "date",
                  "then": {
                    "id": "date",
                    "text": "{{date}}",
                    "style": "subtitle",
                    "color": "$text",
                    "x": "{{fmt.landscape ? fmt.safe.left : fmt.cx}}",
                    "anchor": "{{fmt.landscape ? 'topLeft' : 'top'}}",
                    "y": "{{base + ln * ts2 * 1.1 + fmt.u * 2.5}}",
                    "enter": {
                      "preset": "fadeUp",
                      "delay": 0.45
                    }
                  }
                },
                {
                  "$if": "location",
                  "then": {
                    "id": "location",
                    "text": "{{location}}",
                    "style": "caption",
                    "x": "{{fmt.landscape ? fmt.safe.left : fmt.cx}}",
                    "anchor": "{{fmt.landscape ? 'topLeft' : 'top'}}",
                    "y": "{{base + ln * ts2 * 1.1 + fmt.u * 8.5}}",
                    "enter": {
                      "preset": "fadeUp",
                      "delay": 0.6
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "countdown",
        "transition": {
          "type": "zoom",
          "duration": 0.5
        },
        "duration": "{{from + 0.15}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 9,
              "intensity": 0.2
            }
          },
          {
            "id": "track",
            "shape": "circle",
            "width": "{{fmt.u * 56}}",
            "height": "{{fmt.u * 56}}",
            "fill": "none",
            "stroke": {
              "color": "$border",
              "width": "{{fmt.u * 0.9}}"
            },
            "enter": "fadeIn"
          },
          {
            "$each": "range(from)",
            "as": "k",
            "index": "i",
            "do": [
              {
                "id": "ring-{{from - i}}",
                "shape": "circle",
                "width": "{{fmt.u * 56}}",
                "height": "{{fmt.u * 56}}",
                "rotation": -90,
                "fill": "none",
                "stroke": {
                  "color": "$accent",
                  "width": "{{fmt.u * 0.9}}",
                  "cap": "round"
                },
                "glow": {
                  "radius": "{{fmt.u * 2}}",
                  "intensity": 0.8,
                  "color": "$accent"
                },
                "start": "{{i}}",
                "duration": 1,
                "animate": [
                  {
                    "from": {
                      "trimEnd": 0
                    },
                    "duration": 1,
                    "ease": "linear"
                  }
                ]
              },
              {
                "id": "n-{{from - i}}",
                "text": "{{str(from - i)}}",
                "style": "stat",
                "size": "{{fmt.portrait ? '30vmin' : '28vmin'}}",
                "start": "{{i}}",
                "duration": 1,
                "enter": {
                  "preset": "popIn",
                  "duration": 0.4
                },
                "exit": {
                  "preset": "fadeOut",
                  "duration": 0.15
                }
              }
            ]
          },
          {
            "id": "event-small",
            "text": "{{event}}",
            "style": "label",
            "y": "{{fmt.portrait ? '72%' : '88%'}}",
            "enter": {
              "preset": "fadeIn",
              "delay": 0.2
            }
          },
          {
            "type": "component",
            "component": "sparks",
            "props": {
              "bursts": [
                "{{from - 0.05}}"
              ],
              "origin": [
                0.5,
                0.5
              ],
              "count": 120,
              "colors": [
                "{{brand.colors.accent}}",
                "{{brand.colors.primary}}"
              ],
              "power": 1.2,
              "seed": 9
            }
          }
        ]
      },
      {
        "id": "end",
        "transition": {
          "type": "{{live ? 'zoom' : 'blur'}}",
          "duration": 0.45
        },
        "duration": "{{max(3.2, readtime((live ? liveText : event) + ' ' + (date ?? '') + ' ' + (cta ?? '')) + 1)}}",
        "camera": {
          "animate": [
            {
              "from": {
                "zoom": 1.08
              },
              "to": {
                "zoom": 1
              },
              "duration": 1.2,
              "ease": "outExpo"
            }
          ]
        },
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 31,
              "floor": true,
              "intensity": 0.22
            }
          },
          {
            "$if": "live",
            "then": [
              {
                "$if": "brand.theme == 'light'",
                "then": {
                  "text": "{{liveText}}",
                  "style": "hero",
                  "y": "{{fmt.portrait ? '46%' : '46%'}}",
                  "width": "{{fmt.safe.w}}",
                  "enter": "pop by char from center"
                },
                "else": {
                  "type": "component",
                  "component": "particle-text",
                  "props": {
                    "text": "{{liveText}}",
                    "exit": "none",
                    "form": 1.0,
                    "size": 2.4,
                    "glow": "{{brand.theme != 'light'}}",
                    "count": 14000,
                    "colors": [
                      "{{brand.colors.text}}",
                      "{{brand.colors.secondary}}"
                    ]
                  },
                  "y": "{{fmt.portrait ? '46%' : '46%'}}",
                  "width": "{{fmt.safe.w}}",
                  "height": "{{fmt.u * 34}}"
                }
              },
              {
                "type": "component",
                "component": "badge",
                "props": {
                  "label": "LIVE",
                  "dot": true,
                  "solid": true,
                  "color": "#FF3B30",
                  "size": "{{fmt.u * 2.8}}"
                },
                "y": "{{fmt.portrait ? '33%' : '26%'}}",
                "width": "{{fmt.u * 30}}",
                "height": "{{fmt.u * 6}}"
              },
              {
                "$if": "cta",
                "then": {
                  "$use": "ctaButton",
                  "with": {
                    "label": "{{cta}}",
                    "y": "{{fmt.portrait ? '60%' : '68%'}}",
                    "press": 1.6
                  }
                }
              },
              {
                "$use": "confetti",
                "with": {
                  "at": 0.3,
                  "oy": 0.45,
                  "count": 160
                }
              }
            ],
            "else": [
              {
                "$use": "kicker",
                "with": {
                  "text": "Save the date"
                },
                "y": "{{fmt.portrait ? '30%' : '26%'}}"
              },
              {
                "id": "event",
                "text": "{{event}}",
                "style": "title",
                "y": "{{fmt.portrait ? '40%' : '40%'}}",
                "width": "{{fmt.portrait ? fmt.safe.w : fmt.w * 0.78}}",
                "size": "{{fmt.portrait ? '8.6vmin' : '9.5vmin'}}",
                "enter": "mask by word up"
              },
              {
                "$if": "date",
                "then": {
                  "text": "{{date}}",
                  "style": "heading",
                  "color": "$accent",
                  "y": "{{fmt.portrait ? '50%' : '54%'}}",
                  "enter": "scramble"
                }
              },
              {
                "$if": "cta",
                "then": {
                  "$use": "ctaButton",
                  "with": {
                    "label": "{{cta}}",
                    "y": "{{fmt.portrait ? '60%' : '68%'}}",
                    "press": 1.6
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "audio": {
      "$use": "music"
    }
  }
}