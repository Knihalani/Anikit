{
  "name": "data-story",
  "title": "Data story",
  "description": "A 15–30 s data narrative on a living brand mesh: a kinetic headline over a rising area chart, 1–3 animated bar charts beside their conclusions (the key bar highlighted), a big counting stat, and a takeaway with a sparkline stat tile and its source.",
  "duration": "15–30 s",
  "tags": [
    "data",
    "charts",
    "stats",
    "report",
    "numbers",
    "infographic"
  ],
  "params": {
    "kicker": {
      "type": "string",
      "maxWords": 4,
      "description": "Small label above the headline: the dataset or period.",
      "example": "2026 in numbers"
    },
    "headline": {
      "type": "string",
      "required": true,
      "maxWords": 8,
      "description": "The finding, stated as news: 'Support tickets fell by half'.",
      "example": "Support tickets fell by half this year"
    },
    "charts": {
      "type": "array",
      "required": true,
      "minItems": 1,
      "maxItems": 3,
      "description": "1–3 bar charts, each making one point.",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "required": true,
            "maxWords": 7,
            "description": "What the chart shows, ideally its conclusion."
          },
          "prefix": {
            "type": "string",
            "maxChars": 3,
            "description": "Before each value, e.g. '$'."
          },
          "suffix": {
            "type": "string",
            "maxChars": 5,
            "description": "After each value, e.g. '%' or ' fps'."
          },
          "highlight": {
            "type": "integer",
            "minimum": 0,
            "description": "Index of the bar to highlight. Default: the largest."
          },
          "bars": {
            "type": "array",
            "required": true,
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "required": true,
                  "maxChars": 12,
                  "description": "Short category label."
                },
                "value": {
                  "type": "number",
                  "required": true,
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "example": [
        {
          "title": "Frames per second at 1080p",
          "suffix": "",
          "bars": [
            {
              "label": "Browser",
              "value": 24
            },
            {
              "label": "Canvas",
              "value": 61
            },
            {
              "label": "Anikit",
              "value": 250
            }
          ]
        }
      ]
    },
    "stat": {
      "type": "object",
      "description": "Optional big number after the charts.",
      "properties": {
        "value": {
          "type": "number",
          "required": true
        },
        "prefix": {
          "type": "string",
          "maxChars": 3
        },
        "suffix": {
          "type": "string",
          "maxChars": 5
        },
        "label": {
          "type": "string",
          "required": true,
          "maxWords": 8
        }
      },
      "example": {
        "value": 10,
        "suffix": "×",
        "label": "faster than a headless browser"
      }
    },
    "takeaway": {
      "type": "string",
      "required": true,
      "maxWords": 12,
      "description": "The one sentence to remember.",
      "example": "No browser in the loop means minutes become seconds."
    },
    "source": {
      "type": "string",
      "maxChars": 60,
      "description": "Data source, shown small on the last scene.",
      "example": "Source: internal benchmarks, 4-core laptop"
    },
    "music": {
      "type": "string",
      "description": "Optional music file (MP3/WAV)."
    }
  },
  "spec": {
    "size": [
      "{{fmt.w}}",
      "{{fmt.h}}"
    ],
    "fps": "{{fmt.fps}}",
    "theme": {
      "$use": "theme"
    },
    "background": "$bgDeep",
    "transition": {
      "type": "crossfade",
      "duration": 0.5
    },
    "scenes": [
      {
        "id": "headline",
        "duration": "{{readtime(headline + ' ' + (kicker ?? '')) + 2.0 + 0.08 * words(headline)}}",
        "camera": {
          "animate": [
            {
              "from": {
                "zoom": 1.05
              },
              "to": {
                "zoom": 1
              },
              "duration": 3,
              "ease": "outCubic"
            }
          ]
        },
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 8,
              "floor": true,
              "intensity": 0.34
            }
          },
          {
            "$let": {
              "vx": "fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.25 : fmt.cx",
              "vy": "fmt.landscape ? fmt.h * 0.5 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.66)",
              "vw": "fmt.landscape ? fmt.w * 0.5 : (fmt.portrait ? fmt.safe.w : fmt.w * 0.7)",
              "vh": "fmt.landscape ? fmt.h * 0.56 : fmt.h * 0.4"
            },
            "in": {
              "type": "component",
              "component": "area-chart",
              "props": {
                "series": [
                  "{{pick(charts[0].bars, 'value')}}"
                ],
                "grid": false,
                "endLabel": false,
                "delay": 0.3,
                "duration": 1.8,
                "width": "{{fmt.u * 0.6}}"
              },
              "x": "{{vx}}",
              "y": "{{vy}}",
              "width": "{{vw}}",
              "height": "{{vh}}",
              "opacity": 0.9
            }
          },
          {
            "$let": {
              "tw": "fmt.landscape ? fmt.w * 0.38 : fmt.safe.w",
              "ts": "fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5",
              "lines": "ceil(len(headline) * 0.48 * (fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5) / (fmt.landscape ? fmt.w * 0.38 : fmt.safe.w))",
              "top": "fmt.landscape ? fmt.h * 0.5 - (ceil(len(headline) * 0.48 * (fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5) / (fmt.landscape ? fmt.w * 0.38 : fmt.safe.w)) * (fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5) * 1.1 + fmt.u * 6) / 2 : (fmt.portrait ? fmt.h * 0.14 : fmt.h * 0.1)",
              "ax": "fmt.landscape ? fmt.safe.left : fmt.cx",
              "an": "fmt.landscape ? 'topLeft' : 'top'",
              "al": "fmt.landscape ? 'left' : 'center'"
            },
            "in": [
              {
                "text": "{{kicker ?? ''}}",
                "style": "label",
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top}}",
                "enter": "fadeUp"
              },
              {
                "text": "{{headline}}",
                "style": "title",
                "weight": 750,
                "width": "{{tw}}",
                "align": "{{al}}",
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top + fmt.u * 4.5}}",
                "enter": "mask by word up"
              }
            ]
          },
          {
            "$use": "grain"
          }
        ]
      },
      {
        "$each": "charts",
        "as": "c",
        "index": "i",
        "do": {
          "id": "chart-{{i + 1}}",
          "transition": {
            "type": "push",
            "direction": "{{fmt.portrait ? 'up' : 'left'}}",
            "duration": 0.6,
            "ease": "inOutQuart"
          },
          "duration": "{{readtime(c.title) + 1.4 + 0.12 * len(c.bars) + 1.2}}",
          "layers": [
            {
              "$use": "backdrop",
              "with": {
                "seed": "{{15 + i * 4}}",
                "intensity": 0.3
              }
            },
            {
              "$let": {
                "tw": "fmt.landscape ? fmt.w * 0.38 : fmt.safe.w",
                "ts": "fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4",
                "lines": "ceil(len(c.title) * 0.48 * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) / (fmt.landscape ? fmt.w * 0.38 : fmt.safe.w))",
                "top": "fmt.landscape ? fmt.h * 0.5 - (ceil(len(c.title) * 0.48 * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) / (fmt.landscape ? fmt.w * 0.38 : fmt.safe.w)) * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) * 1.1 + fmt.u * 6) / 2 : (fmt.portrait ? fmt.h * 0.14 : fmt.h * 0.1)",
                "ax": "fmt.landscape ? fmt.safe.left : fmt.cx",
                "an": "fmt.landscape ? 'topLeft' : 'top'",
                "al": "fmt.landscape ? 'left' : 'center'"
              },
              "in": [
                {
                  "text": "{{kicker ?? ''}}",
                  "style": "label",
                  "x": "{{ax}}",
                  "anchor": "{{an}}",
                  "y": "{{top}}",
                  "enter": "fadeUp"
                },
                {
                  "text": "{{c.title}}",
                  "style": "heading",
                  "weight": 750,
                  "width": "{{tw}}",
                  "align": "{{al}}",
                  "x": "{{ax}}",
                  "anchor": "{{an}}",
                  "y": "{{top + fmt.u * 4.5}}",
                  "enter": "mask by word up"
                }
              ]
            },
            {
              "$let": {
                "vx": "fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.25 : fmt.cx",
                "vy": "fmt.landscape ? fmt.h * 0.5 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.66)",
                "vw": "fmt.landscape ? fmt.w * 0.5 : (fmt.portrait ? fmt.safe.w : fmt.w * 0.7)",
                "vh": "fmt.landscape ? fmt.h * 0.56 : fmt.h * 0.4"
              },
              "in": {
                "type": "component",
                "component": "bar-chart",
                "props": {
                  "values": "{{pick(c.bars, 'value')}}",
                  "labels": "{{pick(c.bars, 'label')}}",
                  "highlight": "{{c.highlight ?? argmax(pick(c.bars, 'value'))}}",
                  "colors": [
                    "{{brand.colors.primary}}"
                  ],
                  "format": {
                    "prefix": "{{c.prefix ?? ''}}",
                    "suffix": "{{c.suffix ?? ''}}"
                  },
                  "fontSize": "{{fmt.portrait ? fmt.u * 3.2 : fmt.u * 2.4}}",
                  "delay": 0.4,
                  "stagger": 0.12
                },
                "x": "{{vx}}",
                "y": "{{vy}}",
                "width": "{{vw}}",
                "height": "{{vh}}"
              }
            },
            {
              "$use": "grain"
            }
          ]
        }
      },
      {
        "$if": "stat",
        "then": {
          "id": "stat",
          "transition": {
            "type": "blur",
            "duration": 0.5
          },
          "duration": "{{readtime(stat.label) + 2.4}}",
          "layers": [
            {
              "$use": "backdrop",
              "with": {
                "seed": 23,
                "intensity": 0.42
              }
            },
            {
              "type": "component",
              "component": "counter",
              "props": {
                "to": "{{stat.value}}",
                "prefix": "{{stat.prefix ?? ''}}",
                "suffix": "{{stat.suffix ?? ''}}",
                "size": "{{fmt.portrait ? fmt.u * 26 : fmt.u * 24}}",
                "weight": 800,
                "gradient": [
                  "{{brand.colors.text}}",
                  "{{mix(brand.colors.text, brand.colors.primary, 0.55)}}"
                ],
                "duration": 1.6
              },
              "y": "42%",
              "width": "{{fmt.safe.w}}",
              "height": "{{fmt.u * 32}}"
            },
            {
              "text": "{{stat.label}}",
              "style": "subtitle",
              "y": "{{fmt.portrait ? '56%' : '62%'}}",
              "width": "{{fmt.safe.w}}",
              "enter": {
                "preset": "fadeUp",
                "delay": 0.8
              }
            },
            {
              "type": "component",
              "component": "area-chart",
              "props": {
                "series": [
                  [
                    2,
                    3,
                    3,
                    5,
                    4,
                    7,
                    9,
                    14
                  ]
                ],
                "grid": false,
                "endLabel": false,
                "delay": 0.4,
                "duration": 1.6
              },
              "y": "{{fmt.portrait ? '72%' : '82%'}}",
              "width": "{{fmt.safe.w}}",
              "height": "{{fmt.u * 16}}",
              "opacity": 0.55
            },
            {
              "$use": "grain"
            }
          ]
        }
      },
      {
        "id": "takeaway",
        "transition": {
          "type": "crossfade",
          "duration": 0.5
        },
        "duration": "{{max(3.5, readtime(takeaway + ' ' + (source ?? '')) + 1.2)}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 27,
              "floor": true,
              "intensity": 0.36
            }
          },
          {
            "$let": {
              "tw": "fmt.landscape ? fmt.w * 0.38 : fmt.safe.w",
              "ts": "fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4",
              "lines": "ceil(len(takeaway) * 0.48 * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) / (fmt.landscape ? fmt.w * 0.38 : fmt.safe.w))",
              "top": "fmt.landscape ? fmt.h * 0.5 - (ceil(len(takeaway) * 0.48 * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) / (fmt.landscape ? fmt.w * 0.38 : fmt.safe.w)) * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) * 1.1 + fmt.u * 6) / 2 : (fmt.portrait ? fmt.h * 0.14 : fmt.h * 0.1)",
              "ax": "fmt.landscape ? fmt.safe.left : fmt.cx",
              "an": "fmt.landscape ? 'topLeft' : 'top'",
              "al": "fmt.landscape ? 'left' : 'center'"
            },
            "in": [
              {
                "text": "{{takeaway}}",
                "style": "heading",
                "weight": 750,
                "width": "{{tw}}",
                "align": "{{al}}",
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top + fmt.u * 4.5}}",
                "enter": "mask by word up"
              }
            ]
          },
          {
            "$let": {
              "vx": "fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.25 : fmt.cx",
              "vy": "fmt.landscape ? fmt.h * 0.5 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.66)",
              "vw": "fmt.landscape ? fmt.w * 0.5 : (fmt.portrait ? fmt.safe.w : fmt.w * 0.7)",
              "vh": "fmt.landscape ? fmt.h * 0.56 : fmt.h * 0.4"
            },
            "in": {
              "type": "component",
              "component": "stat",
              "props": {
                "label": "{{charts[0].title}}",
                "value": "{{max(pick(charts[0].bars, 'value'))}}",
                "prefix": "{{charts[0].prefix ?? ''}}",
                "suffix": "{{charts[0].suffix ?? ''}}",
                "spark": "{{pick(charts[0].bars, 'value')}}",
                "delay": 0.4
              },
              "x": "{{vx}}",
              "y": "{{vy}}",
              "width": "{{fmt.landscape ? fmt.w * 0.36 : fmt.safe.w * 0.9}}",
              "height": "{{fmt.u * 26}}"
            }
          },
          {
            "$if": "source",
            "then": {
              "text": "{{source}}",
              "style": "caption",
              "y": "{{fmt.portrait ? '79%' : '88%'}}",
              "width": "{{fmt.safe.w}}",
              "enter": {
                "preset": "fadeIn",
                "delay": 0.8
              }
            }
          },
          {
            "$use": "grain"
          }
        ]
      }
    ],
    "audio": {
      "$use": "music"
    }
  }
}