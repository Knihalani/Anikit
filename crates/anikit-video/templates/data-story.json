{
  "name": "data-story",
  "title": "Data story",
  "description": "A 15–30 s data narrative: a headline hook, 1–3 bar charts that grow in with counting value labels (the key bar highlighted), an optional big counter stat and a one-line takeaway with its source.",
  "duration": "15–30 s",
  "tags": ["data", "charts", "stats", "report", "numbers", "infographic"],
  "params": {
    "kicker": { "type": "string", "maxWords": 4, "description": "Small label above the headline: the dataset or period.", "example": "2026 in numbers" },
    "headline": { "type": "string", "required": true, "maxWords": 8, "description": "The finding, stated as news: 'Renders got 10× faster'.", "example": "Rendering got 10× faster this year" },
    "charts": {
      "type": "array", "required": true, "minItems": 1, "maxItems": 3,
      "description": "1–3 bar charts, each making one point.",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "required": true, "maxWords": 7, "description": "What the chart shows, ideally its conclusion." },
          "prefix": { "type": "string", "maxChars": 3, "description": "Before each value, e.g. '$'." },
          "suffix": { "type": "string", "maxChars": 5, "description": "After each value, e.g. '%' or ' fps'." },
          "highlight": { "type": "integer", "minimum": 0, "description": "Index of the bar to highlight. Default: the largest." },
          "bars": {
            "type": "array", "required": true, "minItems": 2, "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "required": true, "maxChars": 12, "description": "Short category label." },
                "value": { "type": "number", "required": true, "minimum": 0 }
              }
            }
          }
        }
      },
      "example": [
        { "title": "Frames per second at 1080p", "suffix": "", "bars": [ { "label": "Browser", "value": 24 }, { "label": "Canvas", "value": 61 }, { "label": "Anikit", "value": 250 } ] }
      ]
    },
    "stat": {
      "type": "object", "description": "Optional big number after the charts.",
      "properties": {
        "value": { "type": "number", "required": true },
        "prefix": { "type": "string", "maxChars": 3 },
        "suffix": { "type": "string", "maxChars": 5 },
        "label": { "type": "string", "required": true, "maxWords": 8 }
      },
      "example": { "value": 10, "suffix": "×", "label": "faster than a headless browser" }
    },
    "takeaway": { "type": "string", "required": true, "maxWords": 12, "description": "The one sentence to remember.", "example": "No browser in the loop means minutes become seconds." },
    "source": { "type": "string", "maxChars": 60, "description": "Data source, shown small on the last scene.", "example": "Source: internal benchmarks, 4-core laptop" },
    "music": { "type": "string", "description": "Optional music file (MP3/WAV)." }
  },
  "spec": {
    "size": ["{{fmt.w}}", "{{fmt.h}}"],
    "fps": "{{fmt.fps}}",
    "theme": { "$use": "theme" },
    "background": "radial-gradient(circle at 50% 30%, $bg, $bgDeep)",
    "transition": { "type": "crossfade", "duration": 0.5 },
    "scenes": [
      {
        "id": "headline",
        "duration": "{{max(2.6, readtime((kicker ?? '') + ' ' + headline) + 0.6)}}",
        "camera": { "animate": [ { "from": { "zoom": 1.05 }, "to": { "zoom": 1 }, "duration": 3, "ease": "outCubic" } ] },
        "layers": [
          { "$use": "glows", "with": { "strength": 0.8 } },
          { "$if": "kicker", "then": { "$use": "kicker", "with": { "text": "{{kicker}}" }, "y": "37%" } },
          { "id": "headline", "text": "{{headline}}", "style": "title", "y": "{{kicker ? '50%' : '48%'}}", "width": "{{fmt.safe.w}}", "split": "words", "enter": { "preset": "fadeUp", "stagger": 0.07, "delay": 0.1, "duration": 0.7, "ease": "outExpo" } }
        ]
      },
      {
        "$each": "charts", "as": "c", "index": "ci",
        "do": {
          "$let": {
            "n": "len(c.bars)",
            "vals": "pick(c.bars, 'value')",
            "top": "max(vals)",
            "hi": "c.highlight ?? -1",
            "cw": "fmt.landscape ? fmt.w * 0.66 : fmt.safe.w",
            "base": "fmt.h * (fmt.landscape ? 0.8 : fmt.portrait ? 0.7 : 0.78)",
            "bh": "fmt.h * (fmt.landscape ? 0.44 : fmt.portrait ? 0.34 : 0.42)",
            "slot": "cw / n",
            "left": "fmt.w / 2 - cw / 2"
          },
          "in": {
            "id": "chart-{{ci + 1}}",
            "transition": { "type": "push", "direction": "{{fmt.portrait ? 'up' : 'left'}}", "duration": 0.6, "ease": "inOutQuart" },
            "duration": "{{readtime(c.title) + 1.4 + 0.1 * n + 1.2}}",
            "layers": [
              { "$use": "glows", "with": { "strength": 0.45, "gx": "50%", "gy": "90%" } },
              { "id": "chart-title", "text": "{{c.title}}", "style": "heading", "y": "{{fmt.safe.top + fmt.u * (fmt.portrait ? 6 : 5)}}", "width": "{{fmt.safe.w}}", "enter": { "preset": "fadeUp", "ease": "outExpo" } },
              {
                "id": "baseline", "type": "shape", "shape": "line", "x": "{{left}}", "y": "{{base}}", "anchor": "left", "width": "{{cw}}", "height": 2,
                "points": [[0, 0], ["{{cw}}", 0]], "stroke": { "color": "$border", "width": "{{max(2, fmt.u * 0.25)}}", "cap": "round" },
                "enter": { "preset": "drawOn", "delay": 0.15, "duration": 0.6 }
              },
              {
                "$each": "c.bars", "as": "b", "index": "j",
                "do": [ {
                  "$let": {
                    "h": "max(fmt.u * 0.8, b.value / (top > 0 ? top : 1) * bh)",
                    "bx": "left + slot * (j + 0.5)",
                    "key": "hi >= 0 ? j == hi : b.value == top",
                    "t0": "0.35 + j * 0.1"
                  },
                  "in": [
                    {
                      "id": "bar-{{j + 1}}", "type": "shape", "shape": "rect", "anchor": "bottom", "x": "{{bx}}", "y": "{{base}}",
                      "width": "{{min(slot * 0.58, fmt.u * 16)}}", "height": "{{h}}", "radius": "{{min(slot * 0.1, fmt.u * 1.4)}}",
                      "fill": "{{key ? 'linear-gradient(180deg, ' + brand.colors.secondary + ', ' + brand.colors.primary + ')' : alpha(brand.colors.text, 0.16)}}",
                      "glow": { "$if": "key", "then": { "radius": "{{fmt.u * 3}}", "intensity": 0.6, "color": "$primary" } },
                      "animate": [ { "from": { "scaleY": 0 }, "at": "{{t0}}", "duration": 0.9, "ease": "outExpo" } ]
                    },
                    {
                      "id": "value-{{j + 1}}", "anchor": "bottom", "x": "{{bx}}", "y": "{{base - h - fmt.u * 1.6}}",
                      "text": "{{(c.prefix ?? '') + (b.value % 1 ? '{value:0.0}' : '{value:,}') + (c.suffix ?? '')}}", "value": "{{b.value}}",
                      "style": "{{key ? 'heading' : 'body'}}", "weight": 700, "color": "{{key ? '$text' : '$muted'}}",
                      "size": "{{key ? (fmt.portrait ? '5.4vmin' : '4.6vmin') : (fmt.portrait ? '3.8vmin' : '3vmin')}}",
                      "enter": { "preset": "countUp", "delay": "{{t0}}", "duration": 0.9 },
                      "animate": [ { "from": { "opacity": 0, "y": "{{base - fmt.u * 1.6}}" }, "at": "{{t0}}", "duration": 0.9, "ease": "outExpo" } ]
                    },
                    {
                      "id": "label-{{j + 1}}", "anchor": "top", "x": "{{bx}}", "y": "{{base + fmt.u * 2}}", "width": "{{slot * 0.95}}",
                      "text": "{{b.label}}", "style": "caption", "color": "{{key ? '$text' : '$muted'}}",
                      "enter": { "preset": "fadeIn", "delay": "{{t0}}" }
                    }
                  ]
                } ]
              }
            ]
          }
        }
      },
      {
        "$if": "stat",
        "then": {
          "id": "stat",
          "transition": { "type": "blur", "duration": 0.5 },
          "duration": "{{readtime(stat.label) + 2.2}}",
          "layers": [
            { "$use": "glows", "with": { "gx": "50%", "gy": "40%", "strength": 0.9 } },
            { "id": "number", "text": "{{(stat.prefix ?? '') + (stat.value % 1 ? '{value:0.0}' : '{value:,}') + (stat.suffix ?? '')}}", "value": "{{stat.value}}", "style": "stat", "y": "44%", "enter": { "preset": "countUp", "duration": 1.6 }, "animate": [ { "from": { "scale": 0.92 }, "duration": 1.6, "ease": "outExpo" } ] },
            { "id": "stat-label", "text": "{{stat.label}}", "style": "subtitle", "y": "{{fmt.portrait ? '58%' : '62%'}}", "width": "{{fmt.safe.w}}", "enter": { "preset": "fadeUp", "delay": 0.8 } }
          ]
        }
      },
      {
        "id": "takeaway",
        "transition": { "type": "blur", "duration": 0.6 },
        "duration": "{{max(3.2, readtime(takeaway) + 1.4)}}",
        "layers": [
          { "$use": "glows", "with": { "gx": "30%", "gy": "20%", "hx": "70%", "hy": "85%" } },
          {
            "id": "rule", "type": "shape", "shape": "line", "y": "{{fmt.portrait ? '38%' : '33%'}}", "width": "{{fmt.u * 10}}", "height": 2,
            "points": [[0, 0], ["{{fmt.u * 10}}", 0]], "stroke": { "color": "$accent", "width": "{{fmt.u * 0.6}}", "cap": "round" },
            "enter": { "preset": "drawOn", "duration": 0.6 }
          },
          { "id": "takeaway", "text": "{{takeaway}}", "style": "heading", "y": "50%", "width": "{{fmt.portrait ? fmt.safe.w : fmt.w * 0.7}}", "split": "words", "enter": { "preset": "fadeUp", "stagger": 0.06, "delay": 0.2, "ease": "outExpo" } },
          { "$if": "source", "then": { "id": "source", "text": "{{source}}", "style": "caption", "y": "{{fmt.h - fmt.safe.bottom - fmt.u * 2}}", "width": "{{fmt.safe.w}}", "enter": { "preset": "fadeIn", "delay": 1 } } }
        ]
      }
    ],
    "audio": { "$use": "music" }
  }
}
