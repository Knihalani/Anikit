{
  "name": "changelog",
  "title": "Changelog / what's new",
  "description": "A 12–25 s release recap: a version badge and kinetic title beside the product UI, then the changes as icon cards (New ✦, Improved ⚡, Fixed ✓) building in three at a time, then a CTA with confetti.",
  "duration": "12–25 s",
  "tags": [
    "changelog",
    "release",
    "update",
    "whats-new"
  ],
  "params": {
    "product": {
      "type": "string",
      "default": "{{brand.name}}",
      "maxWords": 3,
      "description": "Product name.",
      "example": "Anikit"
    },
    "version": {
      "type": "string",
      "required": true,
      "maxChars": 12,
      "description": "Version shown in the badge, e.g. 'v2.4' or '2026.11'.",
      "example": "v2.4"
    },
    "title": {
      "type": "string",
      "default": "What's new",
      "maxWords": 4,
      "description": "Headline above the version badge.",
      "example": "What's new"
    },
    "date": {
      "type": "string",
      "maxChars": 24,
      "description": "Optional release date.",
      "example": "November 2026"
    },
    "items": {
      "type": "array",
      "required": true,
      "minItems": 3,
      "maxItems": 6,
      "description": "The changes, most exciting first. Each is one short line.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "enum",
            "values": [
              "new",
              "improved",
              "fixed"
            ],
            "required": true,
            "description": "Kind of change; sets the pill colour."
          },
          "text": {
            "type": "string",
            "required": true,
            "maxWords": 8,
            "description": "The change as a benefit."
          }
        }
      },
      "example": [
        {
          "type": "new",
          "text": "Vertical video templates"
        },
        {
          "type": "new",
          "text": "MCP server for agents"
        },
        {
          "type": "improved",
          "text": "Faster still previews"
        },
        {
          "type": "fixed",
          "text": "Emoji in captions"
        }
      ]
    },
    "cta": {
      "type": "string",
      "default": "Update now",
      "maxWords": 4,
      "description": "Call to action on the end card.",
      "example": "Update now"
    },
    "url": {
      "type": "string",
      "default": "{{brand.voice.url}}",
      "maxChars": 32,
      "description": "Where to read the full notes.",
      "example": "anikit.dev/changelog"
    },
    "music": {
      "type": "string",
      "description": "Optional music file (MP3/WAV)."
    }
  },
  "spec": {
    "size": [
      "{{fmt.w}}",
      "{{fmt.h}}"
    ],
    "fps": "{{fmt.fps}}",
    "theme": {
      "$use": "theme"
    },
    "background": "$bgDeep",
    "transition": {
      "type": "crossfade",
      "duration": 0.5
    },
    "scenes": [
      {
        "id": "intro",
        "duration": "{{readtime((title ?? 'What is new') + ' ' + (product ?? '')) + 2.2}}",
        "camera": {
          "animate": [
            {
              "from": {
                "zoom": 1.05
              },
              "to": {
                "zoom": 1
              },
              "duration": 3,
              "ease": "outCubic"
            }
          ]
        },
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 6,
              "floor": true,
              "intensity": 0.36
            }
          },
          {
            "$let": {
              "tw": "fmt.landscape ? fmt.w * 0.38 : fmt.safe.w",
              "ts": "fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5",
              "lines": "ceil(len((title ?? 'What is new') + ' in ' + (product ?? brand.name)) * 0.48 * (fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5) / (fmt.landscape ? fmt.w * 0.38 : fmt.safe.w))",
              "top": "fmt.landscape ? fmt.h * 0.5 - (ceil(len((title ?? 'What is new') + ' in ' + (product ?? brand.name)) * 0.48 * (fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5) / (fmt.landscape ? fmt.w * 0.38 : fmt.safe.w)) * (fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5) * 1.1 + fmt.u * 14) / 2 : (fmt.portrait ? fmt.h * 0.14 : fmt.h * 0.1)",
              "ax": "fmt.landscape ? fmt.safe.left : fmt.cx",
              "an": "fmt.landscape ? 'topLeft' : 'top'",
              "al": "fmt.landscape ? 'left' : 'center'"
            },
            "in": [
              {
                "type": "component",
                "component": "badge",
                "props": {
                  "label": "{{version}}",
                  "solid": false,
                  "size": "{{fmt.portrait ? fmt.u * 3.4 : fmt.u * 2.8}}",
                  "delay": 0.1
                },
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top - fmt.u * 2}}",
                "width": "{{fmt.u * 40}}",
                "height": "{{fmt.u * 7}}"
              },
              {
                "text": "{{(title ?? 'What is new') + ' in ' + (product ?? brand.name)}}",
                "style": "title",
                "weight": 750,
                "width": "{{tw}}",
                "align": "{{al}}",
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top + fmt.u * 4.5}}",
                "enter": "pop by char from center"
              },
              {
                "$if": "date",
                "then": {
                  "text": "{{date}}",
                  "style": "subtitle",
                  "width": "{{tw * 0.95}}",
                  "align": "{{al}}",
                  "x": "{{ax}}",
                  "anchor": "{{an}}",
                  "y": "{{top + fmt.u * 4.5 + lines * ts * 1.1 + fmt.u * 2.5}}",
                  "enter": {
                    "preset": "fadeUp",
                    "delay": 0.35
                  }
                }
              }
            ]
          },
          {
            "$let": {
              "vx": "fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.25 : fmt.cx",
              "vy": "fmt.landscape ? fmt.h * 0.5 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.66)",
              "vw": "fmt.landscape ? fmt.w * 0.5 : (fmt.portrait ? fmt.safe.w : fmt.w * 0.7)"
            },
            "in": [
              {
                "$use": "device",
                "with": {
                  "kind": "browser",
                  "url": "{{url}}",
                  "delay": 0.5,
                  "x": "{{vx}}",
                  "y": "{{vy}}",
                  "width": "{{vw * 0.9}}",
                  "height": "{{vw * 0.9 / 1.6 + fmt.u * 6}}"
                }
              },
              {
                "type": "component",
                "component": "toast",
                "props": {
                  "title": "{{'Updated to ' + version}}",
                  "kind": "success",
                  "delay": 1.1,
                  "from": "{{fmt.landscape ? 'right' : 'bottom'}}",
                  "width": "{{fmt.u * 46}}"
                },
                "x": "{{vx}}",
                "y": "{{vy + vw * 0.27}}",
                "width": "{{fmt.u * 50}}",
                "height": "{{fmt.u * 14}}"
              }
            ]
          },
          {
            "$use": "grain"
          }
        ]
      },
      {
        "$each": "range(ceil(len(items) / ceil(len(items) / ceil(len(items) / 3))))",
        "as": "g",
        "index": "gi",
        "do": {
          "$let": {
            "per": "ceil(len(items) / ceil(len(items) / 3))",
            "grp": "slice(items, g * per, g * per + per)"
          },
          "in": {
            "id": "changes-{{g + 1}}",
            "transition": {
              "type": "push",
              "direction": "{{fmt.portrait ? 'up' : 'left'}}",
              "duration": 0.6,
              "ease": "inOutQuart"
            },
            "duration": "{{readtime(join(pick(grp, 'text'), ' ')) + 1.8}}",
            "layers": [
              {
                "$use": "backdrop",
                "with": {
                  "seed": "{{12 + g * 5}}"
                }
              },
              {
                "text": "{{(title ?? 'What is new') + ' in ' + version}}",
                "style": "heading",
                "weight": 750,
                "width": "{{fmt.safe.w}}",
                "y": "{{fmt.portrait ? '20%' : '27%'}}",
                "enter": "mask by word up"
              },
              {
                "$each": "grp",
                "as": "it",
                "index": "k",
                "do": {
                  "$let": {
                    "n": "len(grp)",
                    "cw": "fmt.landscape ? min(fmt.w * 0.27, (fmt.safe.w - fmt.u * 4 * (len(grp) - 1)) / len(grp)) : fmt.safe.w",
                    "ch": "fmt.landscape ? fmt.u * 22 : fmt.u * 17",
                    "x0": "fmt.cx - (len(grp) * min(fmt.w * 0.27, (fmt.safe.w - fmt.u * 4 * (len(grp) - 1)) / len(grp)) + (len(grp) - 1) * fmt.u * 4) / 2"
                  },
                  "in": {
                    "type": "component",
                    "component": "card",
                    "props": {
                      "title": "{{it.text}}",
                      "body": "{{it.type == 'new' ? 'New' : it.type == 'improved' ? 'Improved' : 'Fixed'}}",
                      "icon": "{{it.type == 'new' ? 'spark' : it.type == 'improved' ? 'bolt' : 'check'}}",
                      "accent": "{{it.type == 'new' ? brand.colors.primary : it.type == 'improved' ? brand.colors.secondary : brand.colors.accent}}",
                      "glow": true,
                      "delay": "{{0.25 + k * 0.18}}"
                    },
                    "x": "{{fmt.landscape ? x0 + cw / 2 + k * (cw + fmt.u * 4) : fmt.cx}}",
                    "y": "{{fmt.landscape ? fmt.h * 0.55 : fmt.h * 0.32 + k * (ch + fmt.u * 4) + ch / 2}}",
                    "width": "{{cw}}",
                    "height": "{{ch}}"
                  }
                }
              },
              {
                "$use": "grain"
              }
            ]
          }
        }
      },
      {
        "id": "cta",
        "transition": {
          "type": "blur",
          "duration": 0.6
        },
        "duration": "{{max(3.8, readtime(product ?? brand.name + ' ' + cta + ' ' + (url ?? '')) + 1.6)}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 31,
              "floor": true,
              "intensity": 0.42
            }
          },
          {
            "$if": "brand.logo",
            "then": {
              "src": "{{brand.logo}}",
              "height": "{{fmt.u * 10}}",
              "fit": "contain",
              "y": "{{fmt.portrait ? '33%' : '28%'}}",
              "enter": "scaleIn"
            }
          },
          {
            "text": "{{product ?? brand.name}}",
            "style": "title",
            "y": "42%",
            "width": "{{fmt.safe.w}}",
            "enter": "rise"
          },
          {
            "$use": "ctaButton",
            "with": {
              "label": "{{cta}}",
              "y": "{{fmt.portrait ? '53%' : '58%'}}",
              "press": 1.5
            }
          },
          {
            "$if": "url",
            "then": {
              "text": "{{url}}",
              "style": "caption",
              "y": "{{fmt.portrait ? '61%' : '70%'}}",
              "enter": {
                "preset": "fadeIn",
                "delay": 0.9
              }
            }
          },
          {
            "$use": "confetti",
            "with": {
              "at": 1.5,
              "oy": "{{fmt.portrait ? 0.53 : 0.58}}"
            }
          },
          {
            "$use": "grain"
          }
        ]
      }
    ],
    "audio": {
      "$use": "music"
    }
  }
}