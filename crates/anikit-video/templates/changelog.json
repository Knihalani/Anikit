{
  "name": "changelog",
  "look": "brutalist",
  "intent": { "pace": "steady", "genre": "launch" },
  "title": "Changelog / what's new",
  "description": "A 12–30 s release recap: the version badge and headline beside the product's app screen, then one beat per change with a solid NEW / IMPROVED / FIXED chip, the change in big type and a progress ring counting through the release, then a version end card with a CTA and a sparks burst.",
  "tips": ["A template gives every product the same structure, so used as-is it tends to look like every other video made from it. It works well as a fast draft that you then make this product's own: a palette from its assets, a typeface chosen for it, its real UI or object as the hero, a score whose instruments fit it. For an original film, see the `director` prompt or skills/anikit-launch-video, and `anikit-video docs taste`.", "Lines read comfortably when held for max(0.83 s, chars/15, words × 0.3) after they settle, sharp, with no blur or glow while read. If a line doesn't fit, cutting words usually works better than shrinking type.", "Use the release's real wording and name the user-facing effect of each change, not the ticket title."],
  "duration": "12–30 s",
  "tags": [
    "changelog",
    "release",
    "update",
    "whats-new"
  ],
  "params": {
    "product": {
      "type": "string",
      "default": "{{brand.name}}",
      "maxWords": 3,
      "description": "Product name.",
      "example": "Anikit"
    },
    "version": {
      "type": "string",
      "required": true,
      "maxChars": 12,
      "description": "Version shown in the badge, e.g. 'v2.4' or '2026.11'.",
      "example": "v2.4"
    },
    "title": {
      "type": "string",
      "default": "What's new",
      "maxWords": 4,
      "description": "Headline above the version badge.",
      "example": "What's new"
    },
    "date": {
      "type": "string",
      "maxChars": 24,
      "description": "Optional release date.",
      "example": "November 2026"
    },
    "items": {
      "type": "array",
      "required": true,
      "minItems": 3,
      "maxItems": 6,
      "description": "The changes, most exciting first: a short line each, plus an optional detail.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "enum",
            "values": [
              "new",
              "improved",
              "fixed"
            ],
            "required": true,
            "description": "Kind of change; sets the pill colour."
          },
          "text": {
            "type": "string",
            "required": true,
            "maxWords": 8,
            "description": "The change as a benefit. Short: it sits in a card.",
            "maxChars": 34
          },
          "body": {
            "type": "string",
            "maxWords": 14,
            "maxChars": 90,
            "description": "Optional one-line detail under the change."
          }
        }
      },
      "example": [
        {
          "type": "new",
          "text": "Vertical video templates",
          "body": "Export 9:16 and 1:1 cuts from the same project."
        },
        {
          "type": "new",
          "text": "MCP server for agents"
        },
        {
          "type": "improved",
          "text": "Faster still previews"
        },
        {
          "type": "fixed",
          "text": "Emoji in captions"
        }
      ]
    },
    "cta": {
      "type": "string",
      "default": "Update now",
      "maxWords": 4,
      "description": "Call to action on the end card.",
      "example": "Update now"
    },
    "url": {
      "type": "string",
      "default": "{{brand.voice.url}}",
      "maxChars": 32,
      "description": "Where to read the full notes.",
      "example": "anikit.dev/changelog"
    },
    "music": {
      "type": "string",
      "description": "Optional music file (MP3/WAV)."
    }
  },
  "spec": {
    "size": [
      "{{fmt.w}}",
      "{{fmt.h}}"
    ],
    "fps": "{{fmt.fps}}",
    "theme": {
      "$use": "theme"
    },
    "background": "$bgDeep",
    "transition": {
      "type": "crossfade",
      "duration": 0.5
    },
    "scenes": [
      {
        "id": "intro",
        "duration": "{{readtime((title ?? 'What is new') + ' ' + (product ?? '')) + 2.2}}",
        "camera": {
          "animate": [
            {
              "from": {
                "zoom": 1.05
              },
              "to": {
                "zoom": 1
              },
              "duration": 0.9,
              "ease": "outExpo"
            }
          ]
        },
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 6,
              "floor": true,
              "intensity": 0.36
            }
          },
          {
            "$let": {
              "tw": "fmt.landscape ? fmt.w * 0.38 : fmt.safe.w",
              "ts": "fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5",
              "lines": "1 + ceil(len((title ?? 'What is new') + ' in') * cw * ts / tw)",
              "top": "fmt.landscape ? fmt.h * 0.5 - (lines * (fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5) * 1.1 + fmt.u * 14) / 2 : (fmt.portrait ? fmt.h * 0.14 : fmt.h * 0.1)",
              "ax": "fmt.landscape ? fmt.safe.left : fmt.cx",
              "an": "fmt.landscape ? 'topLeft' : 'top'",
              "al": "fmt.landscape ? 'left' : 'center'"
            },
            "in": [
              {
                "type": "component",
                "component": "badge",
                "props": {
                  "label": "{{version}}",
                  "solid": true,
                  "size": "{{fmt.portrait ? fmt.u * 3.4 : fmt.u * 2.8}}",
                  "delay": 0.1,
                  "align": "{{fmt.landscape ? 0 : 0.5}}",
                  "color": "{{brand.colors.primary}}"
                },
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top - fmt.u * 2}}",
                "width": "{{fmt.u * 40}}",
                "height": "{{fmt.u * 7}}"
              },
              {
                "text": "{{(title ?? 'What is new') + ' in\n[' + (product ?? brand.name) + ']{$accent}'}}",
                "style": "title",
                "weight": 750,
                "width": "{{tw}}",
                "align": "{{al}}",
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top + fmt.u * 4.5}}",
                "enter": "pop by char from center",
                "lineHeight": 1.05
              },
              {
                "$if": "date",
                "then": {
                  "text": "{{date}}",
                  "style": "subtitle",
                  "width": "{{tw * 0.95}}",
                  "align": "{{al}}",
                  "x": "{{ax}}",
                  "anchor": "{{an}}",
                  "y": "{{top + fmt.u * 4.5 + lines * ts * 1.1 + fmt.u * 2.5}}",
                  "enter": {
                    "preset": "fadeUp",
                    "delay": 0.35
                  }
                }
              }
            ]
          },
          {
            "$let": {
              "vx": "fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.25 : fmt.cx",
              "vy": "fmt.landscape ? fmt.h * 0.5 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.66)",
              "vw": "fmt.landscape ? fmt.w * 0.5 : (fmt.portrait ? fmt.safe.w : fmt.w * 0.7)"
            },
            "in": [
              {
                "$use": "device",
                "with": {
                  "kind": "browser",
                  "url": "{{url}}",
                  "delay": 0.5,
                  "x": "{{vx}}",
                  "y": "{{vy}}",
                  "width": "{{vw * 0.9}}",
                  "height": "{{vw * 0.9 / 1.6 + fmt.u * 6}}"
                }
              }
            ]
          },
          {
            "$use": "grain"
          }
        ]
      },
      {
        "$each": "items",
        "as": "it",
        "index": "k",
        "do": {
          "id": "change-{{k + 1}}",
          "transition": {
            "type": "push",
            "direction": "{{fmt.portrait ? 'up' : 'left'}}",
            "duration": 0.5,
            "ease": "inOutQuart"
          },
          "duration": "{{max(2.6, readtime(it.text + ' ' + (it.body ?? '')) + 0.9)}}",
          "layers": [
            {
              "$use": "backdrop",
              "with": {
                "seed": "{{12 + k * 5}}",
                "still": true,
                "intensity": 0.3
              }
            },
            {
              "type": "component",
              "component": "badge",
              "props": {
                "label": "{{upper(product ?? brand.name)}}",
                "solid": true,
                "color": "{{brand.colors.fill}}",
                "size": "{{fmt.u * 2.3}}",
                "align": 0
              },
              "x": "{{fmt.safe.left}}",
              "anchor": "left",
              "y": "{{fmt.safe.top + fmt.u * 2}}",
              "width": "{{fmt.u * 30}}",
              "height": "{{fmt.u * 5}}"
            },
            {
              "text": "{{'RELEASE NOTES · ' + upper(version)}}",
              "font": "$mono",
              "size": "{{fmt.u * 2.3}}",
              "weight": 600,
              "letterSpacing": "0.12em",
              "color": "$muted",
              "x": "{{fmt.safe.left + fmt.u * (len(product ?? brand.name) * 1.55 + 5.5)}}",
              "anchor": "left",
              "y": "{{fmt.safe.top + fmt.u * 2}}"
            },
            {
              "text": "{{((k + 1) < 10 ? '0' + str(k + 1) : str(k + 1)) + ' / ' + (len(items) < 10 ? '0' + str(len(items)) : str(len(items)))}}",
              "font": "$mono",
              "size": "{{fmt.u * 2.3}}",
              "weight": 600,
              "color": "$muted",
              "x": "{{fmt.w - fmt.safe.right}}",
              "anchor": "right",
              "y": "{{fmt.safe.top + fmt.u * 2}}"
            },
            {
              "type": "shape",
              "shape": "rect",
              "x": "{{fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.17 : fmt.cx}}",
              "y": "{{fmt.portrait ? fmt.h * 0.34 : (fmt.square ? fmt.h * 0.33 : fmt.h * 0.52)}}",
              "width": "{{fmt.portrait ? fmt.u * 50 : fmt.u * 50}}",
              "height": "{{fmt.portrait ? fmt.u * 50 : fmt.u * 50}}",
              "radius": "{{fmt.u * 2.4}}",
              "fill": "{{alpha(brand.colors.surface, 0.55)}}",
              "stroke": {
                "color": "{{alpha(brand.colors.text, 0.1)}}",
                "width": 1
              },
              "enter": {
                "preset": "scaleIn",
                "duration": 0.5
              }
            },
            {
              "type": "shape",
              "shape": "circle",
              "x": "{{fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.17 : fmt.cx}}",
              "y": "{{fmt.portrait ? fmt.h * 0.34 : (fmt.square ? fmt.h * 0.33 : fmt.h * 0.52)}}",
              "width": "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 1.7}}",
              "height": "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 1.7}}",
              "fill": "radial-gradient({{alpha(it.type == 'new' ? brand.colors.fill : (it.type == 'improved' ? '#2563EB' : '#15803D'), 0.35)}} 0%, {{alpha(it.type == 'new' ? brand.colors.fill : (it.type == 'improved' ? '#2563EB' : '#15803D'), 0)}} 70%)",
              "enter": {
                "preset": "fadeIn",
                "duration": 0.6
              }
            },
            {
              "$if": "it.type == 'new'",
              "then": {
                "type": "shape",
                "shape": "star",
                "sides": 4,
                "innerRadius": 0.3,
                "x": "{{fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.17 : fmt.cx}}",
                "y": "{{fmt.portrait ? fmt.h * 0.34 : (fmt.square ? fmt.h * 0.33 : fmt.h * 0.52)}}",
                "width": "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22)}}",
                "height": "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22)}}",
                "fill": "{{it.type == 'new' ? brand.colors.fill : (it.type == 'improved' ? '#2563EB' : '#15803D')}}",
                "enter": {
                  "preset": "rotateIn",
                  "duration": 0.6
                }
              }
            },
            {
              "$if": "it.type == 'improved'",
              "then": {
                "type": "shape",
                "shape": "polygon",
                "x": "{{fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.17 : fmt.cx}}",
                "y": "{{fmt.portrait ? fmt.h * 0.34 : (fmt.square ? fmt.h * 0.33 : fmt.h * 0.52)}}",
                "width": "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.72}}",
                "height": "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22)}}",
                "points": [
                  [
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.42}}",
                    0
                  ],
                  [
                    0,
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.58}}"
                  ],
                  [
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.33}}",
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.58}}"
                  ],
                  [
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.24}}",
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22)}}"
                  ],
                  [
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.72}}",
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.38}}"
                  ],
                  [
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.4}}",
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.38}}"
                  ]
                ],
                "fill": "{{it.type == 'new' ? brand.colors.fill : (it.type == 'improved' ? '#2563EB' : '#15803D')}}",
                "enter": {
                  "preset": "popIn",
                  "duration": 0.5
                }
              }
            },
            {
              "$if": "it.type == 'fixed'",
              "then": {
                "type": "shape",
                "shape": "line",
                "x": "{{fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.17 : fmt.cx}}",
                "y": "{{fmt.portrait ? fmt.h * 0.34 : (fmt.square ? fmt.h * 0.33 : fmt.h * 0.52)}}",
                "width": "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22)}}",
                "height": "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.78}}",
                "points": [
                  [
                    0,
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.42}}"
                  ],
                  [
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.36}}",
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22) * 0.78}}"
                  ],
                  [
                    "{{(fmt.portrait ? fmt.u * 26 : fmt.u * 22)}}",
                    0
                  ]
                ],
                "stroke": {
                  "color": "{{it.type == 'new' ? brand.colors.fill : (it.type == 'improved' ? '#2563EB' : '#15803D')}}",
                  "width": "{{fmt.u * 3}}",
                  "cap": "round",
                  "join": "round"
                },
                "enter": {
                  "preset": "drawOn",
                  "duration": 0.6,
                  "delay": 0.15
                }
              }
            },
            {
              "$let": {
                "ln": "ceil(len(it.text) * 0.46 * (fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5) / (fmt.landscape ? fmt.w * 0.44 : fmt.safe.w))",
                "ts": "fmt.portrait ? fmt.u * 10.5 : fmt.u * 9.5",
                "bh": "it.body ? (fmt.portrait ? fmt.u * 11 : fmt.u * 9) : 0"
              },
              "in": [
                {
                  "$if": "fmt.landscape",
                  "then": {
                    "type": "shape",
                    "shape": "rect",
                    "x": "{{fmt.safe.left}}",
                    "anchor": "topLeft",
                    "y": "{{fmt.h * 0.5 - (fmt.u * 10 + ln * ts * 1.08 + bh) / 2}}",
                    "width": "{{fmt.u * 0.7}}",
                    "height": "{{fmt.u * 10 + ln * ts * 1.08 + bh}}",
                    "fill": "{{it.type == 'new' ? brand.colors.fill : (it.type == 'improved' ? '#2563EB' : '#15803D')}}",
                    "radius": "{{fmt.u * 0.35}}",
                    "enter": {
                      "preset": "wipeIn",
                      "direction": "down",
                      "duration": 0.5
                    }
                  }
                },
                {
                  "type": "component",
                  "component": "badge",
                  "props": {
                    "label": "{{upper(it.type)}}",
                    "solid": true,
                    "color": "{{it.type == 'new' ? brand.colors.fill : (it.type == 'improved' ? '#2563EB' : '#15803D')}}",
                    "size": "{{fmt.portrait ? fmt.u * 3.6 : fmt.u * 3}}",
                    "align": "{{fmt.landscape ? 0 : 0.5}}",
                    "delay": 0.15
                  },
                  "x": "{{fmt.landscape ? fmt.safe.left + fmt.u * 3 : fmt.cx}}",
                  "anchor": "{{fmt.landscape ? 'left' : 'center'}}",
                  "y": "{{fmt.landscape ? fmt.h * 0.5 - (fmt.u * 10 + ln * ts * 1.08 + bh) / 2 + fmt.u * 3.2 : (fmt.portrait ? fmt.h * 0.55 : fmt.h * 0.56)}}",
                  "width": "{{fmt.u * 40}}",
                  "height": "{{fmt.u * 9}}"
                },
                {
                  "text": "{{it.text}}",
                  "style": "title",
                  "weight": 780,
                  "width": "{{fmt.landscape ? fmt.w * 0.44 : fmt.safe.w}}",
                  "align": "{{fmt.landscape ? 'left' : 'center'}}",
                  "x": "{{fmt.landscape ? fmt.safe.left + fmt.u * 3 : '50%'}}",
                  "anchor": "{{fmt.landscape ? 'topLeft' : 'top'}}",
                  "y": "{{fmt.landscape ? fmt.h * 0.5 - (fmt.u * 10 + ln * ts * 1.08 + bh) / 2 + fmt.u * 9 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.61)}}",
                  "enter": "mask by word up"
                },
                {
                  "$if": "it.body",
                  "then": {
                    "text": "{{it.body}}",
                    "style": "subtitle",
                    "width": "{{fmt.landscape ? fmt.w * 0.42 : fmt.safe.w}}",
                    "align": "{{fmt.landscape ? 'left' : 'center'}}",
                    "x": "{{fmt.landscape ? fmt.safe.left + fmt.u * 3 : '50%'}}",
                    "anchor": "{{fmt.landscape ? 'topLeft' : 'top'}}",
                    "y": "{{(fmt.landscape ? fmt.h * 0.5 - (fmt.u * 10 + ln * ts * 1.08 + bh) / 2 + fmt.u * 9 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.61)) + ln * ts * 1.08 + fmt.u * 2}}",
                    "enter": {
                      "preset": "fadeUp",
                      "delay": 0.4
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "cta",
        "transition": {
          "type": "zoom",
          "duration": 0.6
        },
        "duration": "{{max(3.8, readtime((product ?? brand.name) + ' ' + cta + ' ' + (url ?? '')) + 1.8)}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 41,
              "floor": true,
              "intensity": 0.38
            }
          },
          {
            "type": "component",
            "component": "sparks",
            "props": {
              "bursts": [
                1.6
              ],
              "origin": [
                0.5,
                "{{fmt.portrait ? 0.56 : 0.65}}"
              ],
              "count": 90,
              "colors": [
                "{{brand.colors.primary}}",
                "{{brand.colors.secondary}}"
              ],
              "seed": 5
            }
          },
          {
            "text": "{{(product ?? brand.name) + ' ' + version + ' is out'}}",
            "style": "label",
            "y": "{{fmt.portrait ? '30%' : '26%'}}",
            "enter": "fadeUp"
          },
          {
            "text": "{{version}}",
            "style": "hero",
            "size": "{{fmt.portrait ? fmt.u * 30 : fmt.u * 26}}",
            "color": "{{brand.colors.accent}}",
            "y": "{{fmt.portrait ? '41%' : '43%'}}",
            "enter": "pop by char from center"
          },
          {
            "$use": "ctaButton",
            "with": {
              "label": "{{cta}}",
              "y": "{{fmt.portrait ? '56%' : '65%'}}",
              "press": 1.6,
              "delay": 0.7
            }
          },
          {
            "$if": "url",
            "then": {
              "text": "{{url}}",
              "style": "caption",
              "y": "{{fmt.portrait ? '63%' : '75%'}}",
              "enter": {
                "preset": "fadeIn",
                "delay": 1.0
              }
            }
          }
        ]
      }
    ],
    "audio": {
      "$use": "music"
    }
  }
}