{
  "name": "tutorial",
  "look": "risograph",
  "intent": { "pace": "steady", "genre": "explainer" },
  "title": "Tutorial / code walkthrough",
  "description": "A coding tutorial: a title beside an editor; then 2–6 split-screen steps, each a numbered badge, title and note beside a code editor that types itself (with highlighted lines) or a terminal for one-line shell commands; then a checklist recap and a CTA with confetti.",
  "duration": "15–60 s",
  "tags": [
    "tutorial",
    "code",
    "developer",
    "how-to",
    "walkthrough"
  ],
  "params": {
    "title": {
      "type": "string",
      "required": true,
      "maxWords": 8,
      "description": "What the viewer will be able to do, as an outcome.",
      "example": "Render a video from JSON in 3 steps"
    },
    "subtitle": {
      "type": "string",
      "maxWords": 12,
      "description": "Optional line under the title (who it's for, or the time it takes).",
      "example": "No browser, no timeline editor."
    },
    "language": {
      "type": "string",
      "default": "",
      "maxChars": 16,
      "description": "Label shown in the code window bar, e.g. 'bash', 'json', 'ts'.",
      "example": "bash"
    },
    "steps": {
      "type": "array",
      "required": true,
      "minItems": 2,
      "maxItems": 6,
      "description": "The steps in order. Keep each code block short (ideally ≤ 8 lines, ≤ 50 characters per line).",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "required": true,
            "maxWords": 6,
            "description": "The action, imperative: 'Install the CLI'."
          },
          "body": {
            "type": "string",
            "maxWords": 18,
            "description": "Why or what to notice, in one sentence."
          },
          "code": {
            "type": "text",
            "required": true,
            "maxChars": 420,
            "description": "Code shown in the window; use \\n for new lines."
          },
          "language": {
            "type": "string",
            "maxChars": 16,
            "description": "Overrides the top-level language for this step."
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "maxItems": 4,
            "description": "1-based line numbers to highlight after typing finishes."
          }
        }
      },
      "example": [
        {
          "title": "Install the CLI",
          "body": "One binary, no browser to download.",
          "code": "cargo install anikit-video",
          "language": "bash"
        },
        {
          "title": "Describe your video",
          "body": "Scenes and layers in plain JSON.",
          "code": "{\n  \"scenes\": [\n    { \"layers\": [\n      { \"text\": \"Hello\", \"enter\": \"fadeUp\" }\n    ] }\n  ]\n}",
          "language": "json",
          "highlight": [
            4
          ]
        },
        {
          "title": "Render it",
          "body": "Every core, straight to MP4.",
          "code": "anikit-video render hello.json -o hello.mp4",
          "language": "bash"
        }
      ]
    },
    "recap": {
      "type": "string",
      "default": "That's it.",
      "maxWords": 10,
      "description": "Closing line on the end card.",
      "example": "Your first video, from one JSON file."
    },
    "cta": {
      "type": "string",
      "default": "{{brand.voice.cta}}",
      "maxWords": 4,
      "description": "Call to action on the end card.",
      "example": "Read the docs"
    },
    "url": {
      "type": "string",
      "default": "{{brand.voice.url}}",
      "maxChars": 32,
      "description": "Address on the end card.",
      "example": "anikit.dev/docs"
    },
    "music": {
      "type": "string",
      "description": "Optional music file. Calm and low (lo-fi, 70–95 BPM) so it doesn't fight the reading."
    }
  },
  "defs": {
    "codeWindow": {
      "$let": {
        "lines": "len(split(s.code, '\n'))",
        "codeSize": "min(fmt.u * (fmt.portrait ? 3.4 : 2.8), (width - fmt.u * (fmt.portrait ? 3.2 : 2.6) * 2) / 30)",
        "pad": "fmt.u * (fmt.portrait ? 3.2 : 2.6)"
      },
      "in": {
        "$let": {
          "lh": "codeSize * 1.55"
        },
        "in": {
          "type": "box",
          "id": "code-window",
          "width": "{{width}}",
          "style": {
            "direction": "column",
            "align": "stretch",
            "background": "$surface",
            "radius": "{{fmt.u * 1.8}}",
            "border": "1px $border"
          },
          "clip": true,
          "shadow": {
            "x": 0,
            "y": "{{fmt.u * 3}}",
            "blur": "{{fmt.u * 9}}",
            "color": "#00000066"
          },
          "enter": {
            "preset": "slideUp",
            "delay": 0.3,
            "duration": 0.7
          },
          "children": [
            {
              "type": "box",
              "height": "{{fmt.u * 4.4}}",
              "style": {
                "direction": "row",
                "gap": "{{fmt.u * 0.9}}",
                "padding": [
                  0,
                  "{{fmt.u * 1.8}}"
                ],
                "align": "center",
                "justify": "start"
              },
              "children": [
                {
                  "shape": "circle",
                  "width": "{{fmt.u * 1.25}}",
                  "height": "{{fmt.u * 1.25}}",
                  "fill": "#FF5F57"
                },
                {
                  "shape": "circle",
                  "width": "{{fmt.u * 1.25}}",
                  "height": "{{fmt.u * 1.25}}",
                  "fill": "#FEBC2E"
                },
                {
                  "shape": "circle",
                  "width": "{{fmt.u * 1.25}}",
                  "height": "{{fmt.u * 1.25}}",
                  "fill": "#28C840"
                },
                {
                  "$if": "s.language || language",
                  "then": {
                    "type": "box",
                    "style": {
                      "grow": 1,
                      "justify": "end"
                    },
                    "children": [
                      {
                        "text": "{{s.language ?? language}}",
                        "style": "label",
                        "color": "$muted",
                        "size": "{{fmt.u * 2.3}}"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "group",
              "id": "code-area",
              "width": "{{width}}",
              "height": "{{lines * lh + pad * 2}}",
              "layers": [
                {
                  "$each": "s.highlight ?? []",
                  "as": "ln",
                  "do": {
                    "type": "group",
                    "x": 0,
                    "y": "{{pad + (ln - 1) * lh}}",
                    "anchor": "topLeft",
                    "width": "{{width}}",
                    "height": "{{lh}}",
                    "start": "{{0.9 + typing}}",
                    "enter": {
                      "preset": "wipeIn",
                      "direction": "right",
                      "duration": 0.4
                    },
                    "layers": [
                      {
                        "shape": "rect",
                        "x": 0,
                        "y": 0,
                        "anchor": "topLeft",
                        "width": "{{width}}",
                        "height": "{{lh}}",
                        "fill": "{{alpha(brand.colors.accent, 0.16)}}"
                      },
                      {
                        "shape": "rect",
                        "x": 0,
                        "y": 0,
                        "anchor": "topLeft",
                        "width": "{{fmt.u * 0.5}}",
                        "height": "{{lh}}",
                        "fill": "$accent"
                      }
                    ]
                  }
                },
                {
                  "id": "code",
                  "text": "{{s.code}}",
                  "style": "code",
                  "align": "left",
                  "lineHeight": 1.55,
                  "x": "{{pad}}",
                  "y": "{{pad}}",
                  "anchor": "topLeft",
                  "enter": {
                    "preset": "typewriter",
                    "cps": "{{cps}}",
                    "delay": 0.9
                  },
                  "size": "{{codeSize}}"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "spec": {
    "size": [
      "{{fmt.w}}",
      "{{fmt.h}}"
    ],
    "fps": "{{fmt.fps}}",
    "theme": {
      "$use": "theme"
    },
    "background": "$bgDeep",
    "transition": {
      "type": "crossfade",
      "duration": 0.5
    },
    "scenes": [
      {
        "id": "title",
        "duration": "{{max(3.2, readtime(title + ' ' + (subtitle ?? '')) + 1.2)}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 2,
              "floor": true,
              "intensity": 0.32
            }
          },
          {
            "$let": {
              "tw": "(fmt.landscape ? fmt.w * 0.36 : fmt.safe.w)",
              "ts": "(fmt.portrait ? fmt.u * 9 : fmt.u * 8)",
              "lines": "ceil(len(title) * cw * 1.04 * (fmt.portrait ? fmt.u * 9 : fmt.u * 8) / (fmt.landscape ? fmt.w * 0.36 : fmt.safe.w))",
              "top": "(fmt.landscape ? fmt.h * 0.5 - (ceil(len(title) * 0.52 * (fmt.portrait ? fmt.u * 9 : fmt.u * 8) / (fmt.landscape ? fmt.w * 0.36 : fmt.safe.w)) * (fmt.portrait ? fmt.u * 9 : fmt.u * 8) * 1.1 + fmt.u * 12) / 2 : (fmt.portrait ? fmt.h * 0.14 : fmt.h * 0.1))",
              "ax": "fmt.landscape ? fmt.safe.left : fmt.cx",
              "an": "fmt.landscape ? 'topLeft' : 'top'",
              "al": "fmt.landscape ? 'left' : 'center'"
            },
            "in": [
              {
                "text": "TUTORIAL",
                "style": "label",
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top}}",
                "enter": "fadeUp"
              },
              {
                "text": "{{title}}",
                "style": "title",
                "weight": 750,
                "width": "{{tw}}",
                "align": "{{al}}",
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top + fmt.u * 4.5}}",
                "enter": "mask by word up",
                "size": "{{fmt.portrait ? '9vmin' : '8vmin'}}"
              },
              {
                "$if": "subtitle",
                "then": {
                  "text": "{{subtitle}}",
                  "style": "subtitle",
                  "width": "{{tw * 0.95}}",
                  "align": "{{al}}",
                  "x": "{{ax}}",
                  "anchor": "{{an}}",
                  "y": "{{top + fmt.u * 4.5 + lines * ts * 1.1 + fmt.u * 2.5}}",
                  "enter": {
                    "preset": "fadeUp",
                    "delay": 0.35
                  }
                }
              }
            ]
          },
          {
            "$use": "device",
            "with": {
              "kind": "browser",
              "screen": "editor",
              "x": "{{fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.23 : fmt.cx}}",
              "y": "{{fmt.landscape ? '50%' : (fmt.portrait ? '64%' : '68%')}}",
              "width": "{{fmt.landscape ? fmt.w * 0.46 : (fmt.portrait ? fmt.safe.w : fmt.w * 0.66)}}",
              "height": "{{fmt.landscape ? fmt.w * 0.32 : (fmt.portrait ? fmt.safe.w * 0.8 : fmt.w * 0.42)}}",
              "delay": 0.4
            }
          }
        ]
      },
      {
        "$each": "steps",
        "as": "s",
        "index": "i",
        "do": {
          "$let": {
            "lang": "s.language ?? language",
            "tt": "clamp(len(s.code) / 32, 0.8, 4)",
            "nl": "len(split(s.code, '\n'))",
            "shell": "(s.language ?? language) == 'bash' || (s.language ?? language) == 'sh' || (s.language ?? language) == 'shell'"
          },
          "in": {
            "id": "step-{{i + 1}}",
            "transition": {
              "type": "push",
              "direction": "{{fmt.portrait ? 'up' : 'left'}}",
              "duration": 0.5,
              "ease": "inOutQuart"
            },
            "duration": "{{max(readtime(s.title + ' ' + (s.body ?? '')) + 1.2, 0.9 + tt + 1.6 + nl * 0.25)}}",
            "layers": [
              {
                "$use": "backdrop",
                "with": {
                  "seed": "{{7 + i * 4}}",
                  "intensity": 0.26,
                  "still": true
                }
              },
              {
                "$let": {
                  "tw": "(fmt.landscape ? fmt.w * 0.36 : fmt.safe.w)",
                  "ts": "(fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4)",
                  "lines": "ceil(len(s.title) * cw * 1.04 * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) / (fmt.landscape ? fmt.w * 0.36 : fmt.safe.w))",
                  "top": "(fmt.landscape ? fmt.h * 0.5 - (ceil(len(s.title) * 0.52 * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) / (fmt.landscape ? fmt.w * 0.36 : fmt.safe.w)) * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) * 1.1 + fmt.u * 12) / 2 : (fmt.portrait ? fmt.h * 0.14 : fmt.h * 0.1))",
                  "ax": "fmt.landscape ? fmt.safe.left : fmt.cx",
                  "an": "fmt.landscape ? 'topLeft' : 'top'",
                  "al": "fmt.landscape ? 'left' : 'center'"
                },
                "in": [
                  {
                    "type": "component",
                    "component": "badge",
                    "props": {
                      "label": "{{'STEP ' + str(i + 1) + ' / ' + str(count)}}",
                      "align": "{{fmt.landscape ? 0 : 0.5}}",
                      "size": "{{fmt.u * 2.2}}"
                    },
                    "x": "{{ax}}",
                    "anchor": "{{an}}",
                    "y": "{{top}}",
                    "width": "{{fmt.u * 40}}",
                    "height": "{{fmt.u * 5}}"
                  },
                  {
                    "text": "{{s.title}}",
                    "style": "heading",
                    "weight": 750,
                    "width": "{{tw}}",
                    "align": "{{al}}",
                    "x": "{{ax}}",
                    "anchor": "{{an}}",
                    "y": "{{top + fmt.u * 4.5}}",
                    "enter": "mask by word up"
                  },
                  {
                    "$if": "s.body",
                    "then": {
                      "text": "{{s.body}}",
                      "style": "subtitle",
                      "width": "{{tw * 0.95}}",
                      "align": "{{al}}",
                      "x": "{{ax}}",
                      "anchor": "{{an}}",
                      "y": "{{top + fmt.u * 4.5 + lines * ts * 1.1 + fmt.u * 2.5}}",
                      "enter": {
                        "preset": "fadeUp",
                        "delay": 0.35
                      }
                    }
                  }
                ]
              },
              {
                "$let": {
                  "cx2": "fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.24 : fmt.cx",
                  "cy2": "fmt.landscape ? fmt.h * 0.5 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.66)",
                  "cw": "fmt.landscape ? fmt.w * 0.48 : fmt.safe.w",
                  "ch": "fmt.landscape ? fmt.h * 0.56 : (fmt.portrait ? fmt.h * 0.36 : fmt.h * 0.44)",
                  "fs": "fmt.landscape ? fmt.u * 2.6 : fmt.u * 3"
                },
                "in": {
                  "$if": "shell && nl == 1",
                  "then": {
                    "type": "component",
                    "component": "terminal",
                    "props": {
                      "lines": [
                        "{{'$ ' + s.code}}",
                        "✓ done"
                      ],
                      "typing": "{{len(s.code) / tt}}",
                      "delay": 0.6,
                      "fontSize": "{{fs}}",
                      "title": "{{lang}}"
                    },
                    "x": "{{cx2}}",
                    "y": "{{cy2}}",
                    "width": "{{cw}}",
                    "height": "{{ch}}",
                    "enter": {
                      "preset": "slideLeft",
                      "duration": 0.7
                    }
                  },
                  "else": {
                    "type": "component",
                    "component": "code",
                    "props": {
                      "$merge": [
                        {
                          "code": "{{s.code}}",
                          "language": "{{lang ?? ''}}",
                          "title": "{{lang ?? ''}}",
                          "typing": "{{len(s.code) / tt}}",
                          "delay": 0.6,
                          "fontSize": "{{fs}}",
                          "glow": "{{alpha(brand.colors.primary, 0.5)}}"
                        },
                        {
                          "$if": "s.highlight",
                          "then": {
                            "highlights": [
                              {
                                "lines": "{{s.highlight}}",
                                "at": "{{0.6 + tt + 0.3}}"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "x": "{{cx2}}",
                    "y": "{{cy2}}",
                    "width": "{{cw}}",
                    "height": "{{ch}}",
                    "enter": {
                      "preset": "slideLeft",
                      "duration": 0.7
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "id": "recap",
        "transition": {
          "type": "blur",
          "duration": 0.6
        },
        "duration": "{{max(4.2, readtime(recap + ' ' + join(pick(steps, 'title'), ' ')) * 0.6 + 2)}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 31,
              "floor": true,
              "intensity": 0.36
            }
          },
          {
            "text": "{{recap}}",
            "style": "title",
            "x": "{{fmt.landscape ? fmt.safe.left : fmt.cx}}",
            "anchor": "{{fmt.landscape ? 'left' : 'bottom'}}",
            "align": "{{fmt.landscape ? 'left' : 'center'}}",
            "y": "{{fmt.landscape ? '36%' : (fmt.portrait ? '33%' : '30%')}}",
            "width": "{{fmt.landscape ? fmt.w * 0.38 : fmt.safe.w}}",
            "enter": "mask by word up"
          },
          {
            "type": "component",
            "component": "checklist",
            "props": {
              "items": "{{pick(steps, 'title')}}",
              "fontSize": "{{fmt.landscape ? fmt.u * 3.6 : fmt.u * 4}}",
              "stagger": 0.25,
              "delay": 0.4
            },
            "x": "{{fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.18 : fmt.cx}}",
            "y": "{{fmt.landscape ? '50%' : (fmt.portrait ? '53%' : '50%')}}",
            "width": "{{fmt.landscape ? fmt.w * 0.36 : fmt.safe.w * 0.8}}",
            "height": "{{fmt.landscape ? fmt.h * 0.6 : fmt.h * 0.3}}"
          },
          {
            "$if": "cta",
            "then": {
              "$use": "ctaButton",
              "with": {
                "label": "{{cta}}",
                "y": "{{fmt.landscape ? '60%' : (fmt.portrait ? '70%' : '74%')}}",
                "press": 2.2
              },
              "x": "{{fmt.landscape ? fmt.safe.left + fmt.u * 18 : '50%'}}",
              "width": "{{fmt.landscape ? fmt.u * 36 : fmt.w * 0.6}}"
            }
          },
          {
            "$if": "url",
            "then": {
              "text": "{{url}}",
              "style": "caption",
              "x": "{{fmt.landscape ? fmt.safe.left : fmt.cx}}",
              "anchor": "{{fmt.landscape ? 'left' : 'center'}}",
              "y": "{{fmt.landscape ? '72%' : (fmt.portrait ? '76%' : '81%')}}",
              "enter": {
                "preset": "fadeIn",
                "delay": 1
              }
            }
          },
          {
            "$if": "cta",
            "then": {
              "$use": "confetti",
              "with": {
                "at": 2.2,
                "ox": "{{fmt.landscape ? (fmt.safe.left + fmt.u * 18) / fmt.w : 0.5}}",
                "oy": "{{fmt.landscape ? 0.6 : (fmt.portrait ? 0.64 : 0.7)}}"
              }
            }
          }
        ]
      }
    ],
    "audio": {
      "$use": "music"
    }
  }
}