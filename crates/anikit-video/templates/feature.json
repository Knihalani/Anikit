{
  "name": "feature",
  "look": "swiss",
  "intent": { "pace": "steady", "genre": "launch" },
  "title": "Feature announcement",
  "description": "A 12–20 s spotlight on one new feature: a 'New' badge and kinetic headline beside the product in a browser (your screenshot or a generated UI), the points checking off next to it with a success toast, then a CTA that bursts into confetti.",
  "tips": ["A template gives every product the same structure, so used as-is it tends to look like every other video made from it. It works well as a fast draft that you then make this product's own: a palette from its assets, a typeface chosen for it, its real UI or object as the hero, a score whose instruments fit it. For an original film, see the `director` prompt or skills/anikit-launch-video, and `anikit-video docs taste`.", "Lines read comfortably when held for max(0.83 s, chars/15, words × 0.3) after they settle, sharp, with no blur or glow while read. If a line doesn't fit, cutting words usually works better than shrinking type.", "Show the feature working in the real UI (a screenshot), not a generated screen."],
  "duration": "12–20 s",
  "tags": [
    "feature",
    "announcement",
    "release",
    "update"
  ],
  "params": {
    "product": {
      "type": "string",
      "default": "{{brand.name}}",
      "maxWords": 3,
      "description": "Product name shown on the end card.",
      "example": "Anikit Video"
    },
    "kicker": {
      "type": "string",
      "default": "New",
      "maxWords": 3,
      "description": "Small label above the headline.",
      "example": "New in 2.0"
    },
    "headline": {
      "type": "string",
      "required": true,
      "maxWords": 7,
      "description": "The feature as a benefit, readable in 2 s.",
      "example": "Stills from any frame"
    },
    "subhead": {
      "type": "string",
      "maxWords": 14,
      "description": "One sentence that explains the headline.",
      "example": "Preview any frame instantly, straight from your agent."
    },
    "screenshot": {
      "type": "image",
      "description": "Optional screenshot (16:10). Without it, a generated product UI in the brand colours is shown.",
      "example": "screenshot.png"
    },
    "url": {
      "type": "string",
      "default": "{{brand.voice.url}}",
      "maxChars": 32,
      "description": "Address in the browser bar and on the end card.",
      "example": "anikit.dev"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "1–3 short supporting points, most important first.",
      "items": {
        "type": "string",
        "maxWords": 7
      },
      "example": [
        "Any frame, any time",
        "PNG or base64 for agents",
        "Contact sheets in one call"
      ]
    },
    "cta": {
      "type": "string",
      "default": "{{brand.voice.cta}}",
      "maxWords": 4,
      "description": "Call to action on the end card.",
      "example": "Try it now"
    },
    "music": {
      "type": "string",
      "description": "Optional music file (MP3/WAV)."
    }
  },
  "spec": {
    "size": [
      "{{fmt.w}}",
      "{{fmt.h}}"
    ],
    "fps": "{{fmt.fps}}",
    "theme": {
      "$use": "theme"
    },
    "background": "$bgDeep",
    "transition": {
      "type": "crossfade",
      "duration": 0.5
    },
    "scenes": [
      {
        "id": "intro",
        "duration": "{{readtime(headline + ' ' + (subhead ?? '')) + 2.2}}",
        "camera": {
          "animate": [
            {
              "from": {
                "zoom": 1.05
              },
              "to": {
                "zoom": 1
              },
              "duration": 0.9,
              "ease": "outExpo"
            }
          ]
        },
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 4,
              "floor": true,
              "intensity": 0.36
            }
          },
          {
            "$let": {
              "tw": "fmt.landscape ? fmt.w * 0.38 : fmt.safe.w",
              "ts": "fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4",
              "lines": "ceil(len(headline) * cw * 0.96 * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) / (fmt.landscape ? fmt.w * 0.38 : fmt.safe.w))",
              "top": "fmt.landscape ? fmt.h * 0.5 - (ceil(len(headline) * 0.48 * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) / (fmt.landscape ? fmt.w * 0.38 : fmt.safe.w)) * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) * 1.1 + fmt.u * 14) / 2 : (fmt.portrait ? fmt.h * 0.15 : fmt.h * 0.11)",
              "ax": "fmt.landscape ? fmt.safe.left : fmt.cx",
              "an": "fmt.landscape ? 'topLeft' : 'top'",
              "al": "fmt.landscape ? 'left' : 'center'"
            },
            "in": [
              {
                "type": "component",
                "component": "badge",
                "props": {
                  "label": "{{kicker ?? 'New'}}",
                  "dot": true,
                  "solid": true,
                  "size": "{{fmt.portrait ? fmt.u * 3 : fmt.u * 2.4}}",
                  "delay": 0.1
                },
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top - fmt.u * 1.5}}",
                "width": "{{fmt.u * 40}}",
                "height": "{{fmt.u * 6}}"
              },
              {
                "text": "{{headline}}",
                "style": "heading",
                "weight": 750,
                "width": "{{tw}}",
                "align": "{{al}}",
                "x": "{{ax}}",
                "anchor": "{{an}}",
                "y": "{{top + fmt.u * 4.5}}",
                "enter": "mask by word up"
              },
              {
                "$if": "subhead",
                "then": {
                  "text": "{{subhead}}",
                  "style": "subtitle",
                  "width": "{{tw * 0.95}}",
                  "align": "{{al}}",
                  "x": "{{ax}}",
                  "anchor": "{{an}}",
                  "y": "{{top + fmt.u * 4.5 + lines * ts * 1.1 + fmt.u * 2.5}}",
                  "enter": {
                    "preset": "fadeUp",
                    "delay": 0.35
                  }
                }
              }
            ]
          },
          {
            "$let": {
              "vx": "fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.25 : fmt.cx",
              "vy": "fmt.landscape ? fmt.h * 0.5 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.66)",
              "vw": "fmt.landscape ? fmt.w * 0.5 : (fmt.portrait ? fmt.safe.w : fmt.w * 0.7)"
            },
            "in": {
              "$use": "device",
              "with": {
                "kind": "browser",
                "src": "{{screenshot}}",
                "url": "{{url}}",
                "delay": 0.5,
                "x": "{{vx}}",
                "y": "{{vy}}",
                "width": "{{vw}}",
                "height": "{{vw / 1.6 + fmt.u * 6}}"
              }
            }
          },
          {
            "$use": "grain"
          }
        ]
      },
      {
        "$if": "points",
        "then": {
          "id": "points",
          "transition": {
            "type": "push",
            "direction": "{{fmt.portrait ? 'up' : 'left'}}",
            "duration": 0.6,
            "ease": "inOutQuart"
          },
          "duration": "{{readtime(join(points, ' ')) + 2.4}}",
          "camera": {
            "animate": [
              {
                "from": {
                  "zoom": 1
                },
                "to": {
                  "zoom": 1.04
                },
                "duration": 0.9,
                "ease": "outExpo"
              }
            ]
          },
          "layers": [
            {
              "$use": "backdrop",
              "with": {
                "seed": 9
              }
            },
            {
              "$let": {
                "cw": "fmt.landscape ? fmt.w * 0.4 : fmt.safe.w",
                "fs": "fmt.portrait ? fmt.u * 4.6 : fmt.u * 4.2"
              },
              "in": {
                "type": "component",
                "component": "checklist",
                "props": {
                  "items": "{{points}}",
                  "stagger": 0.35,
                  "checkAfter": 0.3,
                  "fontSize": "{{fs}}",
                  "delay": 0.3
                },
                "x": "{{fmt.landscape ? fmt.safe.left + cw / 2 : fmt.cx}}",
                "y": "{{fmt.landscape ? fmt.h * 0.5 : fmt.h * 0.25}}",
                "width": "{{cw}}",
                "height": "{{len(points) * fs * 2.4}}"
              }
            },
            {
              "$let": {
                "vx": "fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.25 : fmt.cx",
                "vy": "fmt.landscape ? fmt.h * 0.5 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.66)",
                "vw": "fmt.landscape ? fmt.w * 0.5 : (fmt.portrait ? fmt.safe.w : fmt.w * 0.7)"
              },
              "in": [
                {
                  "$use": "device",
                  "with": {
                    "kind": "browser",
                    "src": "{{screenshot}}",
                    "url": "{{url}}",
                    "delay": 0,
                    "x": "{{vx}}",
                    "y": "{{fmt.portrait ? fmt.h * 0.6 : vy}}",
                    "width": "{{vw}}",
                    "height": "{{vw / 1.6 + fmt.u * 6}}"
                  }
                },
                {
                  "type": "component",
                  "component": "toast",
                  "props": {
                    "title": "{{headline}}",
                    "kind": "success",
                    "delay": "{{0.6 + len(points) * 0.35}}",
                    "from": "{{fmt.landscape ? 'right' : 'bottom'}}",
                    "width": "{{fmt.u * 50}}"
                  },
                  "x": "{{vx}}",
                  "y": "{{(fmt.portrait ? fmt.h * 0.6 : vy) + vw * 0.3}}",
                  "width": "{{fmt.u * 54}}",
                  "height": "{{fmt.u * 14}}"
                }
              ]
            },
            {
              "$use": "grain"
            }
          ]
        }
      },
      {
        "id": "cta",
        "transition": {
          "type": "blur",
          "duration": 0.6
        },
        "duration": "{{max(3.8, readtime(product + ' ' + cta + ' ' + (url ?? '')) + 1.6)}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 31,
              "floor": true,
              "intensity": 0.42
            }
          },
          {
            "$use": "confetti",
            "with": {
              "at": 1.5,
              "oy": "{{fmt.portrait ? 0.53 : 0.58}}"
            }
          },
          {
            "$if": "brand.logo",
            "then": {
              "src": "{{brand.logo}}",
              "height": "{{fmt.u * 10}}",
              "fit": "contain",
              "y": "{{fmt.portrait ? '33%' : '28%'}}",
              "enter": "scaleIn"
            }
          },
          {
            "text": "{{product}}",
            "style": "title",
            "y": "42%",
            "width": "{{fmt.safe.w}}",
            "enter": "rise"
          },
          {
            "$use": "ctaButton",
            "with": {
              "label": "{{cta}}",
              "y": "{{fmt.portrait ? '53%' : '58%'}}",
              "press": 1.5
            }
          },
          {
            "$if": "url",
            "then": {
              "text": "{{url}}",
              "style": "caption",
              "y": "{{fmt.portrait ? '61%' : '70%'}}",
              "enter": {
                "preset": "fadeIn",
                "delay": 0.9
              }
            }
          },
          {
            "$use": "grain"
          }
        ]
      }
    ],
    "audio": {
      "$use": "music"
    }
  }
}