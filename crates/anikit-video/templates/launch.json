{
  "name": "launch",
  "title": "Product launch",
  "description": "A 15–35 s launch film on a living brand mesh: optional kinetic hook, product reveal in a browser (your screenshot or a generated UI), 2–4 split-screen feature beats (device, code editor or screenshot with a success toast), an animated proof counter with a rising chart, and a CTA button that bursts into confetti.",
  "duration": "20–35 s",
  "tags": [
    "launch",
    "product",
    "announcement",
    "hero"
  ],
  "params": {
    "product": {
      "type": "string",
      "default": "{{brand.name}}",
      "maxWords": 3,
      "description": "Product name as it should appear on screen.",
      "example": "Anikit Video"
    },
    "hook": {
      "type": "string",
      "maxWords": 7,
      "description": "Optional opening line: a tension, a promise or a surprising fact, readable in 2 s. Without it the video opens on the product reveal.",
      "example": "Video, without the browser."
    },
    "tagline": {
      "type": "string",
      "required": true,
      "maxWords": 10,
      "description": "What it is and why it matters, in one breath.",
      "example": "Programmatic video for AI agents, rendered natively."
    },
    "screenshot": {
      "type": "image",
      "description": "Optional hero screenshot (16:10). Without it, a generated product UI in the brand colours is shown."
    },
    "url": {
      "type": "string",
      "default": "{{brand.voice.url}}",
      "maxChars": 32,
      "description": "Address shown in the browser bar and on the end card.",
      "example": "anikit.dev"
    },
    "features": {
      "type": "array",
      "required": true,
      "minItems": 2,
      "maxItems": 4,
      "description": "The 2–4 strongest benefits, most important first. One idea each.",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "required": true,
            "maxWords": 5,
            "description": "Benefit, not feature: 'Renders in seconds'."
          },
          "body": {
            "type": "string",
            "maxWords": 16,
            "description": "One supporting sentence."
          },
          "image": {
            "type": "image",
            "description": "Optional screenshot for this beat. Without image or code, a generated product UI is shown."
          },
          "code": {
            "type": "text",
            "description": "Optional code snippet shown in an editor window for this beat (dev tools).",
            "maxChars": 400
          }
        }
      },
      "example": [
        {
          "title": "No headless browser",
          "body": "Native Rust, every core, no headless browser."
        },
        {
          "title": "Built for agents",
          "body": "One JSON spec, clear errors, an MCP server."
        }
      ]
    },
    "stat": {
      "type": "object",
      "description": "Optional proof point shown as a big animated number.",
      "properties": {
        "value": {
          "type": "number",
          "required": true
        },
        "prefix": {
          "type": "string",
          "maxChars": 3
        },
        "suffix": {
          "type": "string",
          "maxChars": 4
        },
        "label": {
          "type": "string",
          "required": true,
          "maxWords": 8
        }
      },
      "example": {
        "value": 76,
        "suffix": " fps",
        "label": "1080p, end to end, on a 4-core VM"
      }
    },
    "cta": {
      "type": "string",
      "default": "{{brand.voice.cta}}",
      "maxWords": 4,
      "description": "Call to action on the end card.",
      "example": "Start building"
    },
    "music": {
      "type": "string",
      "description": "Optional music file (MP3/WAV). Pick something with a clear beat around 100–124 BPM."
    }
  },
  "spec": {
    "size": [
      "{{fmt.w}}",
      "{{fmt.h}}"
    ],
    "fps": "{{fmt.fps}}",
    "theme": {
      "$use": "theme"
    },
    "background": "$bgDeep",
    "transition": {
      "type": "crossfade",
      "duration": 0.5
    },
    "scenes": [
      {
        "$if": "hook",
        "then": {
          "id": "hook",
          "duration": "{{max(2.4, readtime(hook) + 0.7 + 0.09 * words(hook))}}",
          "camera": {
            "animate": [
              {
                "from": {
                  "zoom": 1.06
                },
                "to": {
                  "zoom": 1
                },
                "duration": "{{max(2.4, readtime(hook) + 0.7)}}",
                "ease": "outCubic"
              }
            ]
          },
          "layers": [
            {
              "$use": "backdrop",
              "with": {
                "seed": 2,
                "floor": true,
                "intensity": 0.32
              }
            },
            {
              "id": "hook",
              "text": "{{hook}}",
              "style": "hero",
              "width": "{{fmt.safe.w}}",
              "enter": "mask by word up"
            },
            {
              "$use": "grain"
            }
          ]
        }
      },
      {
        "id": "reveal",
        "transition": {
          "type": "zoom",
          "duration": 0.6
        },
        "duration": "{{readtime(product + ' ' + tagline) + 2.2}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 5
            }
          },
          {
            "$if": "brand.logo",
            "then": {
              "src": "{{brand.logo}}",
              "height": "{{fmt.u * 6}}",
              "fit": "contain",
              "y": "{{fmt.portrait ? '14%' : (fmt.landscape ? '30%' : '10%')}}",
              "enter": "scaleIn",
              "x": "{{fmt.landscape ? fmt.safe.left : '50%'}}",
              "anchor": "{{fmt.landscape ? 'left' : 'center'}}"
            }
          },
          {
            "id": "name",
            "text": "{{product}}",
            "style": "title",
            "y": "{{fmt.portrait ? '22%' : (fmt.landscape ? '42%' : (brand.logo ? '19%' : '17%'))}}",
            "width": "{{fmt.landscape ? fmt.w * 0.36 : fmt.safe.w}}",
            "enter": "pop by char from center",
            "x": "{{fmt.landscape ? fmt.safe.left : '50%'}}",
            "anchor": "{{fmt.landscape ? 'left' : 'center'}}",
            "align": "{{fmt.landscape ? 'left' : 'center'}}"
          },
          {
            "id": "tagline",
            "text": "{{tagline}}",
            "style": "subtitle",
            "y": "{{fmt.portrait ? '31%' : (fmt.landscape ? '55%' : '27%')}}",
            "width": "{{fmt.landscape ? fmt.w * 0.31 : fmt.safe.w}}",
            "enter": {
              "preset": "fadeUp",
              "delay": 0.45
            },
            "x": "{{fmt.landscape ? fmt.safe.left : '50%'}}",
            "anchor": "{{fmt.landscape ? 'left' : 'center'}}",
            "align": "{{fmt.landscape ? 'left' : 'center'}}"
          },
          {
            "$use": "device",
            "with": {
              "kind": "browser",
              "src": "{{screenshot}}",
              "url": "{{url}}",
              "delay": 0.6,
              "width": "{{fmt.portrait ? fmt.safe.w : (fmt.square ? fmt.w * 0.78 : fmt.w * 0.5)}}",
              "height": "{{(fmt.portrait ? fmt.safe.w : (fmt.square ? fmt.w * 0.78 : fmt.w * 0.5)) / 1.6 + fmt.u * 6}}",
              "y": "{{fmt.portrait ? '58%' : (fmt.square ? '64%' : '50%')}}",
              "x": "{{fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.25 : '50%'}}",
              "bob": true
            }
          },
          {
            "$use": "grain"
          }
        ]
      },
      {
        "$each": "features",
        "as": "f",
        "index": "i",
        "do": {
          "id": "feature-{{i + 1}}",
          "transition": {
            "type": "push",
            "direction": "{{fmt.portrait ? 'up' : 'left'}}",
            "duration": 0.6,
            "ease": "inOutQuart"
          },
          "duration": "{{readtime(f.title + ' ' + (f.body ?? '')) + 2.0}}",
          "layers": [
            {
              "$use": "backdrop",
              "with": {
                "seed": "{{11 + i * 3}}",
                "still": true
              }
            },
            {
              "$let": {
                "tw": "fmt.landscape ? fmt.w * 0.36 : fmt.safe.w",
                "ts": "fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4",
                "lines": "ceil(len(f.title) * 0.52 * (fmt.portrait ? fmt.u * 7.4 : fmt.u * 6.4) / (fmt.landscape ? fmt.w * 0.36 : fmt.safe.w))",
                "top": "fmt.landscape ? fmt.h * 0.5 - (ceil(len(f.title) * 0.52 * fmt.u * 6.4 / (fmt.w * 0.36)) * fmt.u * 6.4 * 1.1 + fmt.u * 12) / 2 : (fmt.portrait ? fmt.h * 0.14 : fmt.h * 0.1)",
                "ax": "fmt.landscape ? fmt.safe.left : fmt.cx",
                "an": "fmt.landscape ? 'topLeft' : 'top'",
                "al": "fmt.landscape ? 'left' : 'center'"
              },
              "in": [
                {
                  "text": "{{(i + 1) < 10 ? '0' + str(i + 1) : str(i + 1)}}",
                  "style": "label",
                  "x": "{{ax}}",
                  "anchor": "{{an}}",
                  "y": "{{top}}",
                  "enter": "fadeUp"
                },
                {
                  "text": "{{f.title}}",
                  "style": "heading",
                  "weight": 750,
                  "width": "{{tw}}",
                  "align": "{{al}}",
                  "x": "{{ax}}",
                  "anchor": "{{an}}",
                  "y": "{{top + fmt.u * 4.5}}",
                  "enter": "mask by word up"
                },
                {
                  "$if": "f.body",
                  "then": {
                    "text": "{{f.body}}",
                    "style": "subtitle",
                    "width": "{{tw * 0.95}}",
                    "align": "{{al}}",
                    "x": "{{ax}}",
                    "anchor": "{{an}}",
                    "y": "{{top + fmt.u * 4.5 + lines * ts * 1.1 + fmt.u * 2.5}}",
                    "enter": {
                      "preset": "fadeUp",
                      "delay": 0.35
                    }
                  }
                }
              ]
            },
            {
              "$let": {
                "vx": "fmt.landscape ? fmt.w - fmt.safe.right - fmt.w * 0.25 : fmt.cx",
                "vy": "fmt.landscape ? fmt.h * 0.5 : (fmt.portrait ? fmt.h * 0.6 : fmt.h * 0.66)",
                "vw": "fmt.landscape ? fmt.w * 0.5 : (fmt.portrait ? fmt.safe.w : fmt.w * 0.7)"
              },
              "in": {
                "$if": "f.code",
                "then": {
                  "type": "component",
                  "component": "code",
                  "props": {
                    "code": "{{f.code}}",
                    "typing": 28,
                    "delay": 0.4,
                    "fontSize": "{{fmt.u * 2.4}}",
                    "glow": "{{brand.colors.primary}}"
                  },
                  "x": "{{vx}}",
                  "y": "{{vy}}",
                  "width": "{{vw}}",
                  "height": "{{vw * 0.62}}",
                  "enter": {
                    "preset": "slideLeft",
                    "duration": 0.8
                  }
                },
                "else": [
                  {
                    "$use": "device",
                    "with": {
                      "kind": "{{f.image || i % 2 == 0 ? 'browser' : 'phone'}}",
                      "screen": "{{stat && i == 0 ? 'dashboard' : ['app', 'feed', 'settings', 'chat'][i % 4]}}",
                      "src": "{{f.image}}",
                      "url": "{{url}}",
                      "x": "{{vx}}",
                      "y": "{{vy}}",
                      "width": "{{vw}}",
                      "height": "{{f.image || i % 2 == 0 ? (fmt.landscape ? vw * 0.72 : vw * 0.78) : (fmt.portrait ? fmt.h * 0.44 : fmt.h * 0.8)}}",
                      "delay": 0.3,
                      "still": true,
                      "kpis": "{{stat ? [obj('label', stat.label, 'value', (stat.prefix ?? '') + str(stat.value) + (stat.suffix ?? ''))] : null}}"
                    }
                  },
                  {
                    "type": "component",
                    "component": "toast",
                    "props": {
                      "title": "{{f.title}}",
                      "kind": "success",
                      "delay": 1.2,
                      "from": "{{fmt.landscape ? 'right' : 'bottom'}}",
                      "width": "{{fmt.u * 46}}"
                    },
                    "x": "{{vx}}",
                    "y": "{{vy + vw * (fmt.landscape ? 0.26 : 0.3)}}",
                    "width": "{{fmt.u * 50}}",
                    "height": "{{fmt.u * 14}}"
                  }
                ]
              }
            },
            {
              "$use": "grain"
            }
          ]
        }
      },
      {
        "$if": "stat",
        "then": {
          "id": "proof",
          "transition": {
            "type": "blur",
            "duration": 0.5
          },
          "duration": "{{readtime(stat.label) + 2.4}}",
          "layers": [
            {
              "$use": "backdrop",
              "with": {
                "seed": 21,
                "intensity": 0.45,
                "still": true
              }
            },
            {
              "type": "component",
              "component": "counter",
              "props": {
                "to": "{{stat.value}}",
                "prefix": "{{stat.prefix ?? ''}}",
                "suffix": "{{stat.suffix ?? ''}}",
                "size": "{{fmt.portrait ? fmt.u * 24 : fmt.u * 22}}",
                "weight": 800,
                "gradient": [
                  "{{brand.colors.text}}",
                  "{{mix(brand.colors.text, brand.colors.primary, 0.55)}}"
                ],
                "duration": 1.6
              },
              "y": "42%",
              "width": "{{fmt.safe.w}}",
              "height": "{{fmt.u * 30}}"
            },
            {
              "text": "{{stat.label}}",
              "style": "subtitle",
              "y": "{{fmt.portrait ? '56%' : '62%'}}",
              "width": "{{fmt.safe.w}}",
              "enter": {
                "preset": "fadeUp",
                "delay": 0.8
              }
            },
            {
              "type": "component",
              "component": "area-chart",
              "props": {
                "series": [
                  [
                    2,
                    3,
                    3,
                    5,
                    4,
                    7,
                    9,
                    14
                  ]
                ],
                "grid": false,
                "endLabel": false,
                "delay": 0.4,
                "duration": 1.6,
                "width": "{{fmt.u * 0.6}}",
                "colors": [
                  "{{brand.colors.secondary}}"
                ]
              },
              "y": "{{fmt.portrait ? '72%' : '82%'}}",
              "width": "{{fmt.safe.w}}",
              "height": "{{fmt.u * 16}}",
              "opacity": 0.9
            },
            {
              "$use": "grain"
            }
          ]
        }
      },
      {
        "id": "cta",
        "transition": {
          "type": "blur",
          "duration": 0.6
        },
        "duration": "{{max(3.8, readtime(product + ' ' + cta + ' ' + (url ?? '')) + 1.6)}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 31,
              "floor": true,
              "intensity": 0.42
            }
          },
          {
            "$if": "brand.logo",
            "then": {
              "src": "{{brand.logo}}",
              "height": "{{fmt.u * 10}}",
              "fit": "contain",
              "y": "{{fmt.portrait ? '33%' : '28%'}}",
              "enter": "scaleIn"
            }
          },
          {
            "text": "{{product}}",
            "style": "title",
            "y": "{{fmt.portrait ? '42%' : '42%'}}",
            "width": "{{fmt.safe.w}}",
            "enter": "rise"
          },
          {
            "$use": "ctaButton",
            "with": {
              "label": "{{cta}}",
              "y": "{{fmt.portrait ? '53%' : '58%'}}",
              "press": 1.5
            }
          },
          {
            "$if": "url",
            "then": {
              "text": "{{url}}",
              "style": "caption",
              "y": "{{fmt.portrait ? '61%' : '70%'}}",
              "enter": {
                "preset": "fadeIn",
                "delay": 0.9
              }
            }
          },
          {
            "$use": "confetti",
            "with": {
              "at": 1.5,
              "oy": "{{fmt.portrait ? 0.53 : 0.58}}"
            }
          },
          {
            "$use": "grain"
          }
        ]
      }
    ],
    "audio": {
      "$use": "music"
    }
  }
}