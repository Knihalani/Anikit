{
  "name": "teaser",
  "title": "Social teaser (9:16 first)",
  "description": "A 6–12 s vertical teaser for Reels, TikTok and Shorts: rapid kinetic words, one per beat, in huge type with punch-in camera hits and colour flashes, ending on the logo and a payoff line. Also works in 16:9 and 1:1.",
  "duration": "6–12 s",
  "tags": ["teaser", "social", "vertical", "reels", "tiktok", "shorts", "kinetic"],
  "params": {
    "words": {
      "type": "array", "required": true, "minItems": 3, "maxItems": 10,
      "description": "The beats, in order: one to three words each. Together they read as one sentence or a rhythm ('Faster.' 'Smaller.' 'Native.').",
      "items": { "type": "string", "maxWords": 3, "maxChars": 18 },
      "example": ["No browser.", "No waiting.", "Just", "JSON", "in.", "Video", "out."]
    },
    "beat": { "type": "seconds", "default": 0.6, "minimum": 0.35, "maximum": 1.2, "description": "Seconds per one-word beat (two- and three-word beats get 1.5×). 0.5–0.65 feels energetic; match it to the music (60 / BPM × 1 or × 2).", "example": 0.6 },
    "payoff": { "type": "string", "maxWords": 6, "description": "Line under the logo at the end: a date, a URL or a call to action.", "example": "Out now · anikit.dev" },
    "flash": { "type": "boolean", "default": true, "description": "Flash every third beat to the brand colour for energy.", "example": true },
    "music": { "type": "string", "description": "Optional music file; a strong beat is what makes a teaser work." }
  },
  "spec": {
    "size": ["{{fmt.w}}", "{{fmt.h}}"],
    "fps": "{{fmt.fps}}",
    "theme": { "$use": "theme" },
    "background": "$bg",
    "transition": "cut",
    "scenes": [
      {
        "$each": "words", "as": "w", "index": "i",
        "do": {
          "$let": { "hot": "flash && i % 3 == 2", "d": "len(split(w, '')) > 1 ? beat * 1.5 : beat" },
          "in": {
            "id": "beat-{{i + 1}}",
            "duration": "{{d}}",
            "background": "{{hot ? 'linear-gradient(135deg, ' + brand.colors.primary + ', ' + brand.colors.secondary + ')' : 'radial-gradient(circle at 50% 45%, ' + brand.colors.surface + ', ' + brand.colors.background + ')'}}",
            "camera": { "animate": [ { "from": { "zoom": "{{i % 2 ? 1.14 : 1.08}}", "rotation": "{{i % 2 ? -1.2 : 1.2}}" }, "to": { "zoom": 1, "rotation": 0 }, "duration": "{{d}}", "ease": "outExpo" } ] },
            "layers": [
              { "$if": "!hot", "then": { "$use": "glows", "with": { "strength": 0.7, "gx": "{{i % 2 ? '85%' : '15%'}}", "gy": "{{i % 2 ? '80%' : '20%'}}" } } },
              {
                "id": "word-{{i + 1}}", "text": "{{w}}", "style": "hero",
                "size": "{{len(w) <= 6 ? (fmt.portrait ? '22vmin' : '18vmin') : len(w) <= 11 ? (fmt.portrait ? '16vmin' : '14vmin') : (fmt.portrait ? '12vmin' : '11vmin')}}",
                "width": "{{fmt.safe.w}}",
                "color": "{{hot ? '$onPrimary' : '$text'}}",
                "enter": { "preset": "{{i % 3 == 0 ? 'zoomIn' : i % 3 == 1 ? 'fadeUp' : 'popIn'}}", "duration": "{{min(0.45, beat * 0.7)}}", "ease": "outExpo" }
              }
            ]
          }
        }
      },
      {
        "id": "logo",
        "transition": { "type": "zoom", "duration": 0.35 },
        "duration": "{{payoff ? max(2.4, readtime(payoff) + 0.9) : 2.2}}",
        "background": "radial-gradient(circle at 50% 45%, $surface, $bgDeep)",
        "camera": { "animate": [ { "from": { "zoom": 1.1 }, "to": { "zoom": 1 }, "duration": 2.4, "ease": "outExpo" } ] },
        "layers": [
          { "$use": "glows", "with": { "gx": "50%", "gy": "42%", "strength": 1 } },
          { "$use": "wordmark", "with": { "y": "{{payoff ? '45%' : '50%'}}", "height": "{{fmt.u * 16}}", "enter": "popIn" } },
          { "$if": "payoff", "then": { "id": "payoff", "text": "{{payoff}}", "style": "subtitle", "y": "{{fmt.portrait ? '56%' : '62%'}}", "width": "{{fmt.safe.w}}", "enter": { "preset": "fadeUp", "delay": 0.35 } } }
        ]
      }
    ],
    "audio": { "$use": "music" }
  }
}
