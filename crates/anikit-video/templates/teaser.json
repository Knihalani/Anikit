{
  "name": "teaser",
  "title": "Social teaser (9:16 first)",
  "description": "A 6–12 s vertical teaser for Reels, TikTok and Shorts: one word per beat in huge uppercase type with camera punches, palette-flip frames in the brand colour, kinetic dot fields and metaballs, a beat counter, optional phrase captions, and a particle wordmark payoff.",
  "duration": "6–12 s",
  "tags": [
    "teaser",
    "social",
    "vertical",
    "reels",
    "tiktok",
    "shorts",
    "kinetic"
  ],
  "params": {
    "words": {
      "type": "array",
      "required": true,
      "minItems": 3,
      "maxItems": 10,
      "description": "The beats, in order: one to three words each. Together they read as one sentence or a rhythm ('Faster.' 'Smaller.' 'Native.').",
      "items": {
        "type": "string",
        "maxWords": 3,
        "maxChars": 18
      },
      "example": [
        "No browser.",
        "No waiting.",
        "Just",
        "JSON",
        "in.",
        "Video",
        "out."
      ]
    },
    "beat": {
      "type": "seconds",
      "default": 0.6,
      "minimum": 0.6,
      "maximum": 1.2,
      "description": "Seconds per one-word beat (two- and three-word beats get 1.5×). 0.6–0.7 feels energetic and stays readable; match it to the music (60 / BPM × 1 or × 2).",
      "example": 0.6
    },
    "payoff": {
      "type": "string",
      "maxWords": 6,
      "description": "Line under the logo at the end: a date, a URL or a call to action.",
      "example": "Out now · anikit.dev"
    },
    "flash": {
      "type": "boolean",
      "default": true,
      "description": "Flip every third beat to a full-bleed brand-colour frame (the palette flip) for energy.",
      "example": true
    },
    "music": {
      "type": "string",
      "description": "Optional music file; a strong beat is what makes a teaser work."
    },
    "captions": {
      "type": "any",
      "description": "Optional burned-in captions. true: one caption per phrase (beats grouped at . ! ? or every 4), each ending before the next starts. Or a list of {text, at, end} cues in seconds (e.g. for a voice-over), or {\"src\": \"subs.srt\"}. The beat words are already on screen, so captions matter most with a voice-over."
    }
  },
  "spec": {
    "size": [
      "{{fmt.w}}",
      "{{fmt.h}}"
    ],
    "fps": "{{fmt.fps}}",
    "theme": {
      "$use": "theme"
    },
    "background": "$bgDeep",
    "transition": "cut",
    "scenes": [
      {
        "$each": "words",
        "as": "w",
        "index": "i",
        "do": {
          "$if": "!(last && (upper(trim(w)) == upper(brand.name) || upper(trim(w)) == upper(brand.name) + '.' || upper(trim(w)) == upper(brand.name) + '!'))",
          "then": {
            "$let": {
              "hot": "flash && i % 3 == 2",
              "d": "(len(split(w, '')) > 1 ? beat * 1.5 : max(beat, 0.8)) * (last ? 1.6 : 1)"
            },
            "in": {
              "id": "beat-{{i + 1}}",
              "duration": "{{d}}",
              "background": "{{hot ? brand.colors.fill : '$bgDeep'}}",
              "transition": "cut",
              "camera": {
                "animate": [
                  {
                    "from": {
                      "zoom": "{{i % 2 ? 1.14 : 1.08}}",
                      "rotation": "{{i % 2 ? -1.2 : 1.2}}"
                    },
                    "to": {
                      "zoom": 1,
                      "rotation": 0
                    },
                    "duration": 0.9,
                    "ease": "outExpo"
                  }
                ]
              },
              "layers": [
                {
                  "$if": "!hot",
                  "then": [
                    {
                      "$use": "backdrop",
                      "with": {
                        "seed": "{{3 + i * 7}}",
                        "intensity": 0.26,
                        "still": true
                      }
                    },
                    {
                      "type": "component",
                      "component": "kinetic-grid",
                      "props": {
                        "shape": "dot",
                        "wave": "radial",
                        "colors": [
                          "{{brand.colors.primary}}",
                          "{{brand.colors.secondary}}"
                        ],
                        "speed": 2,
                        "cols": "{{fmt.portrait ? 20 : 30}}",
                        "step": "{{beat}}"
                      },
                      "opacity": 0.05
                    }
                  ],
                  "else": {
                    "type": "component",
                    "component": "kinetic-grid",
                    "props": {
                      "shape": "dot",
                      "wave": "radial",
                      "colors": [
                        "{{mix(brand.colors.primary, '#000000', 0.25)}}",
                        "{{mix(brand.colors.primary, '#FFFFFF', 0.2)}}"
                      ],
                      "speed": 2,
                      "cols": "{{fmt.portrait ? 20 : 30}}",
                      "step": "{{beat}}"
                    },
                    "opacity": 0.12
                  }
                },
                {
                  "$if": "i % 4 == 1 && !hot",
                  "then": {
                    "type": "component",
                    "component": "metaballs",
                    "props": {
                      "colors": [
                        "{{brand.colors.primary}}",
                        "{{brand.colors.secondary}}"
                      ],
                      "seed": "{{i}}"
                    },
                    "y": "{{fmt.portrait ? '88%' : '86%'}}",
                    "width": "{{fmt.portrait ? fmt.w * 0.9 : fmt.w * 0.5}}",
                    "height": "{{fmt.portrait ? fmt.h * 0.22 : fmt.h * 0.3}}",
                    "opacity": 0.3
                  }
                },
                {
                  "text": "{{((i + 1) < 10 ? '0' + str(i + 1) : str(i + 1)) + ' / ' + ((len(words) - ((upper(trim(words[-1])) == upper(brand.name) || upper(trim(words[-1])) == upper(brand.name) + '.' || upper(trim(words[-1])) == upper(brand.name) + '!') ? 1 : 0)) < 10 ? '0' + str(len(words) - ((upper(trim(words[-1])) == upper(brand.name) || upper(trim(words[-1])) == upper(brand.name) + '.' || upper(trim(words[-1])) == upper(brand.name) + '!') ? 1 : 0)) : str(len(words) - ((upper(trim(words[-1])) == upper(brand.name) || upper(trim(words[-1])) == upper(brand.name) + '.' || upper(trim(words[-1])) == upper(brand.name) + '!') ? 1 : 0)))}}",
                  "font": "$mono",
                  "size": "{{fmt.portrait ? fmt.u * 3.2 : fmt.u * 2.6}}",
                  "weight": 600,
                  "letterSpacing": "0.12em",
                  "color": "{{hot ? alpha('#FFFFFF', 0.8) : alpha(brand.colors.text, 0.75)}}",
                  "y": "{{fmt.safe.top + fmt.u * 2}}"
                },
                {
                  "id": "word-{{i + 1}}",
                  "text": "{{upper(w)}}",
                  "style": "hero",
                  "weight": 900,
                  "letterSpacing": "-0.04em",
                  "lineHeight": 0.95,
                  "size": "{{len(w) <= 6 ? (fmt.portrait ? '24vmin' : '19vmin') : len(w) <= 11 ? (fmt.portrait ? '17vmin' : '15vmin') : (fmt.portrait ? '13vmin' : '12vmin')}}",
                  "width": "{{fmt.safe.w}}",
                  "color": "{{hot ? '#FFFFFF' : '$text'}}",
                  "enter": "{{i % 3 == 0 ? 'pop by char from center 0.35s 25ms outBack' : i % 3 == 1 ? 'mask by word up' : 'rise by char 0.4s 20ms'}}"
                }
              ]
            }
          }
        }
      },
      {
        "id": "logo",
        "transition": {
          "type": "zoom",
          "duration": 0.3
        },
        "duration": "{{payoff ? max(2.8, readtime(payoff) + 1.2) : 2.6}}",
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 41,
              "intensity": 0.22
            }
          },
          {
            "type": "component",
            "component": "sparks",
            "props": {
              "bursts": [
                0.1
              ],
              "origin": [
                0.5,
                "{{payoff ? 0.44 : 0.5}}"
              ],
              "count": 110,
              "colors": [
                "{{brand.colors.accent}}",
                "{{brand.colors.primary}}"
              ],
              "power": 1.2,
              "seed": 3
            }
          },
          {
            "type": "component",
            "component": "kinetic-grid",
            "props": {
              "shape": "dot",
              "wave": "radial",
              "colors": [
                "{{brand.colors.primary}}",
                "{{brand.colors.secondary}}"
              ],
              "speed": 1.5,
              "cols": "{{fmt.portrait ? 20 : 30}}",
              "step": "{{beat}}"
            },
            "opacity": 0.06
          },
          {
            "$if": "brand.logo",
            "then": {
              "src": "{{brand.logo}}",
              "height": "{{fmt.u * 16}}",
              "fit": "contain",
              "y": "{{payoff ? '44%' : '50%'}}",
              "enter": "popIn"
            },
            "else": [
              {
                "type": "component",
                "component": "particle-text",
                "props": {
                  "text": "{{upper(brand.name)}}",
                  "colors": [
                    "{{brand.colors.text}}",
                    "{{brand.colors.text}}",
                    "{{brand.colors.primary}}"
                  ],
                  "fontSize": "{{fmt.portrait ? fmt.u * 20 : fmt.u * 17}}",
                  "weight": 900,
                  "seed": 7,
                  "glow": true,
                  "form": 1.0,
                  "hold": 0.3,
                  "exit": "fade",
                  "exitTime": 0.5,
                  "count": 5000
                },
                "y": "{{payoff ? '44%' : '50%'}}",
                "width": "{{fmt.safe.w}}",
                "height": "{{fmt.u * 30}}"
              },
              {
                "text": "{{upper(brand.name)}}",
                "style": "hero",
                "weight": 900,
                "letterSpacing": "-0.04em",
                "size": "{{fmt.portrait ? fmt.u * 20 : fmt.u * 17}}",
                "y": "{{payoff ? '44%' : '50%'}}",
                "width": "{{fmt.safe.w}}",
                "glow": {
                  "radius": "{{fmt.u * 3}}",
                  "intensity": 0.7,
                  "color": "{{brand.colors.primary}}"
                },
                "enter": {
                  "preset": "fadeIn",
                  "delay": 1.2,
                  "duration": 0.5
                }
              }
            ]
          },
          {
            "$if": "payoff",
            "then": {
              "id": "payoff",
              "text": "{{upper(payoff)}}",
              "style": "label",
              "size": "{{fmt.portrait ? fmt.u * 4 : fmt.u * 3.2}}",
              "color": "$text",
              "letterSpacing": "0.16em",
              "y": "{{fmt.portrait ? '56%' : '61%'}}",
              "width": "{{fmt.safe.w}}",
              "enter": {
                "preset": "fadeUp",
                "delay": 0.6
              }
            }
          }
        ]
      }
    ],
    "audio": {
      "$use": "music"
    },
    "captions": {
      "$if": "captions == true",
      "then": {
        "$let": {
          "durs": {
            "$each": "words",
            "as": "w",
            "index": "i",
            "do": "{{(len(split(w, '')) > 1 ? beat * 1.5 : max(beat, 0.8)) * (last ? 1.6 : 1)}}"
          }
        },
        "in": {
          "$merge": [
            {
              "y": "{{fmt.portrait ? fmt.h * 0.76 : fmt.h * 0.86}}",
              "style": "subtitle",
              "color": "{{brand.colors.text}}",
              "background": "{{alpha(brand.colors.backgroundDeep, 0.6)}}",
              "highlight": "{{brand.colors.accent}}",
              "size": "{{fmt.portrait ? '4.6vmin' : '3.4vmin'}}"
            },
            {
              "cues": {
                "$each": "phrases(words)",
                "as": "ph",
                "index": "pi",
                "do": {
                  "text": "{{join(slice(words, ph[0], ph[1]), ' ')}}",
                  "at": "{{sum(slice(durs, 0, ph[0])) + 0.05}}",
                  "end": "{{sum(slice(durs, 0, ph[1])) - 0.08}}"
                }
              }
            }
          ]
        }
      },
      "else": {
        "$if": "captions",
        "then": {
          "$merge": [
            {
              "y": "{{fmt.portrait ? fmt.h * 0.76 : fmt.h * 0.86}}",
              "style": "subtitle",
              "color": "{{brand.colors.text}}",
              "background": "{{alpha(brand.colors.backgroundDeep, 0.6)}}",
              "highlight": "{{brand.colors.accent}}",
              "size": "{{fmt.portrait ? '4.6vmin' : '3.4vmin'}}"
            },
            {
              "$if": "captions.src",
              "then": {
                "src": "{{captions.src}}"
              },
              "else": {
                "cues": "{{captions}}"
              }
            }
          ]
        }
      }
    }
  }
}