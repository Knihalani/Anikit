{
  "name": "teaser",
  "title": "Social teaser (9:16 first)",
  "description": "A 6–12 s vertical teaser for Reels, TikTok and Shorts: one word per beat in huge kinetic type (pop, scramble, mask) on a living brand mesh, with punch-in camera hits, brand-colour flashes and glitch cuts, ending on the logo with a starfield and a burst of sparks.",
  "duration": "6–12 s",
  "tags": [
    "teaser",
    "social",
    "vertical",
    "reels",
    "tiktok",
    "shorts",
    "kinetic"
  ],
  "params": {
    "words": {
      "type": "array",
      "required": true,
      "minItems": 3,
      "maxItems": 10,
      "description": "The beats, in order: one to three words each. Together they read as one sentence or a rhythm ('Faster.' 'Smaller.' 'Native.').",
      "items": {
        "type": "string",
        "maxWords": 3,
        "maxChars": 18
      },
      "example": [
        "No browser.",
        "No waiting.",
        "Just",
        "JSON",
        "in.",
        "Video",
        "out."
      ]
    },
    "beat": {
      "type": "seconds",
      "default": 0.6,
      "minimum": 0.35,
      "maximum": 1.2,
      "description": "Seconds per one-word beat (two- and three-word beats get 1.5×). 0.5–0.65 feels energetic; match it to the music (60 / BPM × 1 or × 2).",
      "example": 0.6
    },
    "payoff": {
      "type": "string",
      "maxWords": 6,
      "description": "Line under the logo at the end: a date, a URL or a call to action.",
      "example": "Out now · anikit.dev"
    },
    "flash": {
      "type": "boolean",
      "default": true,
      "description": "Flash every third beat to the brand colour for energy.",
      "example": true
    },
    "music": {
      "type": "string",
      "description": "Optional music file; a strong beat is what makes a teaser work."
    },
    "captions": {
      "type": "any",
      "description": "Optional burned-in captions. true: a caption line timed to each beat (the running phrase), for sound-off viewing. Or a list of {text, at, end} cues in seconds (e.g. for a voice-over), or {\"src\": \"subs.srt\"}.",
      "example": true
    }
  },
  "spec": {
    "size": [
      "{{fmt.w}}",
      "{{fmt.h}}"
    ],
    "fps": "{{fmt.fps}}",
    "theme": {
      "$use": "theme"
    },
    "background": "$bgDeep",
    "transition": "cut",
    "scenes": [
      {
        "$each": "words",
        "as": "w",
        "index": "i",
        "do": {
          "$let": {
            "hot": "flash && i % 3 == 2",
            "d": "(len(split(w, '')) > 1 ? beat * 1.5 : max(beat, 0.8)) * (last ? 1.6 : 1)"
          },
          "in": {
            "id": "beat-{{i + 1}}",
            "duration": "{{d}}",
            "background": "{{hot ? 'linear-gradient(135deg, ' + brand.colors.primary + ', ' + brand.colors.secondary + ')' : '$bgDeep'}}",
            "transition": {
              "$if": "i > 0 && i % 3 == 0",
              "then": {
                "type": "glitch",
                "duration": 0.2
              },
              "else": "cut"
            },
            "camera": {
              "animate": [
                {
                  "from": {
                    "zoom": "{{i % 2 ? 1.16 : 1.1}}",
                    "rotation": "{{i % 2 ? -1.5 : 1.5}}"
                  },
                  "to": {
                    "zoom": 1,
                    "rotation": 0
                  },
                  "duration": "{{d}}",
                  "ease": "outExpo"
                }
              ]
            },
            "layers": [
              {
                "$if": "!hot",
                "then": {
                  "$use": "backdrop",
                  "with": {
                    "seed": "{{3 + i * 7}}",
                    "intensity": 0.3
                  }
                }
              },
              {
                "id": "word-{{i + 1}}",
                "text": "{{w}}",
                "style": "hero",
                "size": "{{len(w) <= 6 ? (fmt.portrait ? '22vmin' : '18vmin') : len(w) <= 11 ? (fmt.portrait ? '16vmin' : '14vmin') : (fmt.portrait ? '12vmin' : '11vmin')}}",
                "width": "{{fmt.safe.w}}",
                "color": "{{hot ? '$onPrimary' : '$text'}}",
                "enter": "{{i % 3 == 0 ? 'pop by char from center 0.35s 25ms outBack' : i % 3 == 1 ? 'scramble 0.3s' : 'mask by word up'}}"
              },
              {
                "$use": "grain"
              }
            ]
          }
        }
      },
      {
        "id": "logo",
        "transition": {
          "type": "zoom",
          "duration": 0.3
        },
        "duration": "{{payoff ? max(2.6, readtime(payoff) + 1.0) : 2.4}}",
        "camera": {
          "animate": [
            {
              "from": {
                "zoom": 1.12
              },
              "to": {
                "zoom": 1
              },
              "duration": 2.4,
              "ease": "outExpo"
            }
          ]
        },
        "layers": [
          {
            "$use": "backdrop",
            "with": {
              "seed": 41,
              "intensity": 0.35
            }
          },
          {
            "type": "component",
            "component": "starfield",
            "props": {
              "count": 220,
              "fly": true,
              "color": "{{brand.colors.text}}",
              "seed": 5
            },
            "opacity": 0.7
          },
          {
            "type": "component",
            "component": "sparks",
            "props": {
              "bursts": [
                0.15
              ],
              "origin": [
                0.5,
                "{{payoff ? 0.45 : 0.5}}"
              ],
              "count": 90,
              "colors": [
                "{{brand.colors.accent}}",
                "{{brand.colors.primary}}"
              ],
              "power": 1.1,
              "seed": 3
            }
          },
          {
            "$if": "brand.logo",
            "then": {
              "src": "{{brand.logo}}",
              "height": "{{fmt.u * 16}}",
              "fit": "contain",
              "y": "{{payoff ? '45%' : '50%'}}",
              "enter": "popIn"
            },
            "else": {
              "id": "name",
              "text": "{{brand.name}}",
              "style": "hero",
              "width": "{{fmt.safe.w}}",
              "y": "{{payoff ? '45%' : '50%'}}",
              "enter": "pop by char from center"
            }
          },
          {
            "$if": "payoff",
            "then": {
              "id": "payoff",
              "text": "{{payoff}}",
              "style": "subtitle",
              "y": "{{fmt.portrait ? '55%' : '60%'}}",
              "width": "{{fmt.safe.w}}",
              "enter": {
                "preset": "fadeUp",
                "delay": 0.35
              }
            }
          },
          {
            "$use": "grain"
          }
        ]
      }
    ],
    "audio": {
      "$use": "music"
    },
    "captions": {
      "$if": "captions == true",
      "then": {
        "$let": {
          "durs": {
            "$each": "words",
            "as": "w",
            "index": "i",
            "do": "{{(len(split(w, '')) > 1 ? beat * 1.5 : max(beat, 0.8)) * (last ? 1.6 : 1)}}"
          }
        },
        "in": {
          "cues": {
            "$each": "words",
            "as": "w",
            "index": "i",
            "do": {
              "text": "{{join(slice(words, i - i % 3, i + 1), ' ')}}",
              "at": "{{sum(slice(durs, 0, i)) - 0.2 * floor(i / 3)}}",
              "end": "{{sum(slice(durs, 0, i + 1)) - 0.2 * floor(i / 3)}}"
            }
          },
          "y": "{{fmt.portrait ? fmt.h * 0.74 : fmt.h * 0.86}}",
          "style": "subtitle",
          "color": "{{brand.colors.text}}",
          "background": "{{alpha(brand.colors.backgroundDeep, 0.55)}}",
          "highlight": "{{brand.colors.accent}}"
        }
      },
      "else": {
        "$if": "captions",
        "then": {
          "$merge": [
            {
              "y": "{{fmt.portrait ? fmt.h * 0.74 : fmt.h * 0.86}}",
              "style": "subtitle",
              "color": "{{brand.colors.text}}",
              "background": "{{alpha(brand.colors.backgroundDeep, 0.55)}}",
              "highlight": "{{brand.colors.accent}}"
            },
            {
              "$if": "captions.src",
              "then": {
                "src": "{{captions.src}}"
              },
              "else": {
                "cues": "{{captions}}"
              }
            }
          ]
        }
      }
    }
  }
}