{
  "name": "logo-reveal",
  "look": "noir",
  "intent": { "pace": "calm", "genre": "brand-film" },
  "title": "Logo reveal / intro",
  "description": "A 3–6 s brand sting: a chrome 3D wordmark (or your logo) revealed with god rays and a lens flare (glow), dropping in with sparks (draw), assembled from particles (assemble), or matte and calm (minimal), plus an optional tagline.",
  "tips": ["A template gives every product the same structure, so used as-is it tends to look like every other video made from it. It works well as a fast draft that you then make this product's own: a palette from its assets, a typeface chosen for it, its real UI or object as the hero, a score whose instruments fit it. For an original film, see the `director` prompt or skills/anikit-launch-video, and `anikit-video docs taste`.", "Lines read comfortably when held for max(0.83 s, chars/15, words × 0.3) after they settle, sharp, with no blur or glow while read. If a line doesn't fit, cutting words usually works better than shrinking type.", "Chrome with god rays and a lens flare tends to read as the default 3D sting. `minimal`, or a reveal built from the brand's own shape, usually feels more specific, unless the brand really is chrome."],
  "duration": "3–6 s",
  "tags": [
    "logo",
    "intro",
    "outro",
    "sting",
    "brand"
  ],
  "params": {
    "style": {
      "type": "enum",
      "values": [
        "glow",
        "draw",
        "assemble",
        "minimal"
      ],
      "default": "glow",
      "description": "glow: light bloom and a passing streak. draw: lines draw on and frame the mark. assemble: pieces converge (letters for a wordmark). minimal: a clean fade with an accent underline.",
      "example": "glow"
    },
    "name": {
      "type": "string",
      "default": "{{brand.name}}",
      "maxWords": 3,
      "description": "Wordmark text, used when the brand kit has no logo.",
      "example": "Anikit"
    },
    "tagline": {
      "type": "string",
      "maxWords": 8,
      "description": "Optional line under the logo.",
      "example": "Motion, compiled."
    },
    "duration": {
      "type": "seconds",
      "default": 4,
      "minimum": 3,
      "maximum": 6,
      "description": "Total length in seconds.",
      "example": 4
    },
    "music": {
      "type": "string",
      "description": "Optional sting or whoosh sound."
    }
  },
  "defs": {
    "mark": {
      "$if": "brand.logo",
      "then": {
        "id": "logo",
        "src": "{{brand.logo}}",
        "height": "{{fmt.u * 16}}",
        "fit": "contain",
        "y": "{{markY}}",
        "enter": {
          "preset": "{{enter}}",
          "delay": "{{delay}}",
          "duration": "{{dur ?? 0.9}}",
          "ease": "outExpo"
        }
      },
      "else": {
        "id": "wordmark",
        "text": "{{name}}",
        "style": "title",
        "size": "{{min(fmt.u * (fmt.portrait ? 14 : 13), fmt.safe.w / (max(len(name), 4) * 0.58))}}",
        "y": "{{markY}}",
        "enter": {
          "preset": "{{enter}}",
          "delay": "{{delay}}",
          "duration": "{{dur ?? 0.9}}",
          "ease": "outExpo"
        }
      }
    }
  },
  "spec": {
    "size": [
      "{{fmt.w}}",
      "{{fmt.h}}"
    ],
    "fps": "{{fmt.fps}}",
    "theme": {
      "$use": "theme"
    },
    "background": "$bgDeep",
    "scenes": [
      {
        "id": "reveal",
        "duration": "{{duration}}",
        "camera": {
          "animate": [
            {
              "from": {
                "zoom": 1.08
              },
              "to": {
                "zoom": 1
              },
              "duration": 0.9,
              "ease": "outExpo"
            }
          ]
        },
        "layers": [
          {
            "$if": "style == 'glow'",
            "then": [
              {
                "$use": "backdrop",
                "with": {
                  "seed": 2,
                  "intensity": 0.25
                }
              },
              {
                "type": "component",
                "component": "god-rays",
                "props": {
                  "color": "{{brand.colors.primary}}"
                },
                "opacity": 0.9
              },
              {
                "$if": "brand.logo",
                "then": {
                  "src": "{{brand.logo}}",
                  "height": "{{fmt.u * 22}}",
                  "fit": "contain",
                  "y": "{{tagline ? (fmt.portrait ? '45%' : '44%') : '50%'}}",
                  "enter": {
                    "preset": "zoomIn",
                    "delay": 0.15,
                    "duration": 0.9
                  }
                },
                "else": {
                  "type": "component",
                  "component": "text-3d",
                  "props": {
                    "text": "{{upper(name)}}",
                    "gradient": [
                      "{{lighten(brand.colors.primary, 0.25)}}",
                      "{{brand.colors.secondary}}"
                    ],
                    "intro": "rise",
                    "delay": 0.15
                  },
                  "y": "{{tagline ? (fmt.portrait ? '45%' : '44%') : '50%'}}",
                  "width": "{{fmt.safe.w}}",
                  "height": "{{fmt.portrait ? fmt.u * 30 : fmt.u * 34}}"
                }
              },
              {
                "type": "component",
                "component": "lens-flare",
                "props": {
                  "path": [
                    [
                      0.62,
                      0.3
                    ],
                    [
                      0.8,
                      0.4
                    ]
                  ],
                  "times": [
                    0.6,
                    3.5
                  ]
                }
              },
              {
                "$if": "tagline",
                "then": {
                  "id": "tagline",
                  "text": "{{tagline}}",
                  "style": "subtitle",
                  "y": "{{fmt.portrait ? '58%' : '64%'}}",
                  "width": "{{fmt.safe.w}}",
                  "enter": {
                    "preset": "fadeUp",
                    "delay": "{{duration * 0.28}}"
                  }
                }
              }
            ]
          },
          {
            "$if": "style == 'draw'",
            "then": [
              {
                "$use": "backdrop",
                "with": {
                  "seed": 6,
                  "floor": true,
                  "intensity": 0.3
                }
              },
              {
                "$if": "brand.logo",
                "then": {
                  "src": "{{brand.logo}}",
                  "height": "{{fmt.u * 22}}",
                  "fit": "contain",
                  "y": "{{tagline ? (fmt.portrait ? '45%' : '44%') : '50%'}}",
                  "enter": {
                    "preset": "zoomIn",
                    "delay": 0.2,
                    "duration": 0.9
                  }
                },
                "else": {
                  "type": "component",
                  "component": "text-3d",
                  "props": {
                    "text": "{{upper(name)}}",
                    "gradient": [
                      "{{lighten(brand.colors.primary, 0.25)}}",
                      "{{brand.colors.secondary}}"
                    ],
                    "intro": "drop",
                    "delay": 0.2
                  },
                  "y": "{{tagline ? (fmt.portrait ? '45%' : '44%') : '50%'}}",
                  "width": "{{fmt.safe.w}}",
                  "height": "{{fmt.portrait ? fmt.u * 30 : fmt.u * 34}}"
                }
              },
              {
                "type": "component",
                "component": "sparks",
                "props": {
                  "bursts": [
                    0.9
                  ],
                  "origin": [
                    0.5,
                    0.48
                  ],
                  "count": 80,
                  "colors": [
                    "{{brand.colors.accent}}",
                    "{{brand.colors.primary}}"
                  ],
                  "seed": 4
                }
              },
              {
                "$if": "tagline",
                "then": {
                  "id": "tagline",
                  "text": "{{tagline}}",
                  "style": "subtitle",
                  "y": "{{fmt.portrait ? '58%' : '64%'}}",
                  "width": "{{fmt.safe.w}}",
                  "enter": {
                    "preset": "fadeUp",
                    "delay": "{{duration * 0.28}}"
                  }
                }
              }
            ]
          },
          {
            "$if": "style == 'assemble'",
            "then": [
              {
                "$use": "backdrop",
                "with": {
                  "seed": 8,
                  "intensity": 0.3
                }
              },
              {
                "$if": "brand.logo",
                "then": {
                  "$if": "brand.logo",
                  "then": {
                    "src": "{{brand.logo}}",
                    "height": "{{fmt.u * 22}}",
                    "fit": "contain",
                    "y": "{{tagline ? (fmt.portrait ? '45%' : '44%') : '50%'}}",
                    "enter": {
                      "preset": "zoomIn",
                      "delay": 0.15,
                      "duration": 0.9
                    }
                  },
                  "else": {
                    "type": "component",
                    "component": "text-3d",
                    "props": {
                      "text": "{{upper(name)}}",
                      "gradient": [
                        "{{lighten(brand.colors.primary, 0.25)}}",
                        "{{brand.colors.secondary}}"
                      ],
                      "intro": "rise",
                      "delay": 0.15
                    },
                    "y": "{{tagline ? (fmt.portrait ? '45%' : '44%') : '50%'}}",
                    "width": "{{fmt.safe.w}}",
                    "height": "{{fmt.portrait ? fmt.u * 30 : fmt.u * 34}}"
                  }
                },
                "else": {
                  "type": "component",
                  "component": "particle-text",
                  "props": {
                    "text": "{{name}}",
                    "exit": "none",
                    "size": 2.4,
                    "glow": true,
                    "count": 5000,
                    "colors": [
                      "{{brand.colors.text}}",
                      "{{brand.colors.secondary}}"
                    ]
                  },
                  "y": "{{tagline ? (fmt.portrait ? '45%' : '44%') : '50%'}}",
                  "width": "{{fmt.safe.w}}",
                  "height": "{{fmt.u * 40}}"
                }
              },
              {
                "$if": "tagline",
                "then": {
                  "id": "tagline",
                  "text": "{{tagline}}",
                  "style": "subtitle",
                  "y": "{{fmt.portrait ? '58%' : '64%'}}",
                  "width": "{{fmt.safe.w}}",
                  "enter": {
                    "preset": "fadeUp",
                    "delay": "{{duration * 0.28}}"
                  }
                }
              }
            ]
          },
          {
            "$if": "style == 'minimal'",
            "then": [
              {
                "type": "shape",
                "shape": "rect",
                "width": "100%",
                "height": "100%",
                "fill": "radial-gradient($bg, $bgDeep)"
              },
              {
                "$if": "brand.logo",
                "then": {
                  "src": "{{brand.logo}}",
                  "height": "{{fmt.u * 22}}",
                  "fit": "contain",
                  "y": "{{tagline ? (fmt.portrait ? '45%' : '44%') : '50%'}}",
                  "enter": {
                    "preset": "zoomIn",
                    "delay": 0.1,
                    "duration": 0.9
                  }
                },
                "else": {
                  "type": "component",
                  "component": "text-3d",
                  "props": {
                    "text": "{{upper(name)}}",
                    "gradient": [
                      "{{lighten(brand.colors.primary, 0.25)}}",
                      "{{brand.colors.secondary}}"
                    ],
                    "intro": "rise",
                    "delay": 0.1,
                    "metallic": 0.15,
                    "roughness": 0.55,
                    "sway": 0.3
                  },
                  "y": "{{tagline ? (fmt.portrait ? '45%' : '44%') : '50%'}}",
                  "width": "{{fmt.safe.w}}",
                  "height": "{{fmt.portrait ? fmt.u * 30 : fmt.u * 34}}"
                }
              },
              {
                "$if": "tagline",
                "then": {
                  "id": "tagline",
                  "text": "{{tagline}}",
                  "style": "subtitle",
                  "y": "{{fmt.portrait ? '58%' : '64%'}}",
                  "width": "{{fmt.safe.w}}",
                  "enter": {
                    "preset": "fadeUp",
                    "delay": "{{duration * 0.28}}"
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "audio": {
      "$use": "music"
    }
  }
}