{
  "name": "logo-reveal",
  "title": "Logo reveal / intro",
  "description": "A restrained 3–6 s brand sting: the logo (or the name as a wordmark) revealed in one of four styles (glow, draw, assemble, minimal), with a slow camera settle and an optional tagline. Use it as an intro or outro for other videos.",
  "duration": "3–6 s",
  "tags": ["logo", "intro", "outro", "sting", "brand"],
  "params": {
    "style": { "type": "enum", "values": ["glow", "draw", "assemble", "minimal"], "default": "glow", "description": "glow: light bloom and a passing streak. draw: lines draw on and frame the mark. assemble: pieces converge (letters for a wordmark). minimal: a clean fade with an accent underline.", "example": "glow" },
    "name": { "type": "string", "default": "{{brand.name}}", "maxWords": 3, "description": "Wordmark text, used when the brand kit has no logo.", "example": "Anikit" },
    "tagline": { "type": "string", "maxWords": 8, "description": "Optional line under the logo.", "example": "Motion, compiled." },
    "duration": { "type": "seconds", "default": 4, "minimum": 3, "maximum": 6, "description": "Total length in seconds.", "example": 4 },
    "music": { "type": "string", "description": "Optional sting or whoosh sound." }
  },
  "defs": {
    "mark": {
      "$if": "brand.logo",
      "then": { "id": "logo", "src": "{{brand.logo}}", "height": "{{fmt.u * 16}}", "fit": "contain", "y": "{{markY}}", "enter": { "preset": "{{enter}}", "delay": "{{delay}}", "duration": "{{dur ?? 0.9}}", "ease": "outExpo" } },
      "else": { "id": "wordmark", "text": "{{name}}", "style": "title", "size": "{{fmt.portrait ? '14vmin' : '13vmin'}}", "width": "{{fmt.safe.w}}", "y": "{{markY}}", "enter": { "preset": "{{enter}}", "delay": "{{delay}}", "duration": "{{dur ?? 0.9}}", "ease": "outExpo" } }
    }
  },
  "spec": {
    "size": ["{{fmt.w}}", "{{fmt.h}}"],
    "fps": "{{fmt.fps}}",
    "theme": { "$use": "theme" },
    "background": "radial-gradient(circle at 50% 50%, $bg, $bgDeep)",
    "scenes": [
      {
        "$let": { "markY": "tagline ? '45%' : '50%'", "tagY": "fmt.portrait ? '57%' : '62%'" },
        "in": {
          "id": "logo",
          "duration": "{{duration}}",
          "camera": { "animate": [ { "from": { "zoom": "{{style == 'minimal' ? 1.03 : 1.1}}" }, "to": { "zoom": 1 }, "duration": "{{duration}}", "ease": "outExpo" } ] },
          "layers": [
            {
              "$if": "style == 'glow'",
              "then": [
                { "$use": "glows", "with": { "gx": "50%", "gy": "{{markY}}", "hx": "50%", "hy": "{{markY}}", "strength": 1.1 }, "enter": { "preset": "fadeIn", "duration": 1.4 } },
                {
                  "id": "streak", "shape": "rect", "y": "{{markY}}", "width": "{{fmt.w * 0.9}}", "height": "{{fmt.u * 0.35}}", "radius": "{{fmt.u * 0.2}}",
                  "fill": "linear-gradient(90deg, {{alpha(brand.colors.accent, 0)}}, {{brand.colors.accent}}, {{alpha(brand.colors.accent, 0)}})",
                  "glow": { "radius": "{{fmt.u * 3}}", "intensity": 1.2, "color": "$accent" },
                  "animate": [ { "from": { "scaleX": 0, "opacity": 1 }, "to": { "scaleX": 1, "opacity": 0 }, "duration": 1.1, "ease": "outExpo" } ]
                },
                { "$use": "mark", "with": { "enter": "blurIn", "delay": 0.25, "dur": 1.1 }, "glow": { "radius": "{{fmt.u * 3}}", "intensity": 0.6, "color": "$primary" } }
              ]
            },
            {
              "$if": "style == 'draw'",
              "then": [
                { "$use": "glows", "with": { "strength": 0.5, "gx": "50%", "gy": "{{markY}}" } },
                {
                  "id": "frame", "shape": "rect", "y": "{{markY}}", "width": "{{fmt.portrait ? fmt.safe.w : fmt.u * 92}}", "height": "{{fmt.u * 30}}", "radius": "{{fmt.u * 3}}",
                  "fill": "none", "stroke": { "color": "$accent", "width": "{{fmt.u * 0.3}}", "cap": "round", "join": "round" },
                  "enter": { "preset": "drawOn", "duration": 1.3, "ease": "inOutCubic" },
                  "animate": [ { "to": { "opacity": 0.35 }, "at": 1.5, "duration": 0.8 } ]
                },
                {
                  "id": "line-top", "shape": "line", "points": [[0, 0], ["{{fmt.u * 22}}", 0]], "y": "{{fmt.portrait ? '37%' : '29%'}}",
                  "stroke": { "color": "$primary", "width": "{{fmt.u * 0.45}}", "cap": "round" },
                  "enter": { "preset": "drawOn", "delay": 0.4, "duration": 0.8 }
                },
                { "$use": "mark", "with": { "enter": "fadeUp", "delay": 0.8, "dur": 0.8 } }
              ]
            },
            {
              "$if": "style == 'assemble'",
              "then": [
                { "$use": "glows", "with": { "strength": 0.7, "gx": "50%", "gy": "{{markY}}" } },
                {
                  "$if": "brand.logo",
                  "then": [
                    {
                      "$each": "[[-1, -1], [1, -1], [-1, 1], [1, 1]]", "as": "d", "index": "k",
                      "do": {
                        "shape": "rect", "width": "{{fmt.u * 4}}", "height": "{{fmt.u * 4}}", "radius": "{{fmt.u * 0.8}}", "y": "{{markY}}",
                        "fill": "{{k % 2 ? brand.colors.secondary : brand.colors.primary}}", "rotation": "{{45 * (k + 1)}}",
                        "animate": [
                          { "from": { "x": "{{'+' + str(d[0] * fmt.u * 40)}}", "y": "{{'+' + str(d[1] * fmt.u * 30)}}", "opacity": 0, "rotation": "+180" }, "duration": 0.8, "ease": "outExpo" },
                          { "to": { "scale": 0, "opacity": 0 }, "at": 0.75, "duration": 0.3, "ease": "inCubic" }
                        ]
                      }
                    },
                    { "$use": "mark", "with": { "enter": "popIn", "delay": 0.8, "dur": 0.6 } }
                  ],
                  "else": {
                    "id": "wordmark", "text": "{{name}}", "style": "title", "size": "{{fmt.portrait ? '14vmin' : '13vmin'}}", "width": "{{fmt.safe.w}}", "y": "{{markY}}",
                    "split": "chars", "enter": { "preset": "zoomIn", "stagger": { "each": 0.06, "from": "center" }, "duration": 0.8, "ease": "outExpo" }
                  }
                }
              ]
            },
            {
              "$if": "style == 'minimal'",
              "then": [
                { "$use": "mark", "with": { "enter": "fadeIn", "delay": 0.2, "dur": 1 } },
                {
                  "id": "underline", "shape": "line", "points": [[0, 0], ["{{fmt.u * 14}}", 0]], "y": "{{tagline ? (fmt.portrait ? '51%' : '54%') : (fmt.portrait ? '56%' : '60%')}}",
                  "stroke": { "color": "$accent", "width": "{{fmt.u * 0.5}}", "cap": "round" },
                  "enter": { "preset": "drawOn", "delay": 0.7, "duration": 0.8 }
                }
              ]
            },
            {
              "$if": "tagline",
              "then": { "id": "tagline", "text": "{{tagline}}", "style": "subtitle", "y": "{{tagY}}", "width": "{{fmt.safe.w}}", "enter": { "preset": "fadeUp", "delay": "{{min(1.4, duration - 1.8)}}" } }
            }
          ]
        }
      }
    ],
    "audio": { "$use": "music" }
  }
}
