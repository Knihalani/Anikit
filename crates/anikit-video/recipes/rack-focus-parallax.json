{
 "about": "2.5D depth: layers at different depths, a camera drift for parallax and a rack focus from the foreground word to the background. Works with any layers, photos included.",
 "spec": {
  "size": "16:9",
  "scenes": [
   {
    "duration": 3,
    "background": "#0E0D0C",
    "camera": {
     "aperture": 12,
     "focus": 0,
     "animate": [
      {
       "to": {
        "x": -160,
        "focus": 2.5
       },
       "duration": 3,
       "ease": "inOutSine"
      }
     ]
    },
    "layers": [
     {
      "shape": "circle",
      "width": 900,
      "height": 900,
      "fill": "radial-gradient(#E0A95B, #0E0D0C)",
      "x": "70%",
      "y": "40%",
      "depth": 3
     },
     {
      "text": "far",
      "font": "Instrument Serif",
      "size": "22vh",
      "color": "#B9B0A3",
      "x": "68%",
      "y": "55%",
      "depth": 2.5
     },
     {
      "text": "near",
      "size": "16vh",
      "weight": 800,
      "color": "#F3EEE6",
      "x": "30%",
      "y": "45%"
     }
    ]
   }
  ]
 }
}
