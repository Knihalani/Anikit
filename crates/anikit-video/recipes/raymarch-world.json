{
 "about": "A raymarched still-life world from the shader library with flush-left type and a cinematic grade. Swap the shader for any library entry (anikit-video recipes) or your own GLSL.",
 "spec": {
  "size": "16:9",
  "post": {
   "preset": "cinematic",
   "vignette": 0.3
  },
  "scenes": [
   {
    "duration": 3,
    "layers": [
     {
      "shader": "sdf-scene",
      "uniforms": {
       "speed": 0.6
      }
     },
     {
      "text": "Forms in\n*light*.",
      "font": "Instrument Serif",
      "size": "15vh",
      "lineHeight": 0.92,
      "color": "#F4EFE6",
      "align": "left",
      "anchor": "bottomLeft",
      "x": "6%",
      "y": "88%",
      "enter": {
       "preset": "mask by line up",
       "delay": 0.4
      },
      "shadow": {
       "x": 0,
       "y": 4,
       "blur": 24,
       "color": "#00000099"
      }
     }
    ]
   }
  ]
 }
}
