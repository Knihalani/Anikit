{
  "size": [
    1080,
    1920
  ],
  "fps": 30,
  "theme": {
    "colors": {
      "primary": "#FF5500",
      "secondary": "#FFFF00",
      "accent": "#FFFF00",
      "bg": "#09090D",
      "bgDeep": "#060608",
      "surface": "#19191D",
      "text": "#F5F5F5",
      "muted": "#9B9B9D",
      "border": "#2A2A2D",
      "onPrimary": "#000000",
      "onAccent": "#000000"
    },
    "fonts": {
      "heading": "Inter Display",
      "body": "Inter",
      "mono": "JetBrains Mono"
    },
    "radius": 28,
    "styles": {
      "hero": {
        "font": "$heading",
        "size": "13vmin",
        "weight": 800,
        "letterSpacing": "-0.035em",
        "lineHeight": 1.02,
        "color": "$text"
      },
      "title": {
        "font": "$heading",
        "size": "10.5vmin",
        "weight": 800,
        "letterSpacing": "-0.03em",
        "lineHeight": 1.05,
        "color": "$text"
      },
      "heading": {
        "font": "$heading",
        "size": "7.4vmin",
        "weight": 700,
        "letterSpacing": "-0.02em",
        "lineHeight": 1.1,
        "color": "$text"
      },
      "subtitle": {
        "font": "$body",
        "size": "4.6vmin",
        "weight": 500,
        "lineHeight": 1.35,
        "color": "$muted"
      },
      "body": {
        "font": "$body",
        "size": "4.2vmin",
        "weight": 400,
        "lineHeight": 1.4,
        "color": "$text"
      },
      "caption": {
        "font": "$body",
        "size": "3.3vmin",
        "weight": 500,
        "lineHeight": 1.35,
        "color": "$muted"
      },
      "label": {
        "font": "$body",
        "size": "3vmin",
        "weight": 650,
        "uppercase": true,
        "letterSpacing": "0.14em",
        "color": "$accent"
      },
      "button": {
        "font": "$body",
        "size": "4.2vmin",
        "weight": 650,
        "color": "$onPrimary"
      },
      "stat": {
        "font": "$heading",
        "size": "22vmin",
        "weight": 800,
        "letterSpacing": "-0.045em",
        "lineHeight": 1,
        "color": "$text"
      },
      "code": {
        "font": "$mono",
        "size": "3.2vmin",
        "weight": 400,
        "lineHeight": 1.55,
        "color": "$text"
      }
    }
  },
  "background": "radial-gradient(circle at 50% 35%, $bg, $bgDeep)",
  "transition": {
    "type": "crossfade",
    "duration": 0.5
  },
  "scenes": [
    {
      "id": "hook",
      "duration": 3.293333,
      "camera": {
        "animate": [
          {
            "from": {
              "zoom": 1.06
            },
            "to": {
              "zoom": 1
            },
            "duration": 3.293333,
            "ease": "outCubic"
          }
        ]
      },
      "layers": [
        {
          "id": "glow-a",
          "type": "shape",
          "shape": "circle",
          "width": "95vmax",
          "height": "95vmax",
          "x": "12%",
          "y": "8%",
          "fill": "radial-gradient(#FF550056, #FF550000)",
          "loop": {
            "preset": "float",
            "amount": 43.2,
            "period": 9
          }
        },
        {
          "id": "glow-b",
          "type": "shape",
          "shape": "circle",
          "width": "85vmax",
          "height": "85vmax",
          "x": "92%",
          "y": "96%",
          "fill": "radial-gradient(#FFFF003D, #FFFF0000)",
          "loop": {
            "preset": "float",
            "amount": 54,
            "period": 11
          }
        },
        {
          "id": "hook",
          "text": "Video, without the browser.",
          "style": "hero",
          "width": 907.2,
          "split": "words",
          "enter": {
            "preset": "fadeUp",
            "stagger": 0.09,
            "duration": 0.7,
            "ease": "outExpo",
            "distance": 54
          }
        }
      ]
    },
    {
      "id": "reveal",
      "transition": {
        "type": "zoom",
        "duration": 0.6
      },
      "duration": 5,
      "layers": [
        {
          "id": "glow-a",
          "type": "shape",
          "shape": "circle",
          "width": "95vmax",
          "height": "95vmax",
          "x": "12%",
          "y": "30%",
          "fill": "radial-gradient(#FF55006B, #FF550000)",
          "loop": {
            "preset": "float",
            "amount": 43.2,
            "period": 9
          }
        },
        {
          "id": "glow-b",
          "type": "shape",
          "shape": "circle",
          "width": "85vmax",
          "height": "85vmax",
          "x": "80%",
          "y": "75%",
          "fill": "radial-gradient(#FFFF004D, #FFFF0000)",
          "loop": {
            "preset": "float",
            "amount": 54,
            "period": 11
          }
        },
        {
          "id": "name",
          "text": "Anikit Video",
          "style": "title",
          "y": "44%",
          "width": 907.2,
          "split": "chars",
          "enter": {
            "preset": "fadeUp",
            "stagger": 0.03,
            "duration": 0.6,
            "ease": "outExpo",
            "delay": 0
          }
        },
        {
          "id": "tagline",
          "text": "Programmatic video for AI agents, rendered natively.",
          "style": "subtitle",
          "y": "58%",
          "width": 907.2,
          "enter": {
            "preset": "fadeUp",
            "delay": 0.6
          }
        }
      ]
    },
    {
      "id": "feature-1",
      "transition": {
        "type": "push",
        "direction": "up",
        "duration": 0.6,
        "ease": "inOutQuart"
      },
      "duration": 5.133333,
      "layers": [
        {
          "id": "glow-a",
          "type": "shape",
          "shape": "circle",
          "width": "95vmax",
          "height": "95vmax",
          "x": "10%",
          "y": "8%",
          "fill": "radial-gradient(#FF550040, #FF550000)",
          "loop": {
            "preset": "float",
            "amount": 43.2,
            "period": 9
          }
        },
        {
          "id": "glow-b",
          "type": "shape",
          "shape": "circle",
          "width": "85vmax",
          "height": "85vmax",
          "x": "90%",
          "y": "96%",
          "fill": "radial-gradient(#FFFF002E, #FFFF0000)",
          "loop": {
            "preset": "float",
            "amount": 54,
            "period": 11
          }
        },
        {
          "text": "01",
          "style": "label",
          "y": "36%",
          "enter": "fadeUp"
        },
        {
          "text": "10× faster renders",
          "style": "title",
          "y": "47%",
          "width": 907.2,
          "split": "words",
          "enter": {
            "preset": "fadeUp",
            "stagger": 0.07,
            "delay": 0.1,
            "ease": "outExpo"
          }
        },
        {
          "text": "Native Rust, every core, no headless browser.",
          "style": "subtitle",
          "y": "62%",
          "width": 907.2,
          "enter": {
            "preset": "fadeUp",
            "delay": 0.45
          }
        }
      ]
    },
    {
      "id": "feature-2",
      "transition": {
        "type": "push",
        "direction": "up",
        "duration": 0.6,
        "ease": "inOutQuart"
      },
      "duration": 5.466667,
      "layers": [
        {
          "id": "glow-a",
          "type": "shape",
          "shape": "circle",
          "width": "95vmax",
          "height": "95vmax",
          "x": "90%",
          "y": "8%",
          "fill": "radial-gradient(#FF550040, #FF550000)",
          "loop": {
            "preset": "float",
            "amount": 43.2,
            "period": 9
          }
        },
        {
          "id": "glow-b",
          "type": "shape",
          "shape": "circle",
          "width": "85vmax",
          "height": "85vmax",
          "x": "10%",
          "y": "96%",
          "fill": "radial-gradient(#FFFF002E, #FFFF0000)",
          "loop": {
            "preset": "float",
            "amount": 54,
            "period": 11
          }
        },
        {
          "text": "02",
          "style": "label",
          "y": "36%",
          "enter": "fadeUp"
        },
        {
          "text": "Built for agents",
          "style": "title",
          "y": "47%",
          "width": 907.2,
          "split": "words",
          "enter": {
            "preset": "fadeUp",
            "stagger": 0.07,
            "delay": 0.1,
            "ease": "outExpo"
          }
        },
        {
          "text": "One JSON spec, clear errors, an MCP server.",
          "style": "subtitle",
          "y": "62%",
          "width": 907.2,
          "enter": {
            "preset": "fadeUp",
            "delay": 0.45
          }
        }
      ]
    },
    {
      "id": "proof",
      "transition": {
        "type": "blur",
        "duration": 0.5
      },
      "duration": 5.2,
      "layers": [
        {
          "id": "glow-a",
          "type": "shape",
          "shape": "circle",
          "width": "95vmax",
          "height": "95vmax",
          "x": "50%",
          "y": "40%",
          "fill": "radial-gradient(#FF550060, #FF550000)",
          "loop": {
            "preset": "float",
            "amount": 43.2,
            "period": 9
          }
        },
        {
          "id": "glow-b",
          "type": "shape",
          "shape": "circle",
          "width": "85vmax",
          "height": "85vmax",
          "x": "92%",
          "y": "96%",
          "fill": "radial-gradient(#FFFF0045, #FFFF0000)",
          "loop": {
            "preset": "float",
            "amount": 54,
            "period": 11
          }
        },
        {
          "id": "number",
          "text": "{value:,} fps",
          "value": 935,
          "style": "stat",
          "y": "44%",
          "enter": {
            "preset": "countUp",
            "duration": 1.6
          },
          "animate": [
            {
              "from": {
                "scale": 0.92
              },
              "duration": 1.6,
              "ease": "outExpo"
            }
          ]
        },
        {
          "id": "label",
          "text": "rendered per second on a laptop",
          "style": "subtitle",
          "y": "58%",
          "width": 907.2,
          "enter": {
            "preset": "fadeUp",
            "delay": 0.8
          }
        }
      ]
    },
    {
      "id": "cta",
      "transition": {
        "type": "blur",
        "duration": 0.6
      },
      "duration": 3.866667,
      "layers": [
        {
          "id": "glow-a",
          "type": "shape",
          "shape": "circle",
          "width": "95vmax",
          "height": "95vmax",
          "x": "30%",
          "y": "20%",
          "fill": "radial-gradient(#FF55006B, #FF550000)",
          "loop": {
            "preset": "float",
            "amount": 43.2,
            "period": 9
          }
        },
        {
          "id": "glow-b",
          "type": "shape",
          "shape": "circle",
          "width": "85vmax",
          "height": "85vmax",
          "x": "70%",
          "y": "85%",
          "fill": "radial-gradient(#FFFF004D, #FFFF0000)",
          "loop": {
            "preset": "float",
            "amount": 54,
            "period": 11
          }
        },
        {
          "text": "Acme",
          "style": "title",
          "x": "50%",
          "y": "36%",
          "enter": {
            "preset": "scaleIn",
            "delay": 0
          }
        },
        {
          "type": "box",
          "id": "cta-button",
          "style": {
            "padding": [
              25.92,
              54
            ],
            "radius": 999,
            "background": "$primary"
          },
          "shadow": {
            "x": 0,
            "y": 12.96,
            "blur": 43.2,
            "color": "#FF550073"
          },
          "enter": {
            "preset": "popIn",
            "delay": 0.45
          },
          "children": [
            {
              "text": "Start building",
              "style": "button"
            }
          ],
          "y": "56%"
        },
        {
          "text": "anikit.dev",
          "style": "caption",
          "y": "64%",
          "enter": {
            "preset": "fadeIn",
            "delay": 0.8
          }
        }
      ]
    }
  ],
  "audio": []
}