{
  "name": "anikit-film",
  "private": true,
  "type": "module",
  "description": "ANIKIT \u2014 a 20 s title film composed in code and rendered by anikit in Node.",
  "scripts": {
    "preview": "node ../packages/anikit/bin/anikit-render.mjs film.mjs --preview 30 --out preview/",
    "render": "node ../packages/anikit/bin/anikit-render.mjs film.mjs --out anikit-film.mp4 --workers 3 --fade-out 0.6 --fade-color 0xece6da"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80"
  }
}
