{"size": "16:9", "fps": 30, "background": "#0E1A2E", "intent": {"pace": "fast"}, "post": {"grain": 0.02, "vignette": 0.12}, "scenes": [{"duration": 6.0, "layers": [{"shader": "uniform float hour; // = 0.0\nvoid mainImage(out vec4 o, in vec2 f){\n  vec2 uv = f / iResolution.xy;            // y = 0 at the bottom\n  float k = clamp(hour, 0.0, 1.0);         // 0 = night, 1 = 07:00 daylight\n  float k2 = k*k*(3.0-2.0*k);\n  vec3 nTop = vec3(0.047, 0.086, 0.157), nBot = vec3(0.085, 0.140, 0.235);\n  vec3 dTop = vec3(0.780, 0.835, 0.885), dBot = vec3(0.995, 0.900, 0.745);\n  float y = pow(1.0 - uv.y, 1.5);\n  vec3 c = mix(mix(nTop, nBot, y), mix(dTop, dBot, y), k2);\n  // first light: a warm band at the horizon that rises then settles\n  float band = exp(-7.0 * uv.y) * sin(3.14159 * clamp(k * 1.15, 0.0, 1.0));\n  c += band * vec3(0.55, 0.30, 0.10) * 0.55;\n  // gentle falloff toward the corners (one light: the sky)\n  vec2 d = uv - vec2(0.5, 0.15);\n  c *= 1.0 - 0.18 * dot(d, d);\n  o = vec4(c, 1.0);\n}", "uniforms": {"hour": 1.0}, "width": "130%", "height": "130%"}, {"text": "07:00", "font": "Bricolage Grotesque", "weight": 800, "size": "62vh", "features": "tnum", "letterSpacing": "-0.045em", "color": "#14181F10", "x": "50%", "y": "50%", "anchor": "center", "start": 0.0, "end": 6.0}, {"x": 340, "y": 300, "anchor": "topLeft", "width": 1920, "height": 1080, "layers": [{"shape": "rect", "x": 0, "y": 0, "width": 1240, "height": 470, "fill": "#FBFAF7", "radius": 32, "anchor": "topLeft", "stroke": "#14181F10", "strokeWidth": 2, "shadow": {"color": "#5A4A3033", "blur": 50, "y": 18}}, {"text": "Dana Whitfield", "font": "Host Grotesk", "weight": 650, "size": 38, "color": "#14181F", "x": 52, "y": 40, "anchor": "topLeft"}, {"text": "One small thing before tomorrow", "font": "Host Grotesk", "weight": 550, "size": 32, "color": "#2E3642", "x": 52, "y": 92, "anchor": "topLeft"}, {"text": "Can you send the Q3 numbers to the board before 9? I'll be offline until 10.", "font": "Host Grotes