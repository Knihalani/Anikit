{"size": "16:9", "scenes": [{"duration": 3, "layers": [{"shader": "uniform float hour; // = 0.0\nvoid mainImage(out vec4 o, in vec2 f){\n  vec2 uv = f / iResolution.xy;            // y = 0 at the bottom\n  float k = clamp(hour, 0.0, 1.0);         // 0 = night, 1 = 07:00 daylight\n  float k2 = k*k*(3.0-2.0*k);\n  vec3 nTop = vec3(0.047, 0.086, 0.157), nBot = vec3(0.085, 0.140, 0.235);\n  vec3 dTop = vec3(0.780, 0.835, 0.885), dBot = vec3(0.995, 0.900, 0.745);\n  float y = pow(1.0 - uv.y, 1.5);\n  vec3 c = mix(mix(nTop, nBot, y), mix(dTop, dBot, y), k2);\n  // first light: a warm band at the horizon that rises then settles\n  float band = exp(-7.0 * uv.y) * sin(3.14159 * clamp(k * 1.15, 0.0, 1.0));\n  c += band * vec3(0.55, 0.30, 0.10) * 0.55;\n  // gentle falloff toward the corners (one light: the sky)\n  vec2 d = uv - vec2(0.5, 0.15);\n  c *= 1.0 - 0.18 * dot(d, d);\n  o = vec4(c, 1.0);\n}", "uniforms": {"hour": 0}, "width": "130%", "height": "130%"}, {"text": "x", "size": 10, "color": "#00000000"}, {"id": "clk", "text": "03:12", "font": "Bricolage Grotesque", "weight": 800, "size": "80vh", "color": "#FFFFFF", "letterSpacing": "-0.045em"}, {"composition": "night", "width": 1920, "height": 1080, "matte": "clk"}]}], "compositions": {"night": {"size": [1920, 1080], "duration": 3, "background": "#0E1A2E", "layers": [{"x": 0, "y": 0, "anchor": "topLeft", "width": 1920, "height": 1080, "layers": [{"x": 60, "y": 40, "anchor": "topLeft", "width": 1920, "height": 1080, "layers": [{"shape": "rect", "x": 0, "y": 0, "width": 880, "height": 168, "fill": "#17253B", "radius": 28, "anchor": "topLeft", "stroke": "#FFFFFF14", "strokeWidth": 2}, {"shape": "circle", "x": 24, "y": 54, "width": 10, "height": 10, "fill": "#EEF2F8", "anchor": "center", "end": 0.5}, {"text": "Dana Whitfield", "font": "Host Grotesk", "weight": 650, "size": 38, "color": "#EEF2F8", "x": 44, "y": 30, "anchor": "topLeft"}, {"text": "11:58 PM", "font": "Host Grotesk", "weight": 500, "size": 30, "color": "#8193AD"