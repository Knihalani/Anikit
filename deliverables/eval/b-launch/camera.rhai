let K = [[0.0, 300.0, 590.0, 2.15], [1.85, 330.0, 580.0, 2.45], [3.45, 1480.0, 560.0, 1.5],
         [4.75, 960.0, 610.0, 1.0], [7.2, 960.0, 616.0, 0.95], [9.1, 960.0, 600.0, 0.40],
         [11.15, 990.0, 590.0, 0.37], [12.25, 960.0, 520.0, 1.0], [15.01, 960.0, 520.0, 1.035]];
let cx = 960.0; let cy = 600.0; let s = 1.0;
for j in 0..8 {
  let a = K[j]; let b = K[j + 1];
  if T >= a[0] && T < b[0] {
    let u = (T - a[0]) / (b[0] - a[0]);
    let e = if j == 6 {
      // whip back in for the end card
      if u < 0.5 { 16.0 * u * u * u * u * u } else { 1.0 - ((-2.0 * u + 2.0) ** 5.0) / 2.0 }
    } else if u < 0.5 { 4.0 * u * u * u } else { 1.0 - ((-2.0 * u + 2.0) ** 3.0) / 2.0 };
    cx = a[1] + (b[1] - a[1]) * e;
    cy = a[2] + (b[2] - a[2]) * e;
    s = a[3] * ((b[3] / a[3]) ** e);
    if j == 1 {
      // follow the train
      let p = (T - 1.875) / 1.40625;
      let head = 140.0 + 1640.0 * (if p < 0.0 { 0.0 } else if p > 1.0 { 1.0 } else { p });
      let w = smoothstep(1.85, 2.35, T);
      let tgt = if head + 60.0 > 1480.0 { 1480.0 } else { head + 60.0 };
      cx = 330.0 + (tgt - 330.0) * w;
    }
  }
}
#{ x: 960.0 - (cx - 960.0) * s, y: 540.0 - (cy - 540.0) * s, scale: s }
