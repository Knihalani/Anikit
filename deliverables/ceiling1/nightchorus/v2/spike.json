     "shader": "\nfloat mb(vec2 uv, float l){ return textureLod(iChannel0, uv, l).a; }\nfloat hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453); }\nvoid mainImage(out vec4 o, in vec2 f){ vec2 R=iResolution.xy; vec2 uv=f/R; float m=texture(iChannel0,uv).a; \n  float cs=22.0; vec2 cell=floor(f/cs); vec2 c=(cell+0.5)*cs; float mm=texture(iChannel0,c/R).a;\n  float r=length(f-c)/cs; float on=step(0.5,mm);\n  float chase = 0.75+0.25*step(0.5,fract((cell.x+cell.y)*0.25 - iTime*4.0));\n  float bulb=smoothstep(0.36,0.30,r); float halo=exp(-r*r*7.0);\n  vec3 w=vec3(1.000,0.769,0.420);\n  vec3 col = on*(w*bulb*1.3*chase + w*halo*0.45) + (1.0-on)*w*0.05*bulb;\n  o = vec4(col, max(on*max(bulb,halo*0.8), 0.6*bulb));\n }",
     "alpha": true,
     "channels": [
      {
       "layers": [
        {
         "text": "TOMAS VELD",
         "font": "Anton",
         "fit": true,
         "width": 1500,
         "height": 420,
         "size": 600,
         "color": "#fff"
        }
       ],
       "mipmaps": true
      }
     ]
    }
